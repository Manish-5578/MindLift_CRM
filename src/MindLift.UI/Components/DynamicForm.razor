@inject Translator T

<div class="ml-stack" data-testid="dynamic-form">
    <MudGrid Spacing="3">
        @foreach (var field in Fields)
        {
            var current = field;
            if (HiddenFields?.Contains(current.Key) == true)
            {
                continue;
            }

            var isMandatory = current.Required || MandatoryFields?.Contains(current.Key) == true;
            var isReadOnly = ReadOnlyFields?.Contains(current.Key) == true;

            <MudItem xs="12" sm="@current.Columns">
                @switch (current.Kind)
                {
                    case FormFieldKind.Picklist:
                        <MudSelect T="string" Value="Get(current.Key)" ValueChanged="v => SetAsync(current.Key, v)" Label="@LabelOf(current)" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Clearable="true" Disabled="@isReadOnly" Error="HasError(current.Key)" ErrorText="@ErrorOf(current.Key)" data-testid="@TestIdOf(current)">
                            @foreach (var option in (current.Options ?? []).Where(o => o.IsActive))
                            {
                                <MudSelectItem T="string" Value="@option.Value">@T.Pick(option.Label, option.LabelAr)</MudSelectItem>
                            }
                        </MudSelect>
                        break;
                    case FormFieldKind.User:
                        <UserPicker Users="Users" Label="@LabelOf(current)" Value="GetGuid(current.Key)" ValueChanged="v => SetAsync(current.Key, v?.ToString())" Clearable="true" TestId="@TestIdOf(current)" />
                        break;
                    case FormFieldKind.Account:
                        <RecordPicker Label="@LabelOf(current)" Search="AccountSearch" ErrorText="@ErrorOf(current.Key)" Value="GetGuid(current.Key)" Text="@Get(current.Key + LabelSuffix)"
                                      ValueChanged="v => SetAsync(current.Key, v?.ToString())" TestId="@TestIdOf(current)" />
                        break;
                    case FormFieldKind.Contact:
                        <RecordPicker Label="@LabelOf(current)" Search="ContactSearch" ErrorText="@ErrorOf(current.Key)" Value="GetGuid(current.Key)" Text="@Get(current.Key + LabelSuffix)"
                                      ValueChanged="v => SetAsync(current.Key, v?.ToString())" TestId="@TestIdOf(current)" />
                        break;
                    case FormFieldKind.Checkbox:
                        <MudCheckBox T="bool" Value="IsChecked(current.Key)" ValueChanged="v => SetAsync(current.Key, FlagText(v))" Label="@LabelOf(current)" Color="Color.Primary" Disabled="@isReadOnly" data-testid="@TestIdOf(current)" />
                        break;
                    case FormFieldKind.Users:
                        <MudSelect T="string" MultiSelection="true" SelectedValues="SelectedIds(current.Key)" SelectedValuesChanged="values => SetAsync(current.Key, string.Join(',', values))" MultiSelectionTextFunc="@FormatUserNames" Label="@LabelOf(current)"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Disabled="@isReadOnly" data-testid="@TestIdOf(current)">
                            @foreach (var user in Users)
                            {
                                <MudSelectItem T="string" Value="@user.Id.ToString()">@user.FullName</MudSelectItem>
                            }
                        </MudSelect>
                        break;
                    case FormFieldKind.Multiline:
                        <MudTextField T="string" Value="Get(current.Key)" ValueChanged="v => SetAsync(current.Key, v)" Label="@LabelOf(current)" Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Placeholder="@(current.Key.Equals("description", StringComparison.OrdinalIgnoreCase) ? T["Lead Description"] : null)"
                                      Disabled="@isReadOnly" Error="HasError(current.Key)" ErrorText="@ErrorOf(current.Key)" data-testid="@TestIdOf(current)" />
                        break;
                    default:
                        if (current.Key.Equals("country", StringComparison.OrdinalIgnoreCase))
                        {
                            <CountryPicker Value="@Get(current.Key)" ValueChanged="v => SetAsync(current.Key, v)" Label="@LabelOf(current)" Required="@isMandatory" Disabled="@isReadOnly" TestId="@TestIdOf(current)" />
                        }
                        else if (current.Kind == FormFieldKind.Number)
                        {
                            var isMinutes = current.Key.Contains("minute", StringComparison.OrdinalIgnoreCase) ||
                                            current.Key.Contains("duration", StringComparison.OrdinalIgnoreCase) ||
                                            current.Key.Contains("reminder", StringComparison.OrdinalIgnoreCase);
                            if (isMinutes)
                            {
                                <MudNumericField T="int?" Value="@GetInt(current.Key)" ValueChanged="@(v => SetIntAsync(current.Key, v))"
                                                 Label="@LabelOf(current)" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 Min="0" Max="43200" Immediate="true"
                                                 Disabled="@isReadOnly"
                                                 Error="@(HasError(current.Key) || IsNegative(current.Key))"
                                                 ErrorText="@(ErrorOf(current.Key) ?? (IsNegative(current.Key) ? T["Minutes cannot be negative."] : null))"
                                                 Validation="@(new Func<int?, string?>(val => val.HasValue && val.Value < 0 ? T["Minutes cannot be negative."] : null))"
                                                 data-testid="@TestIdOf(current)" />
                            }
                            else
                            {
                                <MudNumericField T="decimal?" Value="@GetDecimal(current.Key)" ValueChanged="@(v => SetDecimalAsync(current.Key, v))"
                                                 Label="@LabelOf(current)" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 Min="0m" Immediate="true"
                                                 Disabled="@isReadOnly"
                                                 Error="@(HasError(current.Key) || IsNegative(current.Key))"
                                                 ErrorText="@(ErrorOf(current.Key) ?? (IsNegative(current.Key) ? T["Value cannot be negative."] : null))"
                                                 Validation="@(new Func<decimal?, string?>(val => val.HasValue && val.Value < 0 ? T["Value cannot be negative."] : null))"
                                                 data-testid="@TestIdOf(current)" />
                            }
                        }
                        else
                        {
                            <MudTextField T="string" Value="Get(current.Key)" ValueChanged="v => SetAsync(current.Key, v)" Label="@LabelOf(current)" Variant="Variant.Outlined" Margin="Margin.Dense"
                                          InputType="@InputTypeOf(current.Kind)" Disabled="@isReadOnly" Error="HasError(current.Key)" ErrorText="@ErrorOf(current.Key)" data-testid="@TestIdOf(current)" />
                        }
                        break;
                }
            </MudItem>
        }
    </MudGrid>

    @if (CustomFields.Count > 0)
    {
        <MudText Typo="Typo.overline" Class="ml-muted mt-2">@T["Details"]</MudText>
        <CustomFieldEditor Fields="CustomFields" Values="CustomValues" ValuesChanged="CustomValuesChanged"
                           HiddenFields="HiddenFields" MandatoryFields="MandatoryFields" ReadOnlyFields="ReadOnlyFields" />
    }
</div>

@code {
    /// <summary>The key suffix under which the text shown for a looked-up record is kept in Values.</summary>
    public const string LabelSuffix = ":label";

    [Parameter, EditorRequired] public IReadOnlyList<FormField> Fields { get; set; } = [];

    /// <summary>The current value of every field, by key. A looked-up record holds its id, and its name is kept under the key plus ":label".</summary>
    [Parameter, EditorRequired] public Dictionary<string, string?> Values { get; set; } = new();

    [Parameter] public IReadOnlyList<UserListItem> Users { get; set; } = [];
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<LookupItem>>> AccountSearch { get; set; } = (_, _) => Task.FromResult<IReadOnlyList<LookupItem>>([]);
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<LookupItem>>> ContactSearch { get; set; } = (_, _) => Task.FromResult<IReadOnlyList<LookupItem>>([]);

    /// <summary>Error messages by field key, shown under the matching field.</summary>
    [Parameter] public IReadOnlyDictionary<string, string>? Errors { get; set; }

    [Parameter] public IReadOnlyList<FieldDto> CustomFields { get; set; } = [];
    [Parameter] public Dictionary<string, JsonElement?> CustomValues { get; set; } = new();
    [Parameter] public EventCallback<Dictionary<string, JsonElement?>> CustomValuesChanged { get; set; }

    [Parameter] public IReadOnlySet<string>? HiddenFields { get; set; }
    [Parameter] public IReadOnlySet<string>? MandatoryFields { get; set; }
    [Parameter] public IReadOnlySet<string>? ReadOnlyFields { get; set; }

    [Parameter] public EventCallback<string> OnFieldChanged { get; set; }

    private string? Get(string key) => Values.GetValueOrDefault(key);
    private Guid? GetGuid(string key) => Guid.TryParse(Get(key), out var id) ? id : null;
    private int? GetInt(string key) => int.TryParse(Get(key), System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var n) ? n : null;
    private decimal? GetDecimal(string key) => decimal.TryParse(Get(key), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : null;

    private async Task SetIntAsync(string key, int? value)
    {
        if (value.HasValue && value.Value < 0) value = 0;
        await SetAsync(key, value?.ToString(System.Globalization.CultureInfo.InvariantCulture));
    }

    private async Task SetDecimalAsync(string key, decimal? value)
    {
        if (value.HasValue && value.Value < 0m) value = 0m;
        await SetAsync(key, value?.ToString(System.Globalization.CultureInfo.InvariantCulture));
    }
    private string FormatUserNames(IReadOnlyList<string> ids) => (ids == null || ids.Count == 0) ? string.Empty : string.Join(", ", ids.Select(id => Users.FirstOrDefault(u => u.Id.ToString() == id)?.FullName ?? id));
    private IReadOnlyCollection<string> SelectedIds(string key) => (Get(key) ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries).ToList();
    private bool IsChecked(string key) => Get(key) == "true";
    private static string FlagText(bool value) => value ? "true" : "false";
    private bool HasError(string key) => Errors?.ContainsKey(key) == true;
    private string? ErrorOf(string key) => Errors?.GetValueOrDefault(key);
    private string LabelOf(FormField field) => (field.Required || MandatoryFields?.Contains(field.Key) == true) ? T[field.Label] + " *" : T[field.Label];
    private static string TestIdOf(FormField field) => field.TestId ?? "field-" + field.Key;

    private static InputType InputTypeOf(FormFieldKind kind) => kind switch
    {
        FormFieldKind.Email => InputType.Email,
        FormFieldKind.Url => InputType.Url,
        FormFieldKind.Phone => InputType.Telephone,
        FormFieldKind.Number => InputType.Number,
        FormFieldKind.Date => InputType.Date,
        FormFieldKind.DateTime => InputType.DateTimeLocal,
        _ => InputType.Text,
    };

    private static readonly Dictionary<string, object> NumberAttributes = new()
    {
        ["min"] = "0",
        ["onkeydown"] = "if(event.key==='-'||event.key==='Subtract'||event.key==='e'||event.key==='E'||event.key==='+'||event.keyCode===189||event.keyCode===109){event.preventDefault();}",
        ["oninput"] = "if(this.value && (this.value.includes('-') || Number(this.value) < 0)){this.value=this.value.replace(/[^0-9]/g,'');}"
    };

    private bool IsNegative(string key)
    {
        var raw = Get(key);
        return !string.IsNullOrWhiteSpace(raw) && int.TryParse(raw, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var n) && n < 0;
    }

    private async Task SetNumberAsync(string key, string? value)
    {
        if (!string.IsNullOrEmpty(value) && value.Contains('-'))
        {
            value = value.Replace("-", "").Trim();
        }
        await SetAsync(key, value);
    }
private static string? SanitizeNumber(string? v)
    {
        if (string.IsNullOrWhiteSpace(v)) return v;
        var clean = v.Replace("-", "").Trim();
        if (decimal.TryParse(clean, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var n))
        {
            return Math.Max(0m, n).ToString(System.Globalization.CultureInfo.InvariantCulture);
        }
        return clean;
    }

    private async Task SetAsync(string key, string? value)
    {
        var field = Fields.FirstOrDefault(f => f.Key == key);
        if (field?.Kind == FormFieldKind.Number && value is not null)
        {
            value = SanitizeNumber(value);
        }
        Values[key] = value;
        await OnFieldChanged.InvokeAsync(key);
    }
}
