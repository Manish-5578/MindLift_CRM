@inject IDialogService Dialogs

<MudDrawer Open="Open" OpenChanged="OnOpenChanged" Anchor="Anchor.End" Variant="DrawerVariant.Temporary" Elevation="3" Width="480px" Class="ml-form-drawer" data-testid="form-drawer">
    <div class="ml-stack" style="height:100%">
        <div class="ml-row ml-row--between" style="padding:16px 24px;border-bottom:1px solid var(--ml-border);min-height:64px">
            <MudText Typo="Typo.h5">@Title</MudText>
            <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" OnClick="RequestClose" aria-label="Close" />
        </div>
        <div style="padding:24px;overflow:auto;flex:1 1 auto">
            @ChildContent
        </div>
        <div class="ml-row" style="justify-content:flex-end;padding:16px 24px;border-top:1px solid var(--ml-border)">
            <MudButton Variant="Variant.Text" OnClick="RequestClose">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="Busy" OnClick="OnSubmit" data-testid="drawer-submit">
                @if (Busy) { <MudProgressCircular Size="Size.Small" Indeterminate="true" /> }
                else { @SubmitText }
            </MudButton>
        </div>
    </div>
</MudDrawer>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string SubmitText { get; set; } = "Save";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnSubmit { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// True when the form has edits that are not saved. Closing the drawer (Cancel, the X, Esc or a click outside)
    /// then asks "Discard changes?" first. Pages that do not track edits leave this false and close straight away.
    /// </summary>
    [Parameter] public bool IsDirty { get; set; }

    private async Task RequestClose() => await OnOpenChanged(false);

    private async Task OnOpenChanged(bool value)
    {
        if (!value && IsDirty && !Busy)
        {
            var discard = await Dialogs.ConfirmAsync("Discard changes?", "You have unsaved changes. They will be lost.", "Discard", danger: true);
            if (!discard)
            {
                // The drawer closed itself in the browser. Tell it to stay open.
                await OpenChanged.InvokeAsync(true);
                return;
            }
        }

        await OpenChanged.InvokeAsync(value);
    }
}
