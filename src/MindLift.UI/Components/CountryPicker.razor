@using MindLift.Shared.Common
@inject Translator T

<MudAutocomplete T="string"
                 Value="@Value"
                 ValueChanged="OnCountryChanged"
                 SearchFunc="SearchCountriesAsync"
                 Label="@(Required ? (Label + " *") : Label)"
                 Placeholder="@Placeholder"
                 Variant="Variant.Outlined"
                 Margin="Margin.Dense"
                 Clearable="true"
                 CoerceValue="true"
                 ResetValueOnEmptyText="true"
                 MaxItems="300"
                 Adornment="Adornment.Start"
                 AdornmentIcon="@Icons.Material.Filled.Public"
                 AdornmentColor="Color.Primary"
                 Disabled="@Disabled"
                 HelperText="@HelperText"
                 Class="@Class"
                 data-testid="@TestId" />

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "Country";
    [Parameter] public string? Placeholder { get; set; } = "Type or scroll to select country...";
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? TestId { get; set; }

    private Task<IEnumerable<string>> SearchCountriesAsync(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult<IEnumerable<string>>(Countries.All);
        }

        var filtered = Countries.All.Where(c => c.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(filtered);
    }

    private async Task OnCountryChanged(string? newValue)
    {
        Value = string.IsNullOrWhiteSpace(newValue) ? null : newValue;
        await ValueChanged.InvokeAsync(Value);
    }
}
