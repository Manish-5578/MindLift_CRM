@inject Translator T
<span class="@(Danger ? "ml-num ml-delta--bad" : "ml-num")" title="@Tooltip">@Display</span>

@code {
    /// <summary>A UTC instant from the API.</summary>
    [Parameter] public DateTime? Value { get; set; }
    [Parameter] public bool Relative { get; set; } = true;
    [Parameter] public bool Danger { get; set; }

    private string Display => Value is null ? "—"
        : Relative ? Formatting.Relative(Value.Value, DateTime.UtcNow, T)
        : Formatting.ShortDate(Value.Value, T);

    private string? Tooltip => Value is { } value ? Formatting.FullDateTime(value, T) : null;
}
