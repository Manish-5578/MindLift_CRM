@typeparam TItem
@using MindLift.Shared.Filtering
@using Microsoft.JSInterop
@inject NavigationManager Nav
@inject Translator T
@inject IJSRuntime JS
@implements IDisposable

<PageHeader Title="@Title" Subtitle="@SubtitleText">
    <Actions>@HeaderActions</Actions>
</PageHeader>

<MlCard Flush="true" TestId="entity-list">
    @if (AllViews.Count > 0 || OnSaveView.HasDelegate)
    {
        <div class="ml-row ml-row--wrap" style="padding:12px 20px 0" data-testid="list-views">
            @* Many views, or long labels in Arabic, scroll inside this strip on a phone rather than widening the page. *@
            <div class="ml-views-strip">
            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                @foreach (var view in AllViews)
                {
                    var current = view;
                    <MudButton Color="@ViewColor(current)" OnClick="() => SelectViewAsync(current)" data-testid="@ViewTestId(current)">@(current.SavedId is null ? T[current.Label] : current.Label)</MudButton>
                }
            </MudButtonGroup>
            </div>
            @if (CurrentView is { SavedId: { } savedId, CanDelete: true } && OnDeleteView.HasDelegate)
            {
                <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Size="Size.Small" OnClick="() => DeleteViewAsync(savedId)" aria-label="@T["Delete this view"]" data-testid="delete-view" />
            }
            @if (OnSaveView.HasDelegate)
            {
                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Add" OnClick="OpenSaveView" data-testid="save-view">@T["Save view"]</MudButton>
            }
        </div>
    }

    <div class="ml-row ml-row--wrap" style="padding:12px 20px;border-bottom:1px solid var(--ml-border);min-height:65px" data-testid="list-toolbar">
        @if (SelectedCount > 0)
        {
            <div class="ml-row ml-row--wrap ml-grow" data-testid="bulk-bar">
                <MudText Typo="Typo.subtitle2" data-testid="bulk-count">@T["{0} selected", SelectedCount.ToString("N0")]</MudText>
                @BulkActions?.Invoke(Selection())
                @if (!_allMatching && AllOnPageSelected && _result is not null && _result.Total > _result.Items.Count)
                {
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="SelectAllMatching" data-testid="bulk-select-all">@T["Select all {0}", _result.Total.ToString("N0")]</MudButton>
                }
                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ClearSelection" data-testid="bulk-clear">@T["Clear"]</MudButton>
            </div>
        }
        else
        {
            <MudTextField T="string" Value="_state.Search" ValueChanged="SearchAsync" Immediate="true" DebounceInterval="300" Placeholder="@T[SearchPlaceholder]"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                          Class="ml-grow" Style="max-width:360px" data-testid="search" />

            @if (Fields.Count > 0)
            {
                <MudBadge Content="FilterCount" Visible="FilterCount > 0" Color="Color.Primary" Overlap="true">
                    <MudButton Variant="Variant.Outlined" Size="Size.Medium" StartIcon="@Icons.Material.Outlined.FilterList" OnClick="OpenFilters" data-testid="open-filters">@T["Filters"]</MudButton>
                </MudBadge>
            }

            @foreach (var chip in Chips())
            {
                var condition = chip.Condition;
                <MudChip T="string" Size="Size.Small" OnClose="() => RemoveConditionAsync(condition)" data-testid="filter-chip">@chip.Text</MudChip>
            }

            @if (_state.IsNarrowed)
            {
                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ClearAsync" data-testid="clear-filters">@T["Clear"]</MudButton>
            }

            @if (Columns.Count > 1)
            {
                <MudMenu Icon="@Icons.Material.Outlined.ViewColumn" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="ml-hide-xs" Style="margin-inline-start:auto"
                         aria-label="@T["Choose columns"]" data-testid="column-chooser">
                    @foreach (var column in Columns.Skip(1))
                    {
                        var header = column.Header;
                        <MudMenuItem AutoClose="false" OnClick="() => ToggleColumnAsync(header)" data-testid="@("column-" + header)"
                                     Icon="@(_hiddenColumns.Contains(header) ? Icons.Material.Outlined.CheckBoxOutlineBlank : Icons.Material.Outlined.CheckBox)">@T[header]</MudMenuItem>
                    }
                </MudMenu>
            }
        }
    </div>

    @if (_loading)
    {
        <div class="ml-hide-xs" data-testid="list-loading"><SkeletonTable Rows="8" Columns="@Columns.Count" /></div>
        <div class="ml-only-xs" style="padding:12px"><SkeletonCards Count="4" /></div>
    }
    else if (_error is not null)
    {
        <ErrorState Message="@_error" OnRetry="ReloadAsync" />
    }
    else if (_result is { Items.Count: 0 })
    {
        @if (NeverHadData)
        {
            <EmptyState Title="@EmptyTitle" Message="@EmptyMessage" Icon="@EmptyIcon">
                <Actions>@EmptyActions</Actions>
            </EmptyState>
        }
        else
        {
            <EmptyState Icon="@Icons.Material.Outlined.SearchOff" Title="No results" Message="Try different keywords or clear the filters.">
                <Actions>
                    <MudButton Variant="Variant.Outlined" OnClick="ClearAsync" data-testid="empty-clear">@T["Clear filters"]</MudButton>
                </Actions>
            </EmptyState>
        }
    }
    else if (_result is not null)
    {
        <div class="ml-hide-xs" style="overflow-x:auto" data-testid="list">
            <table class="ml-table">
                <thead>
                    <tr>
                        @if (Selectable)
                        {
                            <th class="ml-table__check">
                                <MudCheckBox T="bool" Value="AllOnPageSelected" ValueChanged="TogglePageAsync" Size="Size.Small" Dense="true"
                                             aria-label="@T["Select all on this page"]" data-testid="select-page" />
                            </th>
                        }
                        @foreach (var column in VisibleColumns)
                        {
                            var current = column;
                            <th class="@ColumnClass(current)" aria-sort="@SortAria(current)">
                                @if (current.SortField is not null)
                                {
                                    <button type="button" @onclick="() => SortAsync(current.SortField)" data-testid="@SortTestId(current)">
                                        @T[current.Header]
                                        @if (_state.SortField == current.SortField)
                                        {
                                            <MudIcon Icon="@SortIcon()" Size="Size.Small" />
                                        }
                                    </button>
                                }
                                else
                                {
                                    @T[current.Header]
                                }
                            </th>
                        }
                        @if (RowMenu is not null)
                        {
                            <th class="ml-table__menu"><span class="ml-visually-hidden">@T["Actions"]</span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _result.Items)
                    {
                        var current = item;
                        var selected = IsSelected(current);
                        <tr class="@RowClass @(selected ? "ml-row-selected" : null)" @onclick="() => OpenAsync(current)" data-testid="row" aria-selected="@(Selectable ? selected.ToString().ToLowerInvariant() : null)">
                            @if (Selectable)
                            {
                                <td class="ml-table__check" @onclick:stopPropagation="true">
                                    <MudCheckBox T="bool" Value="selected" ValueChanged="v => ToggleRow(current, v)" Size="Size.Small" Dense="true"
                                                 aria-label="@T["Select row"]" data-testid="select-row" />
                                </td>
                            }
                            @foreach (var column in VisibleColumns)
                            {
                                <td class="@ColumnClass(column)">@column.Cell(current)</td>
                            }
                            @if (RowMenu is not null)
                            {
                                <td class="ml-table__menu" @onclick:stopPropagation="true">
                                    <MudMenu Icon="@Icons.Material.Outlined.MoreVert" Size="Size.Small" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                                             aria-label="@T["More actions"]" data-testid="row-menu">
                                        @RowMenu(current)
                                    </MudMenu>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="ml-only-xs ml-stack" style="padding:12px" data-testid="list-cards">
            @foreach (var item in _result.Items)
            {
                var current = item;
                <div class="ml-card" style="padding:12px 16px;cursor:pointer" @onclick="() => OpenAsync(current)" data-testid="card">
                    @if (CardTemplate is not null)
                    {
                        @CardTemplate(current)
                    }
                    else
                    {
                        @Columns[0].Cell(current)
                    }
                </div>
            }
        </div>

        <div class="ml-row ml-row--between" style="padding:12px 20px;border-top:1px solid var(--ml-border)" data-testid="list-pager">
            <MudText Typo="Typo.caption" Class="ml-muted">@PagerText</MudText>
            <div class="ml-row">
                <MudIconButton Icon="@(T.IsArabic ? Icons.Material.Outlined.ChevronRight : Icons.Material.Outlined.ChevronLeft)" Disabled="_state.Page <= 1" OnClick="() => GoToPageAsync(_state.Page - 1)" aria-label="@T["Previous page"]" data-testid="page-prev" />
                <MudIconButton Icon="@(T.IsArabic ? Icons.Material.Outlined.ChevronLeft : Icons.Material.Outlined.ChevronRight)" Disabled="_state.Page >= PageCount" OnClick="() => GoToPageAsync(_state.Page + 1)" aria-label="@T["Next page"]" data-testid="page-next" />
            </div>
        </div>
    }
</MlCard>

<MudDrawer Open="_filtersOpen" OpenChanged="v => _filtersOpen = v" Anchor="Anchor.End" Variant="DrawerVariant.Temporary" Elevation="3" Width="420px" Class="ml-form-drawer" data-testid="filters-drawer">
    <div class="ml-stack" style="height:100%">
        <div class="ml-row ml-row--between" style="padding:16px 24px;border-bottom:1px solid var(--ml-border);min-height:64px">
            <MudText Typo="Typo.h5">@T["Filters"]</MudText>
            <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" OnClick="CloseFilters" aria-label="@T["Close filters"]" />
        </div>
        <div style="padding:24px;overflow:auto;flex:1 1 auto">
            <FilterBuilder Fields="Fields" Picklists="Picklists" Users="Users" Value="_draft" ValueChanged="g => _draft = g" />
        </div>
        <div class="ml-row" style="justify-content:flex-end;padding:16px 24px;border-top:1px solid var(--ml-border)">
            <MudButton Variant="Variant.Text" OnClick="ResetFiltersAsync" data-testid="filters-reset">@T["Reset"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyFiltersAsync" data-testid="filters-apply">@T["Apply"]</MudButton>
        </div>
    </div>
</MudDrawer>

<MudDialog @bind-Visible="_saveViewOpen" Options="new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true }" data-testid="save-view-dialog">
    <TitleContent><MudText Typo="Typo.h6">@T["Save view"]</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="ml-muted mb-3">@T["Saves the current filters, sort and columns as a tab above the list."]</MudText>
        <MudTextField @bind-Value="_viewName" Label="@T["Name"]" Variant="Variant.Outlined" MaxLength="80" Required="true" data-testid="save-view-name" />
        <MudCheckBox @bind-Value="_viewShared" Label="@T["Share with everyone in the workspace (optional)"]" data-testid="save-view-shared" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _saveViewOpen = false">@T["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="string.IsNullOrWhiteSpace(_viewName)" OnClick="SaveViewAsync" data-testid="save-view-confirm">@T["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private ListState _state = new("");
    private PagedResult<TItem>? _result;
    private bool _loading = true;
    private string? _error;
    private bool _filtersOpen;
    private FilterGroup? _draft;
    private bool _selfNavigating;
    private int _requestId;

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>The plural name used in the subtitle, for example "leads" gives "1,284 leads".</summary>
    [Parameter] public string ItemLabel { get; set; } = "records";

    [Parameter] public RenderFragment? HeaderActions { get; set; }

    /// <summary>Tabs above the list. The first one is the default unless <see cref="DefaultView"/> says otherwise.</summary>
    [Parameter] public IReadOnlyList<ListView> Views { get; set; } = [];

    [Parameter] public string? DefaultView { get; set; }

    [Parameter, EditorRequired] public IReadOnlyList<ListColumn<TItem>> Columns { get; set; } = [];

    /// <summary>How a row looks as a card on phones. Without it the first column is used.</summary>
    [Parameter] public RenderFragment<TItem>? CardTemplate { get; set; }

    /// <summary>Fetches one page. Throw HttpRequestException when the server cannot be reached.</summary>
    [Parameter, EditorRequired] public Func<ListQuery, Task<PagedResult<TItem>>> Loader { get; set; } = _ => Task.FromResult(new PagedResult<TItem>([], 0, 1, 25));

    [Parameter] public Func<TItem, string?>? RowHref { get; set; }
    [Parameter] public EventCallback<TItem> OnRowClick { get; set; }

    /// <summary>The fields of the record type. The Filters button only shows when there are some.</summary>
    [Parameter] public IReadOnlyList<MindLift.Shared.Contracts.FieldDto> Fields { get; set; } = [];

    [Parameter] public IReadOnlyList<MindLift.Shared.Contracts.PicklistDto>? Picklists { get; set; }
    [Parameter] public IReadOnlyList<MindLift.Shared.Contracts.UserListItem>? Users { get; set; }

    [Parameter] public string SearchPlaceholder { get; set; } = "Search";
    [Parameter] public string EmptyTitle { get; set; } = "Nothing here yet";
    [Parameter] public string? EmptyMessage { get; set; }
    [Parameter] public string EmptyIcon { get; set; } = Icons.Material.Outlined.Inbox;
    [Parameter] public RenderFragment? EmptyActions { get; set; }
    [Parameter] public string? DefaultSortField { get; set; }
    [Parameter] public string? DefaultSortDir { get; set; }
    [Parameter] public int PageSize { get; set; } = 25;

    /// <summary>The id of a row. With <see cref="BulkActions"/> it turns on row checkboxes and the bulk bar.</summary>
    [Parameter] public Func<TItem, Guid>? ItemId { get; set; }

    /// <summary>The buttons of the bulk bar shown while rows are ticked, for example Assign and Delete.</summary>
    [Parameter] public RenderFragment<BulkSelection>? BulkActions { get; set; }

    /// <summary>The items of each row's "⋮" menu, for example Open, Edit and Delete.</summary>
    [Parameter] public RenderFragment<TItem>? RowMenu { get; set; }

    /// <summary>Views the user or colleagues saved, shown as tabs after <see cref="Views"/>.</summary>
    [Parameter] public IReadOnlyList<ListView> SavedViews { get; set; } = [];

    /// <summary>Stores a new saved view. Without it there is no "Save view" button.</summary>
    [Parameter] public EventCallback<SaveViewRequest> OnSaveView { get; set; }

    [Parameter] public EventCallback<Guid> OnDeleteView { get; set; }

    /// <summary>Where this list remembers the columns a user hid, in the browser (for example "leads").</summary>
    [Parameter] public string? ColumnStorageKey { get; set; }

    private readonly HashSet<Guid> _selected = [];
    private bool _allMatching;
    private HashSet<string> _hiddenColumns = [];
    private IReadOnlyList<string>? _viewColumns;
    private bool _saveViewOpen;
    private string _viewName = string.Empty;
    private bool _viewShared;

    public IReadOnlyList<ListView> AllViewsList => AllViews;

    public ListView? CurrentView => AllViews.FirstOrDefault(v => v.Key == _state.View);

    public string CurrentViewKey => _state.View;

    private IReadOnlyList<ListView> AllViews => SavedViews.Count == 0 ? Views : [.. Views, .. SavedViews];

    private bool Selectable => ItemId is not null && BulkActions is not null;

    private int SelectedCount => _allMatching ? _result?.Total ?? 0 : _selected.Count;

    private bool AllOnPageSelected => Selectable && _result is { Items.Count: > 0 } && (_allMatching || _result.Items.All(i => _selected.Contains(ItemId!(i))));

    /// <summary>The columns to draw: a saved view's own set when it has one, otherwise all but those the user hid. The first column always shows.</summary>
    private IReadOnlyList<ListColumn<TItem>> VisibleColumns => Columns
        .Where((c, i) => i == 0 || (_viewColumns is { Count: > 0 } chosen ? chosen.Contains(c.Header) : !_hiddenColumns.Contains(c.Header)))
        .ToList();

    private bool IsSelected(TItem item) => Selectable && (_allMatching || _selected.Contains(ItemId!(item)));

    private void ToggleRow(TItem item, bool on)
    {
        if (_allMatching)
        {
            // Unticking one row after "Select all" goes back to ticking the rows on this page, less that one.
            _allMatching = false;
            _selected.Clear();
            foreach (var row in _result?.Items ?? [])
            {
                _selected.Add(ItemId!(row));
            }
        }

        if (on)
        {
            _selected.Add(ItemId!(item));
        }
        else
        {
            _selected.Remove(ItemId!(item));
        }
    }

    private Task TogglePageAsync(bool on)
    {
        _allMatching = false;
        foreach (var row in _result?.Items ?? [])
        {
            if (on)
            {
                _selected.Add(ItemId!(row));
            }
            else
            {
                _selected.Remove(ItemId!(row));
            }
        }

        return Task.CompletedTask;
    }

    private void SelectAllMatching() => _allMatching = true;

    private void ClearSelection()
    {
        _allMatching = false;
        _selected.Clear();
    }

    private BulkSelection Selection() => new(
        _allMatching ? [] : _selected.ToList(),
        _allMatching ? CurrentQuery with { Page = 1 } : null,
        SelectedCount,
        async () =>
        {
            ClearSelection();
            await LoadAsync();
        });

    private async Task ToggleColumnAsync(string header)
    {
        if (!_hiddenColumns.Remove(header))
        {
            _hiddenColumns.Add(header);
        }

        // Changing columns by hand leaves a saved view's own column set.
        _viewColumns = null;
        if (ColumnStorageKey is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("localStorage.setItem", ColumnsKey, string.Join('\n', _hiddenColumns));
            }
            catch (JSException)
            {
                // Browser storage is off; the choice lasts until the page is left.
            }
        }
    }

    private string ColumnsKey => "mindlift.columns." + ColumnStorageKey;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || ColumnStorageKey is null)
        {
            return;
        }

        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", ColumnsKey);
            if (!string.IsNullOrEmpty(stored))
            {
                _hiddenColumns = stored.Split('\n', StringSplitOptions.RemoveEmptyEntries).ToHashSet();
                StateHasChanged();
            }
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
        {
            // No browser storage (or prerendering): every column shows.
        }
    }

    private void OpenSaveView()
    {
        _viewName = string.Empty;
        _viewShared = false;
        _saveViewOpen = true;
    }

    private async Task SaveViewAsync()
    {
        _saveViewOpen = false;
        FilterGroup? filter;
        if (!_allMatching && _selected.Count > 0)
        {
            var selectedIds = _selected.ToArray();
            filter = new FilterGroup
            {
                Conditions =
                [
                    new FilterCondition
                    {
                        Field = "id",
                        Op = MindLift.Shared.Filtering.FilterOperator.In,
                        Value = JsonSerializer.SerializeToElement(selectedIds)
                    }
                ]
            };
        }
        else
        {
            filter = EffectiveFilter();
        }

        await OnSaveView.InvokeAsync(new SaveViewRequest(
            _viewName.Trim(), _viewShared, filter, _state.SortField ?? DefaultSortField, _state.SortField is null ? DefaultSortDir : _state.SortDir,
            VisibleColumns.Select(c => c.Header).ToList()));
    }

    private async Task DeleteViewAsync(Guid id)
    {
        await OnDeleteView.InvokeAsync(id);
        await SetStateAsync(_state.Reset(view: DefaultViewKey));
    }

    private string DefaultViewKey => DefaultView ?? Views.FirstOrDefault()?.Key ?? string.Empty;

    private string? SubtitleText => _result is null ? null : $"{_result.Total:N0} {T[ItemLabel]}";

    private int PageCount => _result is null ? 1 : Math.Max(1, (int)Math.Ceiling(_result.Total / (double)PageSize));

    private string PagerText => _result is null ? string.Empty : T["{0} {1} · page {2} of {3}", _result.Total.ToString("N0"), T[ItemLabel], _state.Page, PageCount];

    private int FilterCount => _state.Filter?.Conditions.Count ?? 0;

    /// <summary>True when an empty list means "no records yet", not "nothing matches what you asked for".</summary>
    private bool NeverHadData => !_state.IsNarrowed && (Views.Count == 0 || _state.View == DefaultViewKey);

    private string RowClass => RowHref is not null || OnRowClick.HasDelegate ? "ml-row-click" : string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _state = ListState.FromQuery(new Uri(Nav.Uri).Query, DefaultViewKey, AllViews.Select(v => v.Key).ToList());
        if (_state.SortField is null && DefaultSortField is not null)
        {
            _state = _state with { SortField = DefaultSortField, SortDir = DefaultSortDir ?? "asc" };
        }

        Nav.LocationChanged += OnLocationChanged;
        await LoadAsync();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (_selfNavigating)
        {
            _selfNavigating = false;
            return;
        }

        // Back and forward buttons: show whatever the address now says.
        var parsed = ListState.FromQuery(new Uri(e.Location).Query, DefaultViewKey, AllViews.Select(v => v.Key).ToList());
        if (parsed != _state)
        {
            _state = parsed;
            _ = InvokeAsync(LoadAsync);
        }
    }

    private async Task SetStateAsync(ListState next)
    {
        if (next == _state)
        {
            return;
        }

        _state = next;
        _selfNavigating = true;

        // A different search, filter, view or page shows different rows, so what was ticked no longer applies.
        ClearSelection();
        var query = _state.ToQuery(DefaultViewKey).ToDictionary(kv => kv.Key, kv => (object?)kv.Value);

        // The default sort is not worth putting in the address. Only a sort the user chose is.
        if (_state.SortField == DefaultSortField && (_state.SortDir ?? "asc") == (DefaultSortDir ?? "asc"))
        {
            query[ListState.SortKey] = null;
            query[ListState.DirKey] = null;
        }

        Nav.NavigateTo(Nav.GetUriWithQueryParameters(query), replace: true);
        await LoadAsync();
    }

    /// <summary>Loads the current page again, for example after a record was created.</summary>
    public async Task ReloadAsync() => await LoadAsync();

    private ListQuery? _lastQuery;

    /// <summary>The search, filters and sort the list is showing now, so an export can ask for exactly the same records.</summary>
    public ListQuery CurrentQuery => _lastQuery ?? new ListQuery(_state.Search, EffectiveFilter(), _state.SortField ?? DefaultSortField, DefaultSortDir, 1, PageSize);

    private async Task LoadAsync()
    {
        var request = ++_requestId;
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            var query = new ListQuery(
                _state.Search,
                EffectiveFilter(),
                _state.SortField ?? DefaultSortField,
                _state.SortField is null ? DefaultSortDir : _state.SortDir,
                _state.Page,
                PageSize);
            _lastQuery = query;
            var result = await Loader(query);
            if (request != _requestId)
            {
                return; // A newer search or page was started while this one was loading. Ignore the old answer.
            }

            _result = result;
        }
        catch (ListLoadException ex)
        {
            if (request == _requestId)
            {
                _result = null;
                _error = ex.Message;
            }
        }
        catch (HttpRequestException)
        {
            if (request == _requestId)
            {
                _result = null;
                _error = T["We could not reach MindLift. Check your connection and try again."];
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            if (request == _requestId)
            {
                _result = null;
                _error = T["We could not load this list. Try again."];
            }
        }
        finally
        {
            if (request == _requestId)
            {
                _loading = false;
            }
        }
    }

    /// <summary>The view's own filter and the user's filters together, so a view tab and extra filters both apply.</summary>
    private FilterGroup? EffectiveFilter()
    {
        var view = AllViews.FirstOrDefault(v => v.Key == _state.View)?.Filter;
        var user = _state.HasFilter ? _state.Filter : null;
        if (view is null || user is null)
        {
            return view ?? user;
        }

        return new FilterGroup { Logic = "and", Groups = [view, user] };
    }

    private Color ViewColor(ListView view) => _state.View == view.Key ? Color.Primary : Color.Default;

    private static string ViewTestId(ListView view) => "view-" + view.Key;

    private async Task SelectViewAsync(ListView view)
    {
        _viewColumns = view.Columns.Count > 0 ? view.Columns : null;
        var next = _state.Reset(view: view.Key);
        if (view.SortField is not null)
        {
            next = next with { SortField = view.SortField, SortDir = view.SortDir ?? "asc" };
        }

        await SetStateAsync(next);
    }

    private async Task SearchAsync(string? text) => await SetStateAsync(_state.Reset(search: text, clearSearch: string.IsNullOrWhiteSpace(text)));

    private async Task ClearAsync() => await SetStateAsync(_state.Reset(clearSearch: true, clearFilter: true));

    private async Task GoToPageAsync(int page) => await SetStateAsync(_state with { Page = Math.Clamp(page, 1, PageCount) });

    private async Task SortAsync(string field)
    {
        // First click sorts ascending, second descending, third goes back to the default order.
        var next = _state.SortField != field ? (field, "asc")
            : _state.SortDir == "asc" ? (field, "desc")
            : ((string?)null, (string?)null);
        await SetStateAsync(_state with { SortField = next.Item1, SortDir = next.Item2, Page = 1 });
    }

    private static string SortTestId(ListColumn<TItem> column) => "sort-" + column.SortField;

    private string? SortAria(ListColumn<TItem> column)
        => column.SortField is null || _state.SortField != column.SortField ? null : _state.SortDir == "desc" ? "descending" : "ascending";

    private string SortIcon() => _state.SortDir == "desc" ? Icons.Material.Outlined.ArrowDownward : Icons.Material.Outlined.ArrowUpward;

    private static string ColumnClass(ListColumn<TItem> column)
        => string.Join(' ', new[] { column.HideOnTablet ? "ml-hide-tablet" : null, column.AlignEnd ? "ml-end" : null }.Where(c => c is not null));

    private async Task OpenAsync(TItem item)
    {
        if (OnRowClick.HasDelegate)
        {
            await OnRowClick.InvokeAsync(item);
        }
        else if (RowHref?.Invoke(item) is { } href)
        {
            Nav.NavigateTo(href);
        }
    }

    // ---- filters ----

    private void OpenFilters()
    {
        _draft = _state.Filter;
        _filtersOpen = true;
    }

    private void CloseFilters() => _filtersOpen = false;

    private async Task ApplyFiltersAsync()
    {
        _filtersOpen = false;
        var has = _draft is { Conditions.Count: > 0 } or { Groups.Count: > 0 };
        await SetStateAsync(_state.Reset(filter: has ? _draft : null, clearFilter: !has));
    }

    private async Task ResetFiltersAsync()
    {
        _draft = null;
        _filtersOpen = false;
        await SetStateAsync(_state.Reset(clearFilter: true));
    }

    private async Task RemoveConditionAsync(FilterCondition condition)
    {
        if (_state.Filter is not { } filter)
        {
            return;
        }

        var left = new FilterGroup { Logic = filter.Logic, Conditions = filter.Conditions.Where(c => c != condition).ToList(), Groups = filter.Groups };
        var has = left.Conditions.Count > 0 || left.Groups.Count > 0;
        await SetStateAsync(_state.Reset(filter: has ? left : null, clearFilter: !has));
    }

    private IEnumerable<(FilterCondition Condition, string Text)> Chips()
    {
        foreach (var condition in _state.Filter?.Conditions ?? [])
        {
            if (Fields.FirstOrDefault(f => f.Key == condition.Field) is { } field)
            {
                yield return (condition, FilterDescriber.Describe(condition, field, Picklists, Users, T));
            }
        }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
