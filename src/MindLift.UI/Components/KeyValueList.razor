@inject Translator T
<div class="ml-kv" data-testid="key-value-list">
    @foreach (var (label, value) in Items)
    {
        <div class="ml-kv__label">@T[label]</div>
        <div class="ml-kv__value" title="@value" style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:100%; display:block;">
            @if (value is null || string.IsNullOrWhiteSpace(value)) { <span class="ml-faint">—</span> }
            else { @value }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<(string Label, string? Value)> Items { get; set; } = [];
}
