@using FieldType = MindLift.Shared.Filtering.FieldType
@inject Translator T

@foreach (var field in Fields)
{
    if (HiddenFields?.Contains(field.Key) == true)
    {
        continue;
    }

    var isMandatory = field.IsRequired || MandatoryFields?.Contains(field.Key) == true;
    var isReadOnly = ReadOnlyFields?.Contains(field.Key) == true;

    if (IsCountryField(field))
    {
        <CountryPicker Value="@GetText(field.Key)" ValueChanged="v => Set(field.Key, v)" Label="@Label(field, isMandatory)" Required="@isMandatory" Disabled="@isReadOnly" Class="mb-3" TestId="@($"cf-{field.Key}")" />
    }
    else
    {
        switch (field.Type)
        {
            case FieldType.Boolean:
                <MudCheckBox T="bool" Value="@GetBool(field.Key)" ValueChanged="v => Set(field.Key, v)" Label="@Label(field, isMandatory)" Color="Color.Primary" Disabled="@isReadOnly" Class="mb-2" data-testid="@($"cf-{field.Key}")" />
                break;
            case FieldType.Number:
            case FieldType.Decimal:
            case FieldType.Currency:
            case FieldType.Percent:
                <MudNumericField T="decimal?" Value="@GetDecimal(field.Key)" ValueChanged="v => Set(field.Key, v)" Label="@Label(field, isMandatory)" Variant="Variant.Outlined" Margin="Margin.Dense" Required="@isMandatory" Disabled="@isReadOnly" Class="mb-3" data-testid="@($"cf-{field.Key}")" />
                break;
            case FieldType.Date:
                <MudTextField T="string" Value="@GetText(field.Key)" ValueChanged="v => Set(field.Key, v)" Label="@Label(field, isMandatory)" InputType="InputType.Date" Variant="Variant.Outlined" Margin="Margin.Dense" Required="@isMandatory" Disabled="@isReadOnly" Class="mb-3" data-testid="@($"cf-{field.Key}")" />
                break;
            case FieldType.Picklist:
                <MudSelect T="string" Value="@GetText(field.Key)" ValueChanged="v => Set(field.Key, v)" Label="@Label(field, isMandatory)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Clearable="true" Disabled="@isReadOnly" data-testid="@($"cf-{field.Key}")">
                    @foreach (var option in field.Options ?? [])
                    {
                        <MudSelectItem T="string" Value="@option.Value">@T.Pick(option.Label, option.LabelAr)</MudSelectItem>
                    }
                </MudSelect>
                break;
            case FieldType.TextArea:
                <MudTextField T="string" Value="@GetText(field.Key)" ValueChanged="v => Set(field.Key, v)" Label="@Label(field, isMandatory)" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" Disabled="@isReadOnly" Class="mb-3" data-testid="@($"cf-{field.Key}")" />
                break;
            default:
                <MudTextField T="string" Value="@GetText(field.Key)" ValueChanged="v => Set(field.Key, v)" Label="@Label(field, isMandatory)" Variant="Variant.Outlined" Margin="Margin.Dense" Required="@isMandatory" Disabled="@isReadOnly" Class="mb-3" data-testid="@($"cf-{field.Key}")" />
                break;
        }
    }
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<FieldDto> Fields { get; set; } = [];
    [Parameter, EditorRequired] public Dictionary<string, JsonElement?> Values { get; set; } = new();
    [Parameter] public EventCallback<Dictionary<string, JsonElement?>> ValuesChanged { get; set; }

    [Parameter] public IReadOnlySet<string>? HiddenFields { get; set; }
    [Parameter] public IReadOnlySet<string>? MandatoryFields { get; set; }
    [Parameter] public IReadOnlySet<string>? ReadOnlyFields { get; set; }

    private static bool IsCountryField(FieldDto field)
    {
        return field.Key.Equals("cf_country", StringComparison.OrdinalIgnoreCase) ||
               field.Key.Equals("country", StringComparison.OrdinalIgnoreCase) ||
               field.Label.Equals("Country", StringComparison.OrdinalIgnoreCase);
    }

    private string Label(FieldDto field, bool isMandatory) => isMandatory ? $"{T.Pick(field.Label, field.LabelAr)} *" : T.Pick(field.Label, field.LabelAr);

    private string? GetText(string key) => Values.TryGetValue(key, out var v) && v is { ValueKind: JsonValueKind.String } s ? s.GetString() : null;

    private bool GetBool(string key) => Values.TryGetValue(key, out var v) && v is { ValueKind: JsonValueKind.True };

    private decimal? GetDecimal(string key) => Values.TryGetValue(key, out var v) && v is { ValueKind: JsonValueKind.Number } n ? n.GetDecimal() : null;

    private async Task Set(string key, object? value)
    {
        Values[key] = value switch
        {
            null => null,
            string text when text.Length == 0 => null,
            string text => JsonSerializer.SerializeToElement(text),
            bool flag => JsonSerializer.SerializeToElement(flag),
            decimal number => JsonSerializer.SerializeToElement(number),
            _ => JsonSerializer.SerializeToElement(value),
        };

        await ValuesChanged.InvokeAsync(Values);
    }
}
