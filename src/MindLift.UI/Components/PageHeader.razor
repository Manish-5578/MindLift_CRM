@inject Translator T

<div class="ml-page-header" data-testid="page-header">
    @if (Breadcrumbs is { Count: > 0 })
    {
        <MudBreadcrumbs Items="TranslatedBreadcrumbs" Class="ml-breadcrumbs" MaxItems="4" />
    }
    <div class="ml-page-header__row">
        <div class="ml-page-header__titles" style="min-width:0; max-width:100%; overflow:hidden;">
            <MudText Typo="Typo.h4" Class="ml-truncate" title="@(TranslateTitle ? T[Title] : Title)" style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:100%;" data-testid="page-title">@(TranslateTitle ? T[Title] : Title)</MudText>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <MudText Typo="Typo.body2" Class="ml-muted ml-truncate" title="@Subtitle" style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:100%;">@T[Subtitle]</MudText>
            }
        </div>
        @if (Actions is not null)
        {
            <div class="ml-page-header__actions">@Actions</div>
        }
    </div>
    @if (Tabs is not null)
    {
        <div class="ml-page-header__tabs">@Tabs</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>True for a fixed title such as "Contacts". Pass false when the title is a record's own name, so the name is never looked up as a phrase.</summary>
    [Parameter] public bool TranslateTitle { get; set; } = true;

    [Parameter] public List<BreadcrumbItem>? Breadcrumbs { get; set; }

    private List<BreadcrumbItem> TranslatedBreadcrumbs
        => (Breadcrumbs ?? []).Select(b => new BreadcrumbItem(T[b.Text], b.Href, b.Disabled)).ToList();
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? Tabs { get; set; }
}
