        { "name": "Proposal", "nameAr": "العرض", "probability": 40, "type": "Open", "rottingDays": 10 },
        { "name": "Signed", "nameAr": "موقع", "probability": 70, "type": "Open", "rottingDays": 14 },
        { "name": "In progress", "nameAr": "قيد التنفيذ", "probability": 90, "type": "Open", "rottingDays": 30 },
        { "name": "Closed", "nameAr": "مغلق", "probability": 100, "type": "Won" },
        { "name": "Lost", "nameAr": "خاسر", "probability": 0, "type": "Lost" }
      ]
    }
  ],
  "customFields": [
    { "entity": "deals", "key": "cf_service_type", "label": "Service type", "labelAr": "نوع الخدمة", "type": "Text", "showInList": true },
    { "entity": "deals", "key": "cf_fee_basis", "label": "Fee basis", "labelAr": "أساس الرسوم", "type": "Picklist",
