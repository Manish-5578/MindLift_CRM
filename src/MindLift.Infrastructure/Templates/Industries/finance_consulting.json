        { "value": "fixed", "label": "Fixed", "labelAr": "ثابت" },
        { "value": "hourly", "label": "Hourly", "labelAr": "بالساعة" },
        { "value": "retainer", "label": "Retainer", "labelAr": "اشتراك" },
        { "value": "success_fee", "label": "Success fee", "labelAr": "نسبة من النجاح" }
      ] },
    { "entity": "deals", "key": "cf_renewal_date", "label": "Renewal date", "labelAr": "تاريخ التجديد", "type": "Date", "showInList": true }
