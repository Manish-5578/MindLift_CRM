{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Storage": {
    "LocalPath": "App_Data/files"
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "AllowedHosts": "*"
}

