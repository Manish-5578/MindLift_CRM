@page "/{Slug}/magic"
@inherits PortalPageBase

<PageTitle>@T["magic.confirm"] · @Session.Branding?.TenantName</PageTitle>

@if (!Ready)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else if (UnknownCompany)
{
    <NoCompany Message='@T["login.unknownCompany"]' />
}
else if (_verifying)
{
    <AuthCard Title='@T["magic.checking"]'>
        <div class="d-flex justify-center my-6">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
        </div>
    </AuthCard>
}
else if (!string.IsNullOrEmpty(_error))
{
    <AuthCard Title='@T["app.name"]' Subtitle="@_error">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Href='@Link("login")' Class="mt-4" id="magic-retry">
            @T["magic.back"]
        </MudButton>
    </AuthCard>
}
else if (Session.User is not null)
{
    <AuthCard Title='@T["login.title"]' Subtitle='@string.Format("You are already signed in as {0}. Opening this magic link will switch your session to another account.", Session.User.CustomerName)'>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="VerifyAsync" Class="mt-4" id="magic-confirm">
            Switch Account
        </MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" Href='@Link()' Class="mt-2" id="magic-keep">
            Keep Current Session
        </MudButton>
    </AuthCard>
}
else
{
    <AuthCard Title='@T["login.title"]' Subtitle='@T["magic.prompt"]'>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="VerifyAsync" Class="mt-4" id="magic-confirm">
            @T["magic.confirm"]
        </MudButton>
    </AuthCard>
}

@code {
    protected override bool RequiresSignIn => false;

    [SupplyParameterFromQuery] public string? Token { get; set; }

    private string? _cachedToken;
    private bool _verifying;
    private string? _error;

    protected override Task LoadAsync()
    {
        var extracted = ExtractTokenFromUri(Nav.Uri, Token);
        if (!string.IsNullOrWhiteSpace(extracted))
        {
            _cachedToken = extracted;
            Token = null;
            Nav.NavigateTo(Link("magic"), replace: true);
        }
        else if (string.IsNullOrWhiteSpace(_cachedToken))
        {
            _error = T["magic.failed"];
        }
        return Task.CompletedTask;
    }

    private static string? ExtractTokenFromUri(string uri, string? queryToken)
    {
        if (!string.IsNullOrWhiteSpace(queryToken)) return queryToken;
        if (string.IsNullOrWhiteSpace(uri)) return null;

        var hashIdx = uri.IndexOf('#');
        if (hashIdx >= 0 && hashIdx < uri.Length - 1)
        {
            var fragment = uri[(hashIdx + 1)..];
            var pairs = fragment.Split('&');
            foreach (var pair in pairs)
            {
                var kv = pair.Split('=', 2);
                if (kv.Length == 2 && string.Equals(kv[0], "token", StringComparison.OrdinalIgnoreCase))
                {
                    return Uri.UnescapeDataString(kv[1]);
                }
            }
        }

        var qIdx = uri.IndexOf('?');
        if (qIdx >= 0)
        {
            var query = uri[(qIdx + 1)..];
            if (hashIdx > qIdx)
            {
                query = query[..(hashIdx - qIdx - 1)];
            }
            var pairs = query.Split('&');
            foreach (var pair in pairs)
            {
                var kv = pair.Split('=', 2);
                if (kv.Length == 2 && string.Equals(kv[0], "token", StringComparison.OrdinalIgnoreCase))
                {
                    return Uri.UnescapeDataString(kv[1]);
                }
            }
        }

        return null;
    }

    private async Task VerifyAsync()
    {
        var token = _cachedToken ?? Token;
        if (string.IsNullOrWhiteSpace(token))
        {
            _error = T["magic.failed"];
            return;
        }

        _verifying = true;
        try
        {
            var req = new PortalMagicLinkVerifyRequest(token.Trim());
            var resp = await Session.Anonymous.PostAsJsonAsync(Api($"{Uri.EscapeDataString(Slug)}/auth/magic-link/verify"), req);
            if (resp.IsSuccessStatusCode)
            {
                var login = await resp.Content.ReadFromJsonAsync<PortalLoginResponse>();
                if (login is not null)
                {
                    await CompleteSignInAsync(login);
                    return;
                }
            }

            _error = await ErrorCodeAsync(resp) switch
            {
                "portal_disabled" => T["login.disabled"],
                "expired_token" or "invalid_token" => T["magic.failed"],
                _ => await DetailAsync(resp, T["magic.failed"])
            };
        }
        catch (HttpRequestException)
        {
            _error = T["common.error"];
        }
        finally
        {
            _verifying = false;
        }
    }
}
