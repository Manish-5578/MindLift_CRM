@page "/contacts"
@using MindLift.Shared.Filtering
@using FilterOperator = MindLift.Shared.Filtering.FilterOperator
@inject HttpClient Http
@inject AuthSession Session
@inject AppState App
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject Translator T

<PageTitle>@T[App.ModuleLabel(AppModule.Contacts)] · MindLift</PageTitle>

<div class="ml-page ml-page--narrow">
    @if (App.Bootstrap is not null)
    {
        <EntityListPage @ref="_list" TItem="ContactListItemDto" Title="@App.ModuleLabel(AppModule.Contacts)" ItemLabel="@ItemLabel"
                        Views="_views" DefaultView="all" Columns="_columns" CardTemplate="_card" Loader="LoadAsync" RowHref="Href"
                        Fields="Fields" Picklists="App.Bootstrap.Picklists" Users="_users"
                        SearchPlaceholder="Search name, email, phone or job title" EmptyIcon="@Icons.Material.Outlined.Contacts"
                        EmptyTitle="No contacts yet" EmptyMessage="Contacts appear here when you add them, import them, or convert a lead."
                        DefaultSortField="created_at" DefaultSortDir="desc">
            <HeaderActions>
                @if (Can(p => p.CanImport))
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Upload" Href="/contacts/import" data-testid="import-contacts">@T["Import"]</MudButton>
                }
                @if (Can(p => p.CanExport))
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Download" OnClick="ExportAsync" data-testid="export-contacts">@T["Export"]</MudButton>
                }
                @if (Can(p => p.CanCreate))
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="OpenNew" data-testid="primary-action">@T["New contact"]</MudButton>
                }
            </HeaderActions>
            <EmptyActions>
                @if (Can(p => p.CanCreate))
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenNew">@T["New contact"]</MudButton>
                }
            </EmptyActions>
        </EntityListPage>
    }
</div>

<ContactFormDrawer @ref="_form" @bind-Open="_drawer" OnSaved="OnSaved" />

@code {
    private EntityListPage<ContactListItemDto>? _list;
    private ContactFormDrawer? _form;
    private bool _drawer;
    private List<UserListItem> _users = [];
    private IReadOnlyList<ListView> _views = [];
    private IReadOnlyList<ListColumn<ContactListItemDto>> _columns = [];
    private RenderFragment<ContactListItemDto> _card = _ => _ => { };

    private bool Can(Func<ModulePermissionDto, bool> check) => App.Bootstrap?.Permissions.Any(p => p.Module == "Contacts" && check(p)) == true;

    private string ItemLabel => App.ModuleLabel(AppModule.Contacts).ToLowerInvariant();

    private IReadOnlyList<FieldDto> Fields => App.Bootstrap?.Fields.GetValueOrDefault("contacts") ?? [];

    private static string? Href(ContactListItemDto contact) => "/contacts/" + contact.Id;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsSignedIn)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        _views =
        [
            new("all", "All contacts", new FilterGroup()),
            new("mine", "My contacts", new FilterGroup
            {
                Conditions = [new FilterCondition { Field = "owner_id", Op = FilterOperator.Eq, Value = JsonSerializer.SerializeToElement("@me") }],
            }),
        ];

        _columns =
        [
            new()
            {
                Header = "Name", SortField = "first_name",
                Cell = c =>
                    @<div class="ml-cell-primary">
                        <UserAvatar Name="@c.FullName" Id="@c.Id" Size="32" />
                        <div class="ml-cell-primary__text">
                            <MudText Typo="Typo.subtitle2" Class="ml-truncate">@c.FullName</MudText>
                            <MudText Typo="Typo.caption" Class="ml-muted ml-truncate">@(c.JobTitle ?? c.Email ?? "—")</MudText>
                        </div>
                    </div>,
            },
            new() { Header = "Company", Cell = c => @<span>@(c.AccountName ?? "—")</span> },
            new() { Header = "Email", SortField = "email", HideOnTablet = true, Cell = c => @<span class="ml-muted ml-truncate">@(c.Email ?? "—")</span> },
            new() { Header = "Owner", Cell = c => @<span>@(c.OwnerName ?? "—")</span> },
            new() { Header = "Created", SortField = "created_at", AlignEnd = true, Cell = c => @<DateText Value="@c.CreatedAtUtc" /> },
        ];

        _card = c =>
            @<div class="ml-cell-primary">
                <UserAvatar Name="@c.FullName" Id="@c.Id" Size="40" />
                <div class="ml-cell-primary__text ml-grow">
                    <MudText Typo="Typo.subtitle1" Class="ml-truncate">@c.FullName</MudText>
                    <MudText Typo="Typo.body2" Class="ml-muted ml-truncate">@(c.Email ?? c.Phone ?? "—")</MudText>
                    <MudText Typo="Typo.caption" Class="ml-muted ml-truncate">@(c.AccountName ?? T["No company"])</MudText>
                </div>
            </div>;

        _users = await RecordLookups.UsersAsync(Http);
    }

    private void OpenNew()
    {
        _form?.OpenNew();
        _drawer = true;
    }

    private async Task OnSaved()
    {
        Snackbar.Add(T["Contact saved"], Severity.Success);
        if (_list is not null)
        {
            await _list.ReloadAsync();
        }
    }

    private async Task<PagedResult<ContactListItemDto>> LoadAsync(ListQuery query)
    {
        var response = await Http.PostAsJsonAsync("api/v1/contacts/query", query);
        if (!response.IsSuccessStatusCode)
        {
            throw new ListLoadException(await ProblemText.FromAsync(response, T["We could not load your contacts. Try again."]));
        }

        return (await response.Content.ReadFromJsonAsync<PagedResult<ContactListItemDto>>())!;
    }

    private async Task ExportAsync()
    {
        if (_list is null)
        {
            return;
        }

        var response = await Http.PostAsJsonAsync("api/v1/contacts/export", _list.CurrentQuery with { Page = 1, PageSize = 200 });
        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add(await ProblemText.FromAsync(response, T["We could not export your contacts."]), Severity.Error);
            return;
        }

        await JS.InvokeVoidAsync("mindlift.downloadFile", "contacts.csv", "text/csv", Convert.ToBase64String(await response.Content.ReadAsByteArrayAsync()));
        Snackbar.Add(T["Export ready"], Severity.Success);
    }
}
