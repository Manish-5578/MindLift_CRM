@page "/contacts/{Id:guid}"
@inject HttpClient Http
@inject AuthSession Session
@inject AppState App
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject Translator T

<PageTitle>@T["Contact"] · MindLift</PageTitle>

<div class="ml-page ml-page--narrow">
    @if (_loading)
    {
        <MlCard Loading="true" />
    }
    else if (_summary is null)
    {
        <ErrorState Title="We could not open this contact" Message="@(_error ?? "It may have been deleted, or you may not have access to it.")" OnRetry="LoadAsync" />
    }
    else
    {
        var contact = _summary.Contact;
        <RecordDetailLayout Title="@FullName" Subtitle="@Subtitle"
                            Breadcrumbs="@(new List<BreadcrumbItem> { new(App.ModuleLabel(AppModule.Contacts), "/contacts"), new(contact.FirstName, null, true) })">
            <Badges>
                @if (contact.Type is not null) { <StatusChip Text="@TypeLabel(contact.Type)" Dot="false" /> }
                <MudText Typo="Typo.body2" Class="ml-muted">@T["Created"] <DateText Value="@contact.CreatedAtUtc" /></MudText>
                @if (_portal is not null && _portal.Status != NotInvited)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@PortalColor" Icon="@Icons.Material.Outlined.VpnKey" data-testid="portal-status">@PortalText</MudChip>
                }
            </Badges>
            <Actions>
                @if (Can(p => p.CanEdit))
                {
                    <MudButton Variant="Variant.Outlined" OnClick="FindDuplicatesAsync" data-testid="find-duplicates">@T["Find duplicates"]</MudButton>
                }
                @if (Can(p => p.CanEdit) && !string.IsNullOrWhiteSpace(contact.Email))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.VpnKey" OnClick="InviteToPortalAsync" Disabled="_inviting" data-testid="invite-portal">@InviteLabel</MudButton>
                }
                @if (Can(p => p.CanDelete))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="DeleteAsync" data-testid="delete-contact">@T["Delete"]</MudButton>
                }
                @if (Can(p => p.CanEdit))
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenEdit" data-testid="primary-action">@T["Edit"]</MudButton>
                }
            </Actions>
            <ChildContent>
                @if (_showDuplicates)
                {
                    <MlCard Title="Possible duplicates" Subtitle="Contacts with the same email or phone." TestId="duplicates-panel">
                        <div class="ml-stack">
                            @if (_candidates.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Class="ml-muted" data-testid="no-duplicates">@T["Nothing else shares this contact's email or phone."]</MudText>
                            }

                            @foreach (var candidate in _candidates)
                            {
                                var current = candidate;
                                <div class="ml-row" style="padding:6px 0;border-bottom:1px solid var(--ml-border)" data-testid="duplicate-row">
                                    <MudCheckBox T="bool" Value="_selectedIds.Contains(current.Id)" ValueChanged="v => Toggle(current.Id, v)" Color="Color.Primary" aria-label="@("Merge " + current.FullName)" />
                                    <div class="ml-grow">
                                        <a href="@("/contacts/" + current.Id)" class="ml-link">@current.FullName</a>
                                        <MudText Typo="Typo.caption" Class="ml-muted">@(current.Email ?? current.Phone ?? "No contact details") · @current.Reason</MudText>
                                    </div>
                                </div>
                            }

                            <div class="ml-row" style="justify-content:flex-end">
                                <MudButton OnClick="() => _showDuplicates = false">@T["Close"]</MudButton>
                                @if (_candidates.Count > 0)
                                {
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="MergeAsync" data-testid="merge-submit">@T["Merge selected"]</MudButton>
                                }
                            </div>
                        </div>
                    </MlCard>
                }

                <MlCard Title="Details">
                    <div class="ml-kv" data-testid="contact-details">
                        <div class="ml-kv__label">@T["Email"]</div><div class="ml-kv__value"><FieldValue Kind="FormFieldKind.Email" Value="@contact.Email" /></div>
                        <div class="ml-kv__label">@T["Phone"]</div><div class="ml-kv__value"><FieldValue Kind="FormFieldKind.Phone" Value="@contact.Phone" /></div>
                        <div class="ml-kv__label">@T["Job title"]</div><div class="ml-kv__value"><FieldValue Value="@contact.JobTitle" /></div>
                        <div class="ml-kv__label">@T["Owner"]</div><div class="ml-kv__value"><FieldValue Kind="FormFieldKind.User" Value="@contact.OwnerId.ToString()" Users="_users" /></div>
                        <div class="ml-kv__label">@T["Notes"]</div><div class="ml-kv__value"><FieldValue Kind="FormFieldKind.Multiline" Value="@contact.Description" /></div>
                        @foreach (var field in CustomFields)
                        {
                            <div class="ml-kv__label">@field.Label</div>
                            <div class="ml-kv__value"><FieldValue Value="@CustomText(field.Key)" /></div>
                        }
                    </div>
                </MlCard>

                <RecordActivities ContactId="Id" OnChanged="ReloadTimelineAsync" />
                <RecordTimeline @ref="_timeline" EntityType="contacts" EntityId="Id" />
                <RecordDocuments EntityType="contacts" EntityId="Id" />
                <RecordFiles EntityType="contacts" EntityId="Id" />
            </ChildContent>
            <Aside>
                <MlCard Title="@(_multiAccountFeatureAvailable ? T["Accounts ({0})", _linkedAccounts.Count > 0 ? _linkedAccounts.Count : (contact.AccountId.HasValue ? 1 : 0)] : T["Company"])">
                    @if (!_multiAccountFeatureAvailable)
                    {
                        @if (contact.AccountId is { } accountId)
                        {
                            <a href="@("/accounts/" + accountId)" class="ml-link" data-testid="contact-account-link">@contact.AccountName</a>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="ml-muted">@T["Not linked to a company."]</MudText>
                        }
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2">
                            @if (_linkedAccounts.Count == 0 && !contact.AccountId.HasValue)
                            {
                                <MudText Typo="Typo.body2" Class="ml-muted">@T["Not linked to any company."]</MudText>
                            }
                            else if (_linkedAccounts.Count == 0 && contact.AccountId.HasValue)
                            {
                                <div class="d-flex align-center justify-space-between pa-2 rounded" style="background:var(--mud-palette-background-grey)">
                                    <div class="d-flex flex-column">
                                        <a href="@("/accounts/" + contact.AccountId)" class="ml-link" style="font-weight:600;" data-testid="contact-account-link">@contact.AccountName</a>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" Class="mt-1" Style="font-size:10px;height:18px;padding:0 6px;">@T["Primary"]</MudChip>
                                    </div>
                                </div>
                            }
                            else
                            {
                                @foreach (var acc in _linkedAccounts)
                                {
                                    <div class="d-flex align-center justify-space-between pa-2 rounded" style="border:1px solid var(--ml-border, #e2e8f0); background:var(--mud-palette-surface);" data-testid="linked-account-row">
                                        <div class="d-flex flex-column" style="overflow:hidden; text-overflow:ellipsis;">
                                            <div class="d-flex align-center gap-1">
                                                <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" Color="Color.Default" Style="font-size:16px;" />
                                                <a href="@("/accounts/" + acc.AccountId)" class="ml-link" style="font-weight:600;" data-testid="account-link-item">@acc.AccountName</a>
                                            </div>
                                            <div class="d-flex align-center gap-1 mt-1">
                                                @if (acc.IsPrimary)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Style="font-size:10px;height:18px;padding:0 6px;">@T["Primary"]</MudChip>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(acc.Role))
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled" Style="font-size:10px;height:18px;padding:0 6px;">@acc.Role</MudChip>
                                                }
                                            </div>
                                        </div>
                                        @if (!acc.IsPrimary && acc.LinkId.HasValue && Can(p => p.CanEdit))
                                        {
                                            <MudTooltip Text="@T["Unlink Account"]">
                                                <MudIconButton Icon="@Icons.Material.Filled.LinkOff" Size="Size.Small" Color="Color.Error" OnClick="() => UnlinkAccountAsync(acc.LinkId.Value)" Disabled="_linking" data-testid="unlink-account-btn" />
                                            </MudTooltip>
                                        }
                                    </div>
                                }
                            }

                            @if (Can(p => p.CanEdit))
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.AddLink" OnClick="OpenLinkAccountDialog" Class="mt-2" data-testid="link-account-btn">
                                    @T["Link Another Account"]
                                </MudButton>
                            }
                        </div>
                    }
                </MlCard>
                <MlCard Title="@($"Deals ({_summary.DealCount})")">
                    @if (_summary.Deals.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="ml-muted">@T["No deals yet."]</MudText>
                    }
                    @foreach (var deal in _summary.Deals)
                    {
                        <div class="ml-row" style="padding:4px 0"><span class="ml-grow">@deal.Name</span><MoneyText Amount="deal.Amount" Currency="@deal.Currency" /></div>
                    }
                </MlCard>
                <MlCard Title="Activity">
                    <MudText Typo="Typo.body2" Class="ml-muted" data-testid="activity-count">@T[_summary.ActivityCount == 1 ? "{0} activity logged." : "{0} activities logged.", _summary.ActivityCount]</MudText>
                </MlCard>
            </Aside>
        </RecordDetailLayout>
    }
</div>

<ContactFormDrawer @ref="_form" @bind-Open="_drawer" OnSaved="OnSaved" />

<MudDialog @bind-Visible="_linkAccountDialogOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true }">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Hub" Color="Color.Primary" />
            <MudText Typo="Typo.h6">@T["Link Account to Contact"]</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column gap-3 py-2">
            <MudText Typo="Typo.body2" Class="ml-muted">
                @T["Associate this contact with an additional company, e.g. as an external advisor, board member, partner, or legal counsel."]
            </MudText>
            <RecordPicker Search="@((text, ct) => RecordLookups.AccountsAsync(Http, text, ct))"
                          Label="@T["Select Account"]"
                          Value="_selectedAccountId"
                          Text="@_selectedAccountName"
                          ValueChanged="v => _selectedAccountId = v" />
            <MudTextField @bind-Value="_linkRole" Label="@T["Role at Company (Optional)"]" Placeholder="e.g. Legal Counsel, Board Member, Consultant" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _linkAccountDialogOpen = false" Disabled="_linking">@T["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveLinkedAccountAsync" Disabled="@(_linking || !_selectedAccountId.HasValue)" data-testid="confirm-link-account">
            @if (_linking)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <span class="ms-2">@T["Linking..."]</span>
            }
            else
            {
                @T["Link Account"]
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public Guid Id { get; set; }

    private ContactFormDrawer? _form;
    private bool _drawer;
    private bool _loading = true;
    private string? _error;
    private ContactSummaryDto? _summary;
    private List<UserListItem> _users = [];
    private bool _showDuplicates;
    private IReadOnlyList<DuplicateCandidateDto> _candidates = [];
    private readonly HashSet<Guid> _selectedIds = [];

    private string FullName => _summary is null ? string.Empty : $"{_summary.Contact.FirstName} {_summary.Contact.LastName}".Trim();

    private string Subtitle => string.Join(" · ", new[] { _summary?.Contact.JobTitle, _summary?.Contact.AccountName }.Where(s => !string.IsNullOrWhiteSpace(s)));

    private IReadOnlyList<FieldDto> CustomFields => App.Bootstrap?.Fields.GetValueOrDefault("contacts")?.Where(f => f.IsCustom).ToList() ?? [];

    private bool Can(Func<ModulePermissionDto, bool> check) => App.Bootstrap?.Permissions.Any(p => p.Module == "Contacts" && check(p)) == true;

    private string? TypeLabel(string code)
        => App.PicklistLabel("contact_type", code);

    private string? CustomText(string key)
        => _summary!.Contact.CustomFields.TryGetValue(key, out var value) && value.ValueKind != JsonValueKind.Null ? value.ToString() : null;

    protected override async Task OnParametersSetAsync()
    {
        if (!Session.IsSignedIn)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        _users = await RecordLookups.UsersAsync(Http);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var response = await Http.GetAsync($"api/v1/contacts/{Id}/summary");
            _summary = response.IsSuccessStatusCode ? await response.Content.ReadFromJsonAsync<ContactSummaryDto>() : null;
            if (!response.IsSuccessStatusCode)
            {
                _error = await ProblemText.FromAsync(response, T["We could not open this contact."]);
            }
        }
        catch (HttpRequestException)
        {
            _summary = null;
            _error = T["We could not reach MindLift. Check your connection and try again."];
        }
        finally
        {
            _loading = false;
        }

        await LoadPortalAsync();
        await LoadLinkedAccountsAsync();
    }

    private const string NotInvited = "NotInvited";
    private PortalAccessStatusDto? _portal;
    private bool _inviting;

    private string InviteLabel => _portal is null || _portal.Status == NotInvited ? T["Invite to Portal"] : T["Resend portal invite"];

    private string PortalText => _portal?.Status switch
    {
        "Active" => T["Portal active"],
        "Invited" => T["Portal invite sent"],
        "Disabled" => T["Portal disabled"],
        _ => string.Empty
    };

    private Color PortalColor => _portal?.Status switch
    {
        "Active" => Color.Success,
        "Invited" => Color.Info,
        _ => Color.Default
    };

    private async Task LoadPortalAsync()
    {
        try
        {
            var response = await Http.GetAsync($"api/v1/contacts/{Id}/portal");
            _portal = response.IsSuccessStatusCode ? await response.Content.ReadFromJsonAsync<PortalAccessStatusDto>() : null;
        }
        catch (HttpRequestException)
        {
            _portal = null;
        }
    }

    private RecordTimeline? _timeline;

    private async Task ReloadTimelineAsync()
    {
        if (_timeline is not null)
        {
            await _timeline.ReloadAsync();
        }
    }


    private void OpenEdit()
    {
        _form?.OpenEdit(_summary!.Contact);
        _drawer = true;
    }

    private async Task OnSaved()
    {
        Snackbar.Add(T["Contact saved"], Severity.Success);
        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        if (!await Dialogs.ConfirmAsync($"Delete {FullName}?", T["The contact is removed from your lists. This cannot be undone from here."], T["Delete"], danger: true))
        {
            return;
        }

        var response = await Http.DeleteAsync($"api/v1/contacts/{Id}");
        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add(await ProblemText.FromAsync(response, T["We could not delete this contact."]), Severity.Error);
            return;
        }

        Snackbar.Add(T["Contact deleted"], Severity.Success);
        Nav.NavigateTo("/contacts");
    }

    private async Task FindDuplicatesAsync()
    {
        var c = _summary!.Contact;
        var response = await Http.PostAsJsonAsync("api/v1/contacts/check-duplicates", new CheckDuplicatesRequest(c.FirstName, c.LastName, c.Email, c.Phone, null));
        _candidates = response.IsSuccessStatusCode
            ? (await response.Content.ReadFromJsonAsync<List<DuplicateCandidateDto>>() ?? []).Where(d => d.Id != Id).ToList()
            : [];
        _selectedIds.Clear();
        _showDuplicates = true;
    }

    private void Toggle(Guid id, bool selected)
    {
        if (selected) _selectedIds.Add(id); else _selectedIds.Remove(id);
    }

    private async Task MergeAsync()
    {
        if (_selectedIds.Count == 0)
        {
            Snackbar.Add(T["Tick at least one contact to merge."], Severity.Warning);
            return;
        }

        var count = _selectedIds.Count;
        var plural = count == 1 ? string.Empty : "s";
        if (!await Dialogs.ConfirmAsync($"Merge {count} contact{plural} into {FullName}?",
                $"The selected contact{plural} will be removed. Empty fields here are filled from {(count == 1 ? "it" : "them")}, and activities move to this contact.", T["Merge"], danger: true))
        {
            return;
        }

        var response = await Http.PostAsJsonAsync($"api/v1/contacts/{Id}/merge", new MergeContactsRequest(_selectedIds.ToList()));
        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add(await ProblemText.FromAsync(response, T["We could not merge these contacts."]), Severity.Error);
            return;
        }

        Snackbar.Add($"Merged {count} contact{plural}", Severity.Success);
        _showDuplicates = false;
        await LoadAsync();
    }

    private async Task InviteToPortalAsync()
    {
        if (_summary?.Contact.Email is null) return;
        _inviting = true;
        try
        {
            var req = new InvitePortalUserRequest(Id, _summary.Contact.Email);
            var response = await Http.PostAsJsonAsync($"api/v1/contacts/{Id}/portal/invite", req);
            if (response.IsSuccessStatusCode)
            {
                _portal = await response.Content.ReadFromJsonAsync<PortalAccessStatusDto>();
                Snackbar.Add($"Portal invitation sent to {_summary.Contact.Email}", Severity.Success);
            }
            else
            {
                Snackbar.Add(await ProblemText.FromAsync(response, T["Could not send portal invitation."]), Severity.Error);
            }
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _inviting = false;
        }
    }

    private IReadOnlyList<ContactAccountDto> _linkedAccounts = [];
    private bool _multiAccountFeatureAvailable;
    private bool _linkAccountDialogOpen;
    private Guid? _selectedAccountId;
    private string? _selectedAccountName;
    private string? _linkRole;
    private bool _linking;

    private async Task LoadLinkedAccountsAsync()
    {
        try
        {
            var response = await Http.GetAsync($"api/v1/contacts/{Id}/accounts");
            if (response.IsSuccessStatusCode)
            {
                _multiAccountFeatureAvailable = true;
                _linkedAccounts = await response.Content.ReadFromJsonAsync<List<ContactAccountDto>>() ?? [];
            }
            else
            {
                _multiAccountFeatureAvailable = false;
                _linkedAccounts = [];
            }
        }
        catch
        {
            _multiAccountFeatureAvailable = false;
            _linkedAccounts = [];
        }
    }

    private void OpenLinkAccountDialog()
    {
        _selectedAccountId = null;
        _selectedAccountName = null;
        _linkRole = null;
        _linkAccountDialogOpen = true;
    }

    private async Task SaveLinkedAccountAsync()
    {
        if (!_selectedAccountId.HasValue) return;
        _linking = true;
        try
        {
            var req = new AddContactAccountRequest(_selectedAccountId.Value, string.IsNullOrWhiteSpace(_linkRole) ? null : _linkRole.Trim());
            var response = await Http.PostAsJsonAsync($"api/v1/contacts/{Id}/accounts", req);
            if (response.IsSuccessStatusCode)
            {
                _linkedAccounts = await response.Content.ReadFromJsonAsync<List<ContactAccountDto>>() ?? [];
                Snackbar.Add(T["Account linked successfully."], Severity.Success);
                _linkAccountDialogOpen = false;
            }
            else
            {
                Snackbar.Add(await ProblemText.FromAsync(response, T["Could not link account."]), Severity.Error);
            }
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _linking = false;
        }
    }

    private async Task UnlinkAccountAsync(Guid linkId)
    {
        _linking = true;
        try
        {
            var response = await Http.DeleteAsync($"api/v1/contacts/{Id}/accounts/{linkId}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(T["Account unlinked successfully."], Severity.Success);
                await LoadLinkedAccountsAsync();
            }
            else
            {
                Snackbar.Add(await ProblemText.FromAsync(response, T["Could not unlink account."]), Severity.Error);
            }
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _linking = false;
        }
    }
}
