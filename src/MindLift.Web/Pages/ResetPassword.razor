@page "/reset-password"
@layout AuthLayout
@inject HttpClient Http

<PageTitle>Choose a new password · MindLift</PageTitle>

<div class="ml-wizard" style="max-width:420px;margin-top:48px">
    <div class="ml-stack">
        <MudText Typo="Typo.h4" data-testid="page-title">Choose a new password</MudText>

        @if (_done)
        {
            <MudAlert Severity="Severity.Success" data-testid="reset-done">Your password is changed. You can sign in with it now.</MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Href="/login" data-testid="primary-action">Go to sign in</MudButton>
        }
        else if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token))
        {
            <MudAlert Severity="Severity.Error" data-testid="reset-invalid">This link is not complete. Open the link from the email again, or ask for a new one.</MudAlert>
            <MudButton Variant="Variant.Outlined" Href="/forgot-password">Ask for a new link</MudButton>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="ml-muted">For @Email</MudText>
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" data-testid="reset-error">@_error</MudAlert>
            }

            <MudTextField @bind-Value="_password" Label="New password" Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Password" Required="true"
                          HelperText="At least 8 characters, with upper and lower case letters and a digit." data-testid="reset-password" />
            <MudTextField @bind-Value="_confirm" Label="Repeat the password" Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Password" Required="true" OnKeyDown="OnKey" data-testid="reset-confirm" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Disabled="_busy" OnClick="SaveAsync" data-testid="primary-action">Change password</MudButton>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Token { get; set; }

    private string _password = string.Empty;
    private string _confirm = string.Empty;
    private string? _error;
    private bool _busy;
    private bool _done;

    private async Task OnKey(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") await SaveAsync();
    }

    private async Task SaveAsync()
    {
        _error = null;
        if (_password != _confirm)
        {
            _error = "The two passwords are not the same.";
            return;
        }

        _busy = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/v1/auth/reset-password", new ResetPasswordRequest(Email!, Token!, _password));
            if (!response.IsSuccessStatusCode)
            {
                var fields = await ProblemText.FieldErrorsAsync(response);
                _error = fields.Count > 0 ? string.Join(" ", fields.Values) : await ProblemText.FromAsync(response, "This link has expired or was already used. Ask for a new one.");
                return;
            }

            _done = true;
        }
        catch (HttpRequestException)
        {
            _error = "We could not reach MindLift. Check your connection and try again.";
        }
        finally
        {
            _busy = false;
        }
    }
}
