@page "/reports/builder"
@page "/reports/builder/{Id:guid}"
@using MindLift.Shared.Contracts
@using MindLift.Shared.Enums
@using MindLift.UI.Components
@using System.Net.Http.Json
@using System.Globalization
@inject HttpClient Http
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject Translator T

<PageTitle>@T[(Id.HasValue ? "Edit Report" : "Report Builder")] · MindLift</PageTitle>

<div class="ml-page">
    <div class="d-flex flex-wrap align-center justify-space-between gap-3 mb-4">
        <div class="d-flex align-center gap-3">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/reports" Size="Size.Small" />
            <div>
                <MudText Typo="Typo.h5" Style="font-weight:700">@(Id.HasValue ? $"Edit Report: {_name}" : "Report Builder")</MudText>
                <MudText Typo="Typo.body2" Class="ml-muted">@T["Configure custom data sources, grouping, formulas, and visual analytics."]</MudText>
            </div>
        </div>

        <div class="d-flex align-center gap-2">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.PlayArrow" OnClick="RunPreviewAsync" Disabled="_previewLoading" Size="Size.Small">
                @T["Run Preview"]
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Save" OnClick="SaveReportAsync" Disabled="_saving" Size="Size.Small">
                @T["Save Report"]
            </MudButton>
        </div>
    </div>

    @if (_loadingSources)
    {
        <SkeletonTable Rows="6" Columns="4" />
    }
    else
    {
        <MudGrid Spacing="3">
            <!-- Left Side: Configuration Tabs -->
            <MudItem xs="12" md="6">
                <MudTabs Elevation="0" Outlined="true" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4">
                    <!-- Tab 1: Source & Type -->
                    <MudTabPanel Text="1. Source" Icon="@Icons.Material.Outlined.Source">
                        <div class="ml-stack">
                            <MudSelect T="string" Value="_selectedSourceKey" ValueChanged="OnSourceChanged" Label="@T["Primary Data Source *"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var src in _sources)
                                {
                                    <MudSelectItem T="string" Value="@src.Key">@src.Label (@src.Key)</MudSelectItem>
                                }
                            </MudSelect>

                            <MudSelect T="ReportType" @bind-Value="_reportType" Label="@T["Report Structure"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                                <MudSelectItem Value="@ReportType.Tabular">@T["Tabular (Detailed row list)"]</MudSelectItem>
                                <MudSelectItem Value="@ReportType.Summary">@T["Summary (Grouped rows with totals)"]</MudSelectItem>
                                <MudSelectItem Value="@ReportType.Matrix">@T["Matrix (2-dimensional breakdown)"]</MudSelectItem>
                            </MudSelect>

                            <MudDivider Class="my-2" />

                            <MudText Typo="Typo.subtitle2" Style="font-weight:600">@T["Report Details"]</MudText>
                            <MudTextField @bind-Value="_name" Label="@T["Report Name *"]" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" Placeholder="@T["e.g. Q4 Regional Sales Performance"]" />
                            <MudTextField @bind-Value="_description" Label="@T["Description"]" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" Placeholder="@T["What question does this report answer?"]" />

                            <div class="d-flex gap-3">
                                <MudSelect T="Guid?" @bind-Value="_folderId" Label="@T["Folder"]" Variant="Variant.Outlined" Margin="Margin.Dense" Style="flex:1">
                                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">@T["General (No Folder)"]</MudSelectItem>
                                    @foreach (var f in _folders)
                                    {
                                        <MudSelectItem T="Guid?" Value="@f.Id">@f.Name</MudSelectItem>
                                    }
                                </MudSelect>

                                <MudSelect T="ReportVisibility" @bind-Value="_visibility" Label="@T["Visibility"]" Variant="Variant.Outlined" Margin="Margin.Dense" Style="flex:1">
                                    <MudSelectItem Value="@ReportVisibility.Private">@T["Private (Only Me)"]</MudSelectItem>
                                    <MudSelectItem Value="@ReportVisibility.Team">@T["Team (My Team)"]</MudSelectItem>
                                    <MudSelectItem Value="@ReportVisibility.Everyone">@T["Everyone (All Users)"]</MudSelectItem>
                                </MudSelect>
                            </div>
                        </div>
                    </MudTabPanel>

                    <!-- Tab 2: Columns & Metrics -->
                    <MudTabPanel Text="2. Columns" Icon="@Icons.Material.Outlined.ViewColumn">
                        <div class="ml-stack">
                            <MudText Typo="Typo.subtitle2" Style="font-weight:600">@T["Available Fields"]</MudText>
                            <div class="d-flex flex-wrap gap-1 pa-2 rounded-lg" style="max-height:160px; overflow-y:auto; border:1px solid var(--ml-border); background:rgba(0,0,0,0.02)">
                                @foreach (var fld in CurrentSourceFields)
                                {
                                    var isSelected = _selectedColumns.Contains(fld.Key);
                                    <MudChip T="string" Size="Size.Small" Variant="@(isSelected ? Variant.Filled : Variant.Outlined)" Color="@(isSelected ? Color.Primary : Color.Default)" OnClick="() => ToggleColumn(fld.Key)">
                                        @(isSelected ? "✓ " : "+ ")@fld.Label
                                    </MudChip>
                                }
                            </div>

                            <MudDivider Class="my-2" />

                            @if (_reportType != ReportType.Tabular)
                            {
                                <MudText Typo="Typo.subtitle2" Style="font-weight:600">@T["Grouping Fields"]</MudText>
                                <div class="d-flex gap-2">
                                    <MudSelect T="string" @bind-Value="_newGroupColumn" Label="@T["Add Grouping Field"]" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="flex:2">
                                        @foreach (var f in CurrentSourceFields.Where(x => x.Groupable))
                                        {
                                            <MudSelectItem T="string" Value="@f.Key">@f.Label</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="AddGroup" Disabled="@string.IsNullOrWhiteSpace(_newGroupColumn)">@T["Add"]</MudButton>
                                </div>

                                @if (_groups.Count > 0)
                                {
                                    <div class="d-flex flex-wrap gap-2 mt-1">
                                        @foreach (var g in _groups)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" OnClose="() => _groups.Remove(g)">
                                                @T["Group: {0}", GetFieldLabel(g.Field)]
                                            </MudChip>
                                        }
                                    </div>
                                }

                                <MudDivider Class="my-2" />

                                <MudText Typo="Typo.subtitle2" Style="font-weight:600">@T["Aggregates & Metrics"]</MudText>
                                <div class="d-flex gap-2 align-center">
                                    <MudSelect T="AggregateFunc" @bind-Value="_newAggFunc" Label="@T["Function"]" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="width:120px">
                                        <MudSelectItem Value="@AggregateFunc.Sum">@T["Sum"]</MudSelectItem>
                                        <MudSelectItem Value="@AggregateFunc.Count">@T["Count"]</MudSelectItem>
                                        <MudSelectItem Value="@AggregateFunc.Avg">@T["Avg"]</MudSelectItem>
                                        <MudSelectItem Value="@AggregateFunc.Min">@T["Min"]</MudSelectItem>
                                        <MudSelectItem Value="@AggregateFunc.Max">@T["Max"]</MudSelectItem>
                                    </MudSelect>
                                    <MudSelect T="string" @bind-Value="_newAggCol" Label="@T["Field"]" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="flex:2">
                                        @foreach (var f in CurrentSourceFields.Where(x => x.Aggregatable || _newAggFunc == AggregateFunc.Count))
                                        {
                                            <MudSelectItem T="string" Value="@f.Key">@f.Label</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="AddAggregate" Disabled="@string.IsNullOrWhiteSpace(_newAggCol)">@T["Add"]</MudButton>
                                </div>

                                @if (_aggregates.Count > 0)
                                {
                                    <div class="d-flex flex-wrap gap-2 mt-1">
                                        @foreach (var agg in _aggregates)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info" OnClose="() => _aggregates.Remove(agg)">
                                                @($"{agg.Func.ToString().ToUpperInvariant()}({GetFieldLabel(agg.Field)})")
                                            </MudChip>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </MudTabPanel>

                    <!-- Tab 3: Filters & Date Period -->
                    <MudTabPanel Text="3. Filters" Icon="@Icons.Material.Outlined.FilterAlt">
                        <div class="ml-stack">
                            <MudText Typo="Typo.subtitle2" Style="font-weight:600">@T["Date Range Filter"]</MudText>
                            <div class="d-flex gap-2">
                                <MudSelect T="string" @bind-Value="_datePeriodPreset" Label="@T["Time Horizon"]" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="flex:1">
                                    <MudSelectItem T="string" Value="@("all_time")">@T["All Time"]</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("today")">@T["Today"]</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("this_week")">@T["This Week"]</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("this_month")">@T["This Month"]</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("last_month")">@T["Last Month"]</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("this_quarter")">@T["This Quarter"]</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("this_year")">@T["This Year"]</MudSelectItem>
                                </MudSelect>

                                <MudSelect T="string" @bind-Value="_dateField" Label="@T["Date Column"]" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="flex:1">
                                    @foreach (var f in CurrentSourceFields.Where(x => x.Type == "Date"))
                                    {
                                        <MudSelectItem T="string" Value="@f.Key">@f.Label</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>
                        </div>
                    </MudTabPanel>

                    <!-- Tab 4: Visualization -->
                    <MudTabPanel Text="4. Chart" Icon="@Icons.Material.Outlined.BarChart">
                        <div class="ml-stack">
                            <MudSelect T="ReportChartType" @bind-Value="_chartType" Label="@T["Chart Type"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                                <MudSelectItem Value="@ReportChartType.Table">@T["Table Only (No Chart)"]</MudSelectItem>
                                <MudSelectItem Value="@ReportChartType.Bar">@T["Horizontal Bar"]</MudSelectItem>
                                <MudSelectItem Value="@ReportChartType.Column">@T["Vertical Column"]</MudSelectItem>
                                <MudSelectItem Value="@ReportChartType.Line">@T["Line Chart"]</MudSelectItem>
                                <MudSelectItem Value="@ReportChartType.Area">@T["Area Chart"]</MudSelectItem>
                                <MudSelectItem Value="@ReportChartType.Donut">@T["Donut / Pie"]</MudSelectItem>
                                <MudSelectItem Value="@ReportChartType.Funnel">@T["Conversion Funnel"]</MudSelectItem>
                            </MudSelect>

                            @if (_chartType != ReportChartType.Table && _chartType != ReportChartType.None)
                            {
                                <div class="d-flex gap-2">
                                    <MudSelect T="string" @bind-Value="_chartXAxis" Label="@T["Category / X-Axis"]" Variant="Variant.Outlined" Margin="Margin.Dense" Style="flex:1">
                                        @foreach (var col in _selectedColumns)
                                        {
                                            <MudSelectItem T="string" Value="@col">@GetFieldLabel(col)</MudSelectItem>
                                        }
                                    </MudSelect>

                                    <MudSelect T="string" @bind-Value="_chartValueCol" Label="@T["Metric / Value Column"]" Variant="Variant.Outlined" Margin="Margin.Dense" Style="flex:1">
                                        @foreach (var col in _selectedColumns)
                                        {
                                            <MudSelectItem T="string" Value="@col">@GetFieldLabel(col)</MudSelectItem>
                                        }
                                    </MudSelect>
                                </div>
                            }
                        </div>
                    </MudTabPanel>
                </MudTabs>
            </MudItem>

            <!-- Right Side: Live Interactive Preview -->
            <MudItem xs="12" md="6">
                <MlCard Title="Interactive Query Preview" Subtitle="@(_previewResult != null ? $"{_previewResult.RowCount} rows in {_previewResult.ExecutionMs}ms" : "Configure and run preview to see live results")">
                    @if (_previewLoading)
                    {
                        <div class="d-flex flex-column align-center justify-center pa-8">
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mb-3" />
                            <MudText Typo="Typo.body2" Class="ml-muted">@T["Executing query against tenant schema..."]</MudText>
                        </div>
                    }
                    else if (_previewError != null)
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_previewError</MudAlert>
                    }
                    else if (_previewResult != null)
                    {
                        <div style="overflow-x:auto; max-height:480px">
                            <table class="mud-table-root" style="width:100%; border-collapse:collapse; font-size:0.825rem">
                                <thead style="background:rgba(0,0,0,0.04); position:sticky; top:0; z-index:1">
                                    <tr>
                                        @foreach (var col in _previewResult.Columns)
                                        {
                                            <th style="padding:8px 10px; text-align:@(col.Type == "Decimal" || col.Type == "Integer" ? "right" : "left"); font-weight:600; white-space:nowrap" class="ml-muted">
                                                @col.Label
                                            </th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in _previewResult.Rows.Take(25))
                                    {
                                        <tr style="border-bottom:1px solid var(--ml-border)">
                                            @foreach (var col in _previewResult.Columns)
                                            {
                                                row.TryGetValue(col.Key, out var val);
                                                <td style="padding:6px 10px; text-align:@(col.Type == "Decimal" || col.Type == "Integer" ? "right" : "left"); white-space:nowrap">
                                                    @(val?.ToString() ?? "—")
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <EmptyState Title="No Preview Loaded" Subtitle="@T["Click 'Run Preview' above to execute your current report configuration."]" />
                    }
                </MlCard>
            </MudItem>
        </MudGrid>
    }
</div>

@code {
    [Parameter] public Guid? Id { get; set; }

    private List<ReportDataSourceDto> _sources = [];
    private List<ReportFolderDto> _folders = [];
    private bool _loadingSources = true;
    private bool _saving = false;

    // Report configuration state
    private string _name = "";
    private string? _description;
    private Guid? _folderId;
    private ReportVisibility _visibility = ReportVisibility.Everyone;
    private ReportType _reportType = ReportType.Tabular;
    private string _selectedSourceKey = "leads";
    private List<string> _selectedColumns = [];
    private List<ReportGroup> _groups = [];
    private List<ReportAggregate> _aggregates = [];

    // Date filter state
    private string _datePeriodPreset = "this_month";
    private string _dateField = "created_at";

    // Group / Agg builder state
    private string _newGroupColumn = "";
    private AggregateFunc _newAggFunc = AggregateFunc.Sum;
    private string _newAggCol = "";

    // Visualization state
    private ReportChartType _chartType = ReportChartType.Table;
    private string? _chartXAxis;
    private string? _chartValueCol;

    // Preview state
    private bool _previewLoading = false;
    private ReportResult? _previewResult;
    private string? _previewError;

    private IReadOnlyList<ReportFieldDto> CurrentSourceFields =>
        _sources.FirstOrDefault(s => s.Key == _selectedSourceKey)?.Fields ?? [];

    protected override async Task OnInitializedAsync()
    {
        _loadingSources = true;
        try
        {
            _sources = await Http.GetFromJsonAsync<List<ReportDataSourceDto>>("api/v1/reports/sources") ?? [];
            _folders = await Http.GetFromJsonAsync<List<ReportFolderDto>>("api/v1/report-folders") ?? [];

            if (Id.HasValue)
            {
                var existing = await Http.GetFromJsonAsync<ReportDefinitionDto>($"api/v1/reports/{Id.Value}");
                if (existing != null)
                {
                    _name = existing.Name;
                    _description = existing.Description;
                    _folderId = existing.FolderId;
                    _visibility = existing.Visibility;
                    _selectedSourceKey = existing.Source;

                    if (existing.Query != null)
                    {
                        _reportType = existing.Query.Type;
                        _selectedColumns = existing.Query.Columns.ToList();
                        _groups = existing.Query.GroupBy.ToList();
                        _aggregates = existing.Query.Aggregates.ToList();

                        if (existing.Query.DateFilter != null)
                        {
                            _datePeriodPreset = existing.Query.DateFilter.Preset ?? "this_month";
                            _dateField = existing.Query.DateFilter.Field ?? "created_at";
                        }

                        if (existing.Query.Visualization != null)
                        {
                            _chartType = existing.Query.Visualization.ChartType;
                            _chartXAxis = existing.Query.Visualization.XAxisField;
                            _chartValueCol = existing.Query.Visualization.SeriesFields.FirstOrDefault();
                        }
                    }
                }
            }
            else
            {
                // Defaults for new report
                _name = "New Custom Report";
                ResetDefaultColumns();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Initialization error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingSources = false;
        }
    }

    private void OnSourceChanged(string sourceKey)
    {
        _selectedSourceKey = sourceKey;
        ResetDefaultColumns();
    }

    private void ResetDefaultColumns()
    {
        var src = _sources.FirstOrDefault(s => s.Key == _selectedSourceKey);
        var fields = src?.Fields ?? [];
        _selectedColumns = fields.Take(5).Select(f => f.Key).ToList();
        _groups.Clear();
        _aggregates.Clear();
        _dateField = !string.IsNullOrEmpty(src?.DefaultDateField) ? src.DefaultDateField : "created_at";
    }

    private void ToggleColumn(string colKey)
    {
        if (_selectedColumns.Contains(colKey))
        {
            _selectedColumns.Remove(colKey);
        }
        else
        {
            _selectedColumns.Add(colKey);
        }
    }

    private void AddGroup()
    {
        if (!string.IsNullOrWhiteSpace(_newGroupColumn) && !_groups.Any(g => g.Field == _newGroupColumn))
        {
            _groups.Add(new ReportGroup(_newGroupColumn));
            _newGroupColumn = "";
        }
    }

    private void AddAggregate()
    {
        if (!string.IsNullOrWhiteSpace(_newAggCol))
        {
            _aggregates.Add(new ReportAggregate(_newAggCol, _newAggFunc, $"{_newAggFunc.ToString().ToLowerInvariant()}_{_newAggCol}"));
            _newAggCol = "";
        }
    }

    private string GetFieldLabel(string key) =>
        CurrentSourceFields.FirstOrDefault(f => f.Key == key)?.Label ?? key;

    private ReportQuery BuildQuery()
    {
        var q = new ReportQuery
        {
            Source = _selectedSourceKey,
            Type = _reportType,
            Columns = _selectedColumns,
            GroupBy = _groups,
            Aggregates = _aggregates,
            Limit = 100
        };

        if (_datePeriodPreset != "all_time")
        {
            q.DateFilter = new ReportDateFilter(_dateField, _datePeriodPreset);
        }

        if (_chartType != ReportChartType.Table && _chartType != ReportChartType.None)
        {
            q.Visualization = new ReportVisualization
            {
                ChartType = _chartType,
                XAxisField = _chartXAxis,
                SeriesFields = string.IsNullOrWhiteSpace(_chartValueCol) ? [] : [_chartValueCol]
            };
        }

        return q;
    }

    private async Task RunPreviewAsync()
    {
        _previewLoading = true;
        _previewError = null;
        try
        {
            var q = BuildQuery();
            var resp = await Http.PostAsJsonAsync("api/v1/reports/run", q);
            if (resp.IsSuccessStatusCode)
            {
                _previewResult = await resp.Content.ReadFromJsonAsync<ReportResult>();
            }
            else
            {
                _previewError = T["Preview failed: Unable to execute report query."];
            }
        }
        catch (Exception ex)
        {
            _previewError = $"Preview error: {ex.Message}";
        }
        finally
        {
            _previewLoading = false;
        }
    }

    private async Task SaveReportAsync()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            Snackbar.Add(T["Report name is required."], Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var req = new SaveReportDefinitionRequest
            {
                Name = _name.Trim(),
                Description = _description?.Trim(),
                FolderId = _folderId,
                Visibility = _visibility,
                Query = BuildQuery()
            };

            HttpResponseMessage resp;
            if (Id.HasValue)
            {
                resp = await Http.PutAsJsonAsync($"api/v1/reports/{Id.Value}", req);
            }
            else
            {
                resp = await Http.PostAsJsonAsync("api/v1/reports", req);
            }

            if (resp.IsSuccessStatusCode)
            {
                var saved = await resp.Content.ReadFromJsonAsync<ReportDefinitionDto>();
                Snackbar.Add(T["Report saved successfully!"], Severity.Success);
                if (saved != null)
                {
                    Nav.NavigateTo($"/reports/view/{saved.Id}");
                }
                else
                {
                    Nav.NavigateTo("/reports");
                }
            }
            else
            {
                Snackbar.Add(T["Failed to save report."], Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Save error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
