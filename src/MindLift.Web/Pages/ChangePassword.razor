@page "/change-password"
@layout AuthLayout
@inject HttpClient Http
@inject AuthSession Session
@inject AppState App
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject Translator T

<PageTitle>@T["Reset temporary password"] · MindLift</PageTitle>

<div class="ml-wizard" style="max-width:440px;margin-top:48px">
    <div class="ml-stack">
        <MudText Typo="Typo.h4" data-testid="page-title">@T["Reset password"]</MudText>
        <MudText Typo="Typo.body2" Class="ml-muted">
            @T["Welcome to MindLift! Because you signed in with a temporary password, you must create a new personal password before you can proceed."]
        </MudText>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" data-testid="change-password-error">@_error</MudAlert>
        }

        <PasswordInput @bind-Value="_newPassword" Label="@T["New password *"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                       Required="true"
                       HelperText="@T["At least 8 characters, with uppercase, lowercase letters and a digit."]"
                       data-testid="new-password" />

        <PasswordInput @bind-Value="_confirmPassword" Label="@T["Confirm new password *"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                       Required="true" OnKeyDown="OnKey"
                       data-testid="confirm-password" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                   Disabled="_busy" OnClick="SaveNewPasswordAsync" data-testid="primary-action">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <text>@T["Set new password and continue"]</text>
            }
        </MudButton>

        <div style="text-align:center;margin-top:8px">
            <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small" OnClick="SignOutAsync">
                @T["Sign out and return later"]
            </MudButton>
        </div>
    </div>
</div>

@code {
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _error;
    private bool _busy;

    protected override void OnInitialized()
    {
        if (!Session.IsSignedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (App.Bootstrap is not null && !App.Bootstrap.User.MustChangePassword)
        {
            Nav.NavigateTo("/");
        }
    }

    private async Task OnKey(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") await SaveNewPasswordAsync();
    }

    private async Task SaveNewPasswordAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_newPassword) || string.IsNullOrWhiteSpace(_confirmPassword))
        {
            _error = T["Please fill in both password fields."];
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            _error = T["The two passwords do not match."];
            return;
        }

        if (_newPassword.Length < 8)
        {
            _error = T["Password must be at least 8 characters long."];
            return;
        }

        _busy = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/v1/auth/first-login-change-password",
                new FirstLoginChangePasswordRequest(_newPassword));

            if (!response.IsSuccessStatusCode)
            {
                var fields = await ProblemText.FieldErrorsAsync(response);
                _error = fields.Count > 0 ? string.Join(" ", fields.Values) : await ProblemText.FromAsync(response, T["Could not update your password."]);
                return;
            }

            var tokenResp = await response.Content.ReadFromJsonAsync<TokenResponse>();
            if (tokenResp is not null)
            {
                Session.SetTokens(tokenResp);
            }

            await App.LoadAsync();
            Snackbar.Add(T["Your password has been set. Welcome to MindLift!"], Severity.Success);
            Nav.NavigateTo("/");
        }
        catch (HttpRequestException)
        {
            _error = T["We could not reach MindLift. Check your connection and try again."];
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SignOutAsync()
    {
        await Http.PostAsync("api/v1/auth/logout", null);
        Session.Clear();
        App.Reset();
        Nav.NavigateTo("/login", forceLoad: true);
    }
}
