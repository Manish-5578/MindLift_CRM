@page "/activities"
@inject HttpClient Http
@inject AuthSession Session
@inject AppState App
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>@App.ModuleLabel(AppModule.Activities) · MindLift</PageTitle>

<div class="ml-page ml-page--narrow">
    <PageHeader Title="@App.ModuleLabel(AppModule.Activities)" Subtitle="Your tasks, calls and meetings.">
        <Actions>
            @if (CanCreate)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="OpenNew" data-testid="primary-action">New task</MudButton>
            }
        </Actions>
    </PageHeader>

    <div class="ml-row ml-row--wrap" style="margin-bottom:16px" data-testid="activity-tabs">
        @foreach (var (key, label) in Tabs)
        {
            var current = key;
            <MudChip T="string" Variant="@(_tab == current ? Variant.Filled : Variant.Outlined)" Color="@(_tab == current ? Color.Primary : Color.Default)"
                     OnClick="() => SetTabAsync(current)" data-testid="@("tab-" + current)">@label@(Count(current) is { } n ? $" ({n})" : "")</MudChip>
        }
        <MudSelect T="string" Value="_type" ValueChanged="SetTypeAsync" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Placeholder="All types" Style="max-width:160px" aria-label="Type" data-testid="type-filter">
            @foreach (var type in new[] { "Task", "Call", "Meeting", "Note" })
            {
                <MudSelectItem T="string" Value="@type">@type</MudSelectItem>
            }
        </MudSelect>
    </div>

    @if (_error is not null)
    {
        <ErrorState Message="@_error" OnRetry="LoadAsync" />
    }
    else if (_loading)
    {
        <SkeletonTable Rows="5" Columns="3" />
    }
    else if (_items.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.TaskAlt" Title="@EmptyTitle" Message="Tasks you add, and tasks assigned to you, show up here." />
    }
    else
    {
        <MlCard>
            @foreach (var item in _items)
            {
                var current = item;
                <div class="ml-row" style="padding:10px 0;border-bottom:1px solid var(--ml-border);align-items:flex-start" data-testid="activity-row">
                    @if (current.Type != "Note" && CanEdit)
                    {
                        <MudCheckBox T="bool" Value="@(current.Status == "Completed")" ValueChanged="v => ToggleAsync(current, v)" Color="Color.Primary" aria-label="@("Complete " + current.Subject)" data-testid="activity-check" />
                    }

                    <div class="ml-grow" style="min-width:0;overflow-wrap:anywhere">
                        <MudText Typo="Typo.subtitle2" Style="@(current.Status == "Completed" ? "text-decoration:line-through" : null)">@current.Subject</MudText>
                        <MudText Typo="Typo.caption" Class="ml-muted">
                            @current.Type
                            @if (current.DueAtUtc is not null) { <text> · </text><DateText Value="@current.DueAtUtc" Danger="@current.IsOverdue" /> }
                            @if (current.LinkedName is not null) { <text> · </text><a href="@LinkHref(current)" class="ml-link">@current.LinkedName</a> }
                        </MudText>
                    </div>
                    @if (CanEdit)
                    {
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="() => Edit(current)" aria-label="Edit" />
                    }
                </div>
            }
        </MlCard>
    }
</div>

<ActivityFormDrawer @ref="_form" @bind-Open="_drawer" OnSaved="OnSaved" />

@code {
    private static readonly (string Key, string Label)[] Tabs = [("today", "Today"), ("overdue", "Overdue"), ("upcoming", "Upcoming"), ("completed", "Completed")];

    private ActivityFormDrawer? _form;
    private bool _drawer;
    private bool _loading = true;
    private string? _error;
    private string _tab = "today";
    private string? _type;
    private IReadOnlyList<ActivityDto> _items = [];
    private MyDayDto? _day;

    private bool Can(Func<ModulePermissionDto, bool> check) => App.Bootstrap?.Permissions.Any(p => p.Module == "Activities" && check(p)) == true;
    private bool CanCreate => Can(p => p.CanCreate);
    private bool CanEdit => Can(p => p.CanEdit);

    private string EmptyTitle => _tab switch { "today" => "Nothing due today", "overdue" => "Nothing overdue", "upcoming" => "Nothing coming up", _ => "Nothing completed yet" };

    private int? Count(string key) => key switch { "today" => _day?.Today, "overdue" => _day?.Overdue, "upcoming" => _day?.Upcoming, _ => null };

    private static string LinkHref(ActivityDto activity) => activity.LinkedKind switch
    {
        "deal" => "/deals/" + activity.DealId,
        "contact" => "/contacts/" + activity.ContactId,
        "account" => "/accounts/" + activity.AccountId,
        _ => "/leads/" + activity.LeadId,
    };

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsSignedIn)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        await LoadAsync();
    }

    private async Task SetTabAsync(string tab)
    {
        _tab = tab;
        await LoadAsync();
    }

    private async Task SetTypeAsync(string? type)
    {
        _type = string.IsNullOrEmpty(type) ? null : type;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var response = await Http.PostAsJsonAsync("api/v1/activities/query", new ActivityQuery(_tab, _type, null, true, null, null, null, null, 1, 100));
            if (!response.IsSuccessStatusCode)
            {
                _error = await ProblemText.FromAsync(response, "We could not load your activities. Try again.");
                return;
            }

            _items = (await response.Content.ReadFromJsonAsync<PagedResult<ActivityDto>>())?.Items ?? [];
            _day = await Http.GetFromJsonAsync<MyDayDto>("api/v1/activities/my-day");
        }
        catch (HttpRequestException)
        {
            _error = "We could not reach MindLift. Check your connection and try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenNew()
    {
        _form?.OpenNew();
        _drawer = true;
    }

    private void Edit(ActivityDto item)
    {
        _form?.OpenEdit(item);
        _drawer = true;
    }

    private async Task OnSaved()
    {
        Snackbar.Add("Activity saved", Severity.Success);
        await LoadAsync();
    }

    private async Task ToggleAsync(ActivityDto item, bool done)
    {
        var response = done
            ? await Http.PostAsJsonAsync($"api/v1/activities/{item.Id}/complete", new CompleteActivityRequest(null, null, null))
            : await Http.PostAsync($"api/v1/activities/{item.Id}/reopen", null);
        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add(await ProblemText.FromAsync(response, "We could not update this activity."), Severity.Error);
        }

        await LoadAsync();
    }
}
