@page "/custom-objects/{Slug}"
@using MindLift.Shared.Contracts
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject NavigationManager Nav
@inject Translator T

<PageTitle>@(_definition?.PluralName ?? "Custom Object Records") · MindLift</PageTitle>

<div class="ml-page ml-page--records" data-testid="custom-object-records-page">
    @if (_loadingDef)
    {
        <SkeletonTable Rows="6" Columns="5" />
    }
    else if (_definition is null)
    {
        <MlCard Class="pa-8 text-center">
            <EmptyState Title="@T["Custom Object Not Found"]"
                        Message="@T["No custom object found matching slug '{0}'.", Slug]"
                        Compact="true" />
            <div class="mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/settings/custom-objects">
                    @T["View All Custom Objects"]
                </MudButton>
            </div>
        </MlCard>
    }
    else
    {
        <PageHeader Title="@_definition.PluralName"
                    Subtitle="@(!string.IsNullOrWhiteSpace(_definition.Description) ? _definition.Description : T["Manage records for {0}.", _definition.Name])">
            <Actions>
                <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.ArrowBack"
                           Href="/custom-objects" Class="mr-2">
                    @T["All Custom Objects"]
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Settings"
                           Href="/settings/custom-objects" Class="mr-2">
                    @T["Schema Settings"]
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@(() => OpenRecordDialog(null))" data-testid="new-record-btn">
                    @T["New {0}", _definition.Name]
                </MudButton>
            </Actions>
        </PageHeader>

        <!-- Search Bar and Counts -->
        <MudPaper Elevation="0" Outlined="true" Class="pa-2 mb-4">
            <div class="ml-row" style="align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
                <div style="max-width:360px;flex:1;">
                    <MudTextField @bind-Value="_searchQuery" Placeholder="@T["Search {0}...", _definition.PluralName]"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Clearable="true"
                                  TextChanged="OnSearchChanged" />
                </div>
                <div>
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
                        @T["{0} Total Records", _totalCount]
                    </MudChip>
                </div>
            </div>
        </MudPaper>

        <!-- Records Table -->
        @if (_loadingRecords)
        {
            <SkeletonTable Rows="5" Columns="5" />
        }
        else if (_records.Count == 0)
        {
            <MlCard Class="pa-8 text-center">
                <EmptyState Title="@(string.IsNullOrWhiteSpace(_searchQuery) ? T["No {0} recorded yet", _definition.PluralName] : T["No matching {0}", _definition.PluralName])"
                            Message="@(string.IsNullOrWhiteSpace(_searchQuery) ? T["Create your first {0} record to start tracking dynamic data.", _definition.Name] : T["Try modifying your search query."])"
                            Compact="true" />
                @if (string.IsNullOrWhiteSpace(_searchQuery))
                {
                    <div class="mt-4">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="@(() => OpenRecordDialog(null))">
                            @T["Create {0}", _definition.Name]
                        </MudButton>
                    </div>
                }
            </MlCard>
        }
        else
        {
            <MudTable Items="_records" Dense="true" Hover="true" Elevation="1" Class="mb-4">
                <HeaderContent>
                    <MudTh Style="width:80px;">@T["#"]</MudTh>
                    <MudTh>@GetTitleFieldLabel()</MudTh>
                    @foreach (var field in GetPreviewFields())
                    {
                        <MudTh>@field.Label</MudTh>
                    }
                    <MudTh>@T["Created"]</MudTh>
                    <MudTh Style="width:90px;text-align:right;">@T["Actions"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="#">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                            #@context.RecordNumber
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Title">
                        <MudLink Color="Color.Primary" Underline="Underline.Hover" Style="font-weight:600;cursor:pointer;"
                                 OnClick="@(() => OpenRecordDialog(context))">
                            @(string.IsNullOrWhiteSpace(context.DisplayName) ? $"Record #{context.RecordNumber}" : context.DisplayName)
                        </MudLink>
                    </MudTd>
                    @foreach (var field in GetPreviewFields())
                    {
                        <MudTd DataLabel="@field.Label">
                            @FormatFieldValue(context, field)
                        </MudTd>
                    }
                    <MudTd DataLabel="Created">
                        <span class="text-caption ml-muted">@context.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</span>
                    </MudTd>
                    <MudTd Style="text-align:right;">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default"
                                       OnClick="@(() => OpenRecordDialog(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => DeleteRecordAsync(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>

            <!-- Pagination Bar -->
            @if (_totalCount > _pageSize)
            {
                <div class="ml-row" style="justify-content:center;margin-top:16px;">
                    <MudPagination Count="@((int)Math.Ceiling((double)_totalCount / _pageSize))" Selected="@_page"
                                   SelectedChanged="OnPageChanged" Color="Color.Primary" />
                </div>
            }
        }
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";

    private CustomObjectDefinitionDto? _definition;
    private List<CustomObjectRecordDto> _records = [];
    private bool _loadingDef = true;
    private bool _loadingRecords;
    private string _searchQuery = "";
    private int _page = 1;
    private int _pageSize = 20;
    private int _totalCount;

    protected override async Task OnParametersSetAsync()
    {
        await LoadDefinitionAsync();
    }

    private async Task LoadDefinitionAsync()
    {
        _loadingDef = true;
        try
        {
            _definition = await Http.GetFromJsonAsync<CustomObjectDefinitionDto>($"api/v1/custom-objects/definitions/by-slug/{Slug}");
            if (_definition is not null)
            {
                await LoadRecordsAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _definition = null;
        }
        finally
        {
            _loadingDef = false;
        }
    }

    private async Task LoadRecordsAsync()
    {
        if (_definition is null) return;
        _loadingRecords = true;
        try
        {
            var searchParam = string.IsNullOrWhiteSpace(_searchQuery) ? "" : $"&search={Uri.EscapeDataString(_searchQuery)}";
            var res = await Http.GetFromJsonAsync<CustomObjectRecordPagedResult>(
                $"api/v1/custom-objects/{_definition.Slug}/records?page={_page}&pageSize={_pageSize}{searchParam}");

            if (res is not null)
            {
                _records = res.Items.ToList();
                _totalCount = res.TotalCount;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loadingRecords = false;
        }
    }

    private async Task OnSearchChanged(string query)
    {
        _searchQuery = query;
        _page = 1;
        await LoadRecordsAsync();
    }

    private async Task OnPageChanged(int newPage)
    {
        _page = newPage;
        await LoadRecordsAsync();
    }

    private string GetTitleFieldLabel()
    {
        if (_definition is null) return T["Title"];
        var field = _definition.Fields.FirstOrDefault(f => f.Key == _definition.TitleField);
        return field?.Label ?? _definition.TitleField;
    }

    private IEnumerable<CustomObjectFieldDto> GetPreviewFields()
    {
        if (_definition is null) return [];
        // Preview other fields except the title field, up to 4
        return _definition.Fields.Where(f => f.Key != _definition.TitleField).Take(4);
    }

    private MarkupString FormatFieldValue(CustomObjectRecordDto record, CustomObjectFieldDto field)
    {
        if (record.Data is null || !record.Data.TryGetValue(field.Key, out var raw) || raw is null)
        {
            return new MarkupString("<span class='ml-muted'>-</span>");
        }

        var str = raw is System.Text.Json.JsonElement je ? je.ToString() : raw.ToString();
        if (string.IsNullOrWhiteSpace(str))
        {
            return new MarkupString("<span class='ml-muted'>-</span>");
        }

        if (field.Type.Equals("picklist", StringComparison.OrdinalIgnoreCase))
        {
            return new MarkupString($"<span class='mud-chip mud-chip-filled mud-chip-size-small mud-chip-color-default'>{System.Net.WebUtility.HtmlEncode(str)}</span>");
        }

        if (field.Type.Equals("boolean", StringComparison.OrdinalIgnoreCase))
        {
            var isTrue = str.Equals("true", StringComparison.OrdinalIgnoreCase);
            return isTrue
                ? new MarkupString("<span style='color:var(--mud-palette-success);font-weight:600;'>✓ Yes</span>")
                : new MarkupString("<span class='ml-muted'>No</span>");
        }

        if (field.Type.Equals("number", StringComparison.OrdinalIgnoreCase) && double.TryParse(str, out var num))
        {
            return new MarkupString($"<span>{num:N0}</span>");
        }

        return new MarkupString(System.Net.WebUtility.HtmlEncode(str));
    }

    private async Task OpenRecordDialog(CustomObjectRecordDto? record)
    {
        if (_definition is null) return;

        var parameters = new DialogParameters<CustomObjectRecordDialog>
        {
            { x => x.Definition, _definition },
            { x => x.Record, record }
        };

        var title = record is null ? T["New {0}", _definition.Name] : T["Edit {0}", _definition.Name];
        var dialog = await Dialogs.ShowAsync<CustomObjectRecordDialog>(title, parameters);
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            await LoadRecordsAsync();
        }
    }

    private async Task DeleteRecordAsync(CustomObjectRecordDto record)
    {
        if (_definition is null) return;

        var confirmed = await Dialogs.ConfirmAsync(
            T["Delete Record?"],
            T["Are you sure you want to delete record #{0} ({1})?", record.RecordNumber, record.DisplayName],
            T["Delete"],
            danger: true
        );

        if (!confirmed) return;

        try
        {
            var res = await Http.DeleteAsync($"api/v1/custom-objects/{_definition.Slug}/records/{record.Id}");
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add(T["Record deleted."], Severity.Success);
                await LoadRecordsAsync();
            }
            else
            {
                Snackbar.Add(await ProblemText.FromAsync(res, T["Failed to delete record."]), Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
