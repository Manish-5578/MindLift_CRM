@page "/leads"
@using MindLift.Shared.Filtering
@using FilterOperator = MindLift.Shared.Filtering.FilterOperator
@inject HttpClient Http
@inject AuthSession Session
@inject AppState App
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject Translator T
@inject IDialogService Dialogs

<PageTitle>@T[App.ModuleLabel(AppModule.Leads)] · MindLift</PageTitle>

<div class="ml-page ml-page--narrow">
    @if (App.Bootstrap is not null)
    {
        <EntityListPage @ref="_list" TItem="LeadListItemDto" Title="@App.ModuleLabel(AppModule.Leads)" ItemLabel="@ItemLabel"
                        Views="_views" DefaultView="@AllView" Columns="_columns" CardTemplate="_card" Loader="LoadAsync" RowHref="LeadHref"
                        Fields="LeadFields" Picklists="App.Bootstrap.Picklists" Users="_users"
                        ItemId="r => r.Id" SavedViews="_savedViews" OnSaveView="SaveViewAsync" OnDeleteView="DeleteViewAsync" ColumnStorageKey="leads"
                        SearchPlaceholder="Search name, email, company or phone" EmptyIcon="@Icons.Material.Outlined.PersonSearch"
                        EmptyTitle="No leads yet" EmptyMessage="Leads from web forms, WhatsApp, email or imports appear here."
                        DefaultSortField="created_at" DefaultSortDir="desc">
            <HeaderActions>
                <MudButtonGroup Variant="Variant.Outlined" Size="Size.Medium" data-testid="layout-toggle">
                    <MudButton Href="/leads/board">@T["Board"]</MudButton>
                    <MudButton Color="Color.Primary" Href="/leads">@T["List"]</MudButton>
                </MudButtonGroup>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Custom.FileFormats.FileExcel" OnClick="DownloadTemplateAsync" data-testid="download-template">@T["Template"]</MudButton>
                @if (CanImport)
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Upload" Href="/leads/import" data-testid="import-leads">@T["Import"]</MudButton>
                }
                @if (CanExport)
                {
                    <MudMenu Label="@T["Export"]" StartIcon="@Icons.Material.Outlined.Download" Variant="Variant.Outlined" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" data-testid="export-leads">
                        <MudMenuItem Icon="@Icons.Custom.FileFormats.FileExcel" OnClick='() => ExportAsync("xlsx")'>@T["Export as Excel (.xlsx)"]</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Outlined.TableChart" OnClick='() => ExportAsync("csv")'>@T["Export as CSV (.csv)"]</MudMenuItem>
                    </MudMenu>
                }
                @if (CanCreate)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="OpenNewLead" data-testid="primary-action">@T["New lead"]</MudButton>
                }
                <MudTooltip Text="@T["Upload history"]">
                    <MudIconButton Icon="@Icons.Material.Outlined.History" OnClick="OpenHistoryDialog" data-testid="leads-upload-history" Title="@T["Upload history"]" />
                </MudTooltip>
            </HeaderActions>
            <EmptyActions>
                @if (CanCreate)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenNewLead">@T["New lead"]</MudButton>
                }
            </EmptyActions>
            <BulkActions Context="selection">
                <div class="d-flex align-center gap-2 flex-wrap">
                    <ListBulkBar Selection="selection" Entity="leads" ItemLabel="@ItemLabel" Users="_users" Statuses="BulkStatuses" AllowTags="true" CanEdit="CanEditRecords" CanDelete="CanDeleteRecords" CanExport="CanExportRecords" />
                    @if (CanEditRecords)
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.DriveFileMove" OnClick="() => OpenBulkMoveToViewDialog(selection)" data-testid="bulk-change-view">@T["Change view"]</MudButton>
                    }
                </div>
            </BulkActions>
            <RowMenu Context="row">
                <MudMenuItem Href="@("/leads/" + row.Id)" Icon="@Icons.Material.Outlined.OpenInNew" data-testid="row-open">@T["Open"]</MudMenuItem>
                <MudMenuItem OnClick="() => AddToContactAsync(row)" Icon="@Icons.Material.Outlined.PersonAdd" data-testid="row-add-contact">@T["Add to contact"]</MudMenuItem>
                <MudMenuItem OnClick="() => MoveToEngagementAsync(row)" Icon="@Icons.Material.Outlined.Handshake" data-testid="row-move-engagement">@T["Move to engagement"]</MudMenuItem>
                <MudMenuItem OnClick="() => OpenStickyNoteAsync(row)" Icon="@Icons.Material.Outlined.EditNote" data-testid="row-notes">@T["Notes"]</MudMenuItem>
                @if (CanEditRecords)
                {
                    <MudMenuItem OnClick="() => EditRowAsync(row.Id)" Icon="@Icons.Material.Outlined.Edit" data-testid="row-edit">@T["Edit"]</MudMenuItem>
                    <MudMenuItem OnClick="() => OpenChangeStatusDialog(row)" Icon="@Icons.Material.Outlined.CheckCircleOutline" data-testid="row-change-status">@T["Change status"]</MudMenuItem>
                    <MudMenuItem OnClick="() => OpenMoveToViewDialog(row)" Icon="@Icons.Material.Outlined.DriveFileMove" data-testid="row-move-view">@T["Change view"]</MudMenuItem>
                }
                @if (CanDeleteRecords)
                {
                    <MudMenuItem OnClick="() => DeleteRowAsync(row.Id, row.FullName)" Icon="@Icons.Material.Outlined.DeleteOutline" data-testid="row-delete">@T["Delete"]</MudMenuItem>
                }
            </RowMenu>
        </EntityListPage>
    }
</div>

<LeadFormDrawer @ref="_form" @bind-Open="_drawer" OnSaved="OnSaved" />

<MudDialog @bind-Visible="_moveDialogOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }" data-testid="move-view-dialog">
    <TitleContent>
        <MudText Typo="Typo.h6">@T["Change view"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="ml-muted mb-3">
            @if (_movingLead is not null)
            {
                @T["Move {0} to another view:", LeadTitle(_movingLead)]
            }
            else if (_bulkMovingSelection is not null)
            {
                @T["Move {0} selected lead(s) to another view:", _bulkMovingSelection.Count]
            }
        </MudText>
        <MudSelect T="string" Label="@T["Target view"]" @bind-Value="_targetViewKey" Variant="Variant.Outlined" Dense="true" data-testid="select-target-view">
            @foreach (var v in AvailableViewsForMove)
            {
                <MudSelectItem Value="@v.Key">@(v.SavedId is null ? T[v.Label] : v.Label)</MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _moveDialogOpen = false">@T["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(string.IsNullOrEmpty(_targetViewKey) || _targetViewKey == CurrentViewKey)" OnClick="ConfirmMoveLeadAsync" data-testid="confirm-move-view">@T["Move"]</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_statusDialogOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }" data-testid="change-status-dialog">
    <TitleContent>
        <MudText Typo="Typo.h6">@T["Change status"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="ml-muted mb-3">
            @T["Change status for {0}:", _statusLead is not null ? LeadTitle(_statusLead) : ""]
        </MudText>
        <MudSelect T="string" Label="@T["Status"]" @bind-Value="_targetStatusKey" Variant="Variant.Outlined" Dense="true" data-testid="select-target-status">
            @foreach (var s in SettableStatuses)
            {
                <MudSelectItem Value="@s.Value">@T.Pick(s.Label, s.LabelAr)</MudSelectItem>
            }
        </MudSelect>
        @if (_targetStatusKey == "disqualified")
        {
            <MudTextField @bind-Value="_disqualifyReason" Label="@T["Reason *"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" data-testid="status-disqualify-reason" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _statusDialogOpen = false">@T["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(string.IsNullOrEmpty(_targetStatusKey) || _targetStatusKey == _statusLead?.Status || (_targetStatusKey == "disqualified" && string.IsNullOrWhiteSpace(_disqualifyReason)))" OnClick="ConfirmChangeStatusAsync" data-testid="confirm-change-status">@T["Update"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const string MineView = "mine";
    private const string AllView = "all";
    private const string NewView = "new";

    private EntityListPage<LeadListItemDto>? _list;
    private LeadFormDrawer? _form;
    private bool _drawer;
    private List<UserListItem> _users = [];

    private IReadOnlyList<ListView> _views = [];
    private IReadOnlyList<ListColumn<LeadListItemDto>> _columns = [];
    private RenderFragment<LeadListItemDto> _card = _ => _ => { };

    private bool CanCreate => App.Bootstrap?.Permissions.Any(p => p.Module == "Leads" && p.CanCreate) == true;

    private bool CanImport => App.Bootstrap?.Permissions.Any(p => p.Module == "Leads" && p.CanImport) == true;

    private bool CanExport => App.Bootstrap?.Permissions.Any(p => p.Module == "Leads" && p.CanExport) == true;

    private async Task DownloadTemplateAsync()
    {
        try
        {
            var response = await Http.GetAsync("api/v1/leads/template?format=xlsx");
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add(T["We could not download the template."], Severity.Error);
                return;
            }

            var bytes = await response.Content.ReadAsByteArrayAsync();
            await JS.InvokeVoidAsync("mindlift.downloadFile", "leads-template.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(bytes));
            Snackbar.Add(T["Template downloaded successfully"], Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(T["Failed to download template: {0}", ex.Message], Severity.Error);
        }
    }

    private async Task OpenHistoryDialog()
    {
        await Dialogs.ShowAsync<ImportHistoryDialog>(T["Lead Upload & Import History"], new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
    }

    private bool _statusDialogOpen;
    private LeadListItemDto? _statusLead;
    private string? _targetStatusKey;
    private string? _disqualifyReason;

    private IReadOnlyList<PicklistValueDto> SettableStatuses
    {
        get
        {
            var list = App.Bootstrap?.Picklists.FirstOrDefault(p => p.Key == "lead_status")?.Values
                .Where(v => v.IsActive && v.Value != "converted").OrderBy(v => v.SortOrder).ToList() ?? [];
            if (list.Count == 0)
            {
                return
                [
                    new(Guid.Empty, "new", "New", "جديد", "New", null, 0, true, true, true),
                    new(Guid.Empty, "working", "Contacted", "تم التواصل", "Working", null, 1, false, true, true),
                    new(Guid.Empty, "qualified", "Qualified", "مؤهل", "Qualified", null, 2, false, true, true),
                    new(Guid.Empty, "disqualified", "Not interested", "غير مهتم", "Disqualified", null, 3, false, true, true),
                ];
            }
            return list;
        }
    }

    private void OpenChangeStatusDialog(LeadListItemDto lead)
    {
        _statusLead = lead;
        _targetStatusKey = lead.Status;
        _disqualifyReason = null;
        _statusDialogOpen = true;
    }

    private async Task ConfirmChangeStatusAsync()
    {
        if (_statusLead is null || string.IsNullOrWhiteSpace(_targetStatusKey)) return;

        HttpResponseMessage res;
        if (_targetStatusKey == "disqualified")
        {
            res = await Http.PostAsJsonAsync($"api/v1/leads/{_statusLead.Id}/disqualify", new DisqualifyLeadRequest(_disqualifyReason?.Trim() ?? "Not interested", null));
        }
        else
        {
            res = await Http.PostAsJsonAsync($"api/v1/leads/{_statusLead.Id}/status", new ChangeLeadStatusRequest(_targetStatusKey));
        }

        if (res.IsSuccessStatusCode)
        {
            Snackbar.Add(T["Status updated successfully."], Severity.Success);
            _statusDialogOpen = false;
            if (_list is not null)
            {
                await _list.ReloadAsync();
            }
        }
        else
        {
            Snackbar.Add(await ProblemText.FromAsync(res, T["We could not change the status."]), Severity.Error);
        }
    }

    /// <summary>Downloads the leads the list is showing now: the same view, search, filters and sort in Excel (.xlsx) or CSV (.csv).</summary>
    private async Task ExportAsync(string format = "xlsx")
    {
        if (_list is null)
        {
            return;
        }

        var response = await Http.PostAsJsonAsync($"api/v1/leads/export?format={format}", _list.CurrentQuery with { Page = 1, PageSize = 200 });
        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add(await ProblemText.FromAsync(response, T["We could not export your leads."]), Severity.Error);
            return;
        }

        var bytes = await response.Content.ReadAsByteArrayAsync();
        var fileName = format == "xlsx" ? "leads.xlsx" : "leads.csv";
        var mime = format == "xlsx" ? "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" : "text/csv";
        await JS.InvokeVoidAsync("mindlift.downloadFile", fileName, mime, Convert.ToBase64String(bytes));
        Snackbar.Add(T["Export ready"], Severity.Success);
    }

    private string ItemLabel => App.ModuleLabel(AppModule.Leads).ToLowerInvariant();

    private IReadOnlyList<FieldDto> LeadFields => App.Bootstrap?.Fields.GetValueOrDefault("leads") ?? [];

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsSignedIn)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        _views = BuildViews();
        _columns = BuildColumns();
        _card = lead =>
            @<div class="ml-cell-primary">
                <UserAvatar Name="@LeadTitle(lead)" Id="@lead.Id" Size="40" />
                <div class="ml-cell-primary__text ml-grow">
                    <MudText Typo="Typo.subtitle1" Class="ml-truncate">@LeadTitle(lead)</MudText>
                    <MudText Typo="Typo.body2" Class="ml-muted ml-truncate">@LeadSubtitle(lead)</MudText>
                    <MudText Typo="Typo.caption" Class="ml-muted">@(lead.Source is null ? T["No source"] : SourceLabel(lead.Source)) · <DateText Value="@lead.CreatedAtUtc" /></MudText>
                </div>
                <StatusChip Text="@StatusLabel(lead.Status)" Color="@StatusColors.For(StatusCategory(lead.Status))" />
            </div>;

        await Task.WhenAll(LoadUsersAsync(), LoadSavedViewsAsync());
    }

    /// <summary>People for the owner filter. Staff without access to the user list only get "Me".</summary>
    private async Task LoadUsersAsync()
    {
        try
        {
            var page = await Http.GetFromJsonAsync<PagedResult<UserListItem>>("api/v1/users?pageSize=200");
            _users = page?.Items.Where(u => u.IsActive).ToList() ?? [];
        }
        catch (HttpRequestException)
        {
            _users = [];
        }
    }

    private static string? LeadHref(LeadListItemDto lead) => "/leads/" + lead.Id;

    private static string LeadTitle(LeadListItemDto lead) =>
        !string.IsNullOrWhiteSpace(lead.CompanyName) ? lead.CompanyName : (!string.IsNullOrWhiteSpace(lead.FullName) ? lead.FullName : "—");

    private static string LeadSubtitle(LeadListItemDto lead) =>
        !string.IsNullOrWhiteSpace(lead.FullName) ? lead.FullName : (lead.Email ?? lead.Phone ?? "—");

    private static string Secondary(LeadListItemDto lead) => LeadSubtitle(lead);

    private async Task AddToContactAsync(LeadListItemDto lead)
    {
        bool hasSufficient = (!string.IsNullOrWhiteSpace(lead.FirstName) || !string.IsNullOrWhiteSpace(lead.LastName) || !string.IsNullOrWhiteSpace(lead.FullName))
            && lead.FullName != "—";

        if (hasSufficient)
        {
            try
            {
                var res = await Http.PostAsJsonAsync($"api/v1/leads/{lead.Id}/quick-convert-contact", new QuickConvertContactRequest());
                if (res.IsSuccessStatusCode)
                {
                    var result = await res.Content.ReadFromJsonAsync<ConvertLeadResult>();
                    Snackbar.Add(T["Lead successfully added to Contacts!"], Severity.Success, config =>
                    {
                        if (result?.ContactId != null)
                        {
                            config.Action = T["View Contact"];
                            config.ActionColor = Color.Primary;
                            config.OnClick = _ => { Nav.NavigateTo($"/contacts/{result.ContactId}"); return Task.CompletedTask; };
                        }
                    });
                    if (_list is not null) await _list.ReloadAsync();
                    return;
                }
            }
            catch { /* fallback to dialog */ }
        }

        var parameters = new DialogParameters<LeadConvertDialog>
        {
            { x => x.LeadId, lead.Id },
            { x => x.TargetMode, "contact" }
        };
        var dialog = await Dialogs.ShowAsync<LeadConvertDialog>(T["Move Lead to Contact"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        var diagResult = await dialog.Result;
        if (!diagResult.Canceled && _list is not null)
        {
            await _list.ReloadAsync();
        }
    }

    private async Task MoveToEngagementAsync(LeadListItemDto lead)
    {
        bool hasSufficient = (!string.IsNullOrWhiteSpace(lead.FirstName) || !string.IsNullOrWhiteSpace(lead.LastName) || !string.IsNullOrWhiteSpace(lead.FullName))
            && (!string.IsNullOrWhiteSpace(lead.CompanyName) || lead.FullName != "—");

        if (hasSufficient)
        {
            try
            {
                var res = await Http.PostAsJsonAsync($"api/v1/leads/{lead.Id}/quick-convert-engagement", new QuickConvertEngagementRequest());
                if (res.IsSuccessStatusCode)
                {
                    var result = await res.Content.ReadFromJsonAsync<ConvertLeadResult>();
                    Snackbar.Add(T["Lead successfully moved to Engagement!"], Severity.Success, config =>
                    {
                        if (result?.DealId != null)
                        {
                            config.Action = T["View Engagement"];
                            config.ActionColor = Color.Primary;
                            config.OnClick = _ => { Nav.NavigateTo($"/deals/{result.DealId}"); return Task.CompletedTask; };
                        }
                    });
                    if (_list is not null) await _list.ReloadAsync();
                    return;
                }
            }
            catch { /* fallback to dialog */ }
        }

        var parameters = new DialogParameters<LeadConvertDialog>
        {
            { x => x.LeadId, lead.Id },
            { x => x.TargetMode, "engagement" }
        };
        var dialog = await Dialogs.ShowAsync<LeadConvertDialog>(T["Move Lead to Engagement"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        var diagResult = await dialog.Result;
        if (!diagResult.Canceled && _list is not null)
        {
            await _list.ReloadAsync();
        }
    }

    private async Task OpenStickyNoteAsync(LeadListItemDto lead)
    {
        var parameters = new DialogParameters<StickyNoteDialog>
        {
            { x => x.LeadId, lead.Id },
            { x => x.LeadTitle, LeadTitle(lead) },
            { x => x.InitialNote, lead.Description }
        };
        var dialog = await Dialogs.ShowAsync<StickyNoteDialog>(string.Empty, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (!result.Canceled && _list is not null)
        {
            await _list.ReloadAsync();
        }
    }

    private void OpenNewLead()
    {
        _form?.OpenNew();
        _drawer = true;
    }

    private async Task OnSaved()
    {
        Snackbar.Add(T["Lead saved"], Severity.Success);
        if (_list is not null)
        {
            await _list.ReloadAsync();
        }
    }

    private async Task<PagedResult<LeadListItemDto>> LoadAsync(ListQuery query)
    {
        var response = await Http.PostAsJsonAsync("api/v1/leads/query", query);
        if (!response.IsSuccessStatusCode)
        {
            throw new ListLoadException(await ProblemText.FromAsync(response, T["We could not load your leads. Try again."]));
        }

        return (await response.Content.ReadFromJsonAsync<PagedResult<LeadListItemDto>>())!;
    }

    private IReadOnlyList<ListColumn<LeadListItemDto>> BuildColumns() =>
    [
        new()
        {
            Header = "Company", SortField = "company_name",
            Cell = lead =>
                @<div class="ml-cell-primary">
                    <UserAvatar Name="@LeadTitle(lead)" Id="@lead.Id" Size="32" />
                    <div class="ml-cell-primary__text">
                        <div class="d-flex align-center gap-1">
                            <MudText Typo="Typo.subtitle2" Class="ml-truncate">@LeadTitle(lead)</MudText>
                            @if (!string.IsNullOrWhiteSpace(lead.Description))
                            {
                                <MudTooltip Text="@lead.Description">
                                    <span @onclick:stopPropagation="true" @onclick="() => OpenStickyNoteAsync(lead)">
                                        <MudIcon Icon="@Icons.Material.Outlined.EditNote" Size="Size.Small" Color="Color.Primary" Style="font-size:16px; cursor:pointer;" />
                                    </span>
                                </MudTooltip>
                            }
                        </div>
                        <MudText Typo="Typo.caption" Class="ml-muted ml-truncate">@LeadSubtitle(lead)</MudText>
                    </div>
                </div>,
        },
        new()
        {
            Header = "Status", SortField = "status",
            Cell = lead => @<StatusChip Text="@StatusLabel(lead.Status)" Color="@StatusColors.For(StatusCategory(lead.Status))" />,
        },
        new()
        {
            Header = "Source", SortField = "source", HideOnTablet = true,
            Cell = lead => @<span class="ml-muted">@SourceLabel(lead.Source)</span>,
        },
        new()
        {
            Header = "Owner", HideOnTablet = false,
            Cell = lead => @<span>@(lead.OwnerName ?? "—")</span>,
        },
        new()
        {
            Header = "Created", SortField = "created_at", AlignEnd = true,
            Cell = lead => @<DateText Value="@lead.CreatedAtUtc" />,
        },
    ];

    /// <summary>The three views are saved filters (plan 4.6.6). Converted leads are already excluded by the API.</summary>
    private static IReadOnlyList<ListView> BuildViews() =>
    [
        new(MineView, "My open leads", new FilterGroup
        {
            Conditions =
            [
                new FilterCondition { Field = "owner_id", Op = FilterOperator.Eq, Value = JsonSerializer.SerializeToElement("@me") },
                new FilterCondition { Field = "status", Op = FilterOperator.In, Value = JsonSerializer.SerializeToElement(new[] { "new", "working", "qualified" }) },
            ],
        }),
        new(AllView, "All open", new FilterGroup
        {
            Conditions = [new FilterCondition { Field = "status", Op = FilterOperator.NotIn, Value = JsonSerializer.SerializeToElement(new[] { "disqualified" }) }],
        }),
        new(NewView, "New", new FilterGroup
        {
            Conditions = [new FilterCondition { Field = "status", Op = FilterOperator.Eq, Value = JsonSerializer.SerializeToElement("new") }],
        }),
    ];

    private string SourceLabel(string? code)
        => code is null ? "—" : App.PicklistLabel("lead_source", code);

    private string StatusLabel(string code)
        => App.PicklistLabel("lead_status", code);

    private static string StatusCategory(string code) => code switch
    {
        "new" => "New",
        "working" => "Working",
        "qualified" => "Qualified",
        "disqualified" => "Lost",
        "converted" => "Won",
        _ => code,
    };

    // ---- bulk actions, row menu and saved views (plan 18.8.1) ----

    private IReadOnlyList<ListView> _savedViews = [];

    private bool HasPermission(Func<ModulePermissionDto, bool> check) => App.Bootstrap?.Permissions.Any(p => p.Module == "Leads" && check(p)) == true;

    private bool CanEditRecords => HasPermission(p => p.CanEdit);

    private bool CanDeleteRecords => HasPermission(p => p.CanDelete);

    private bool CanExportRecords => HasPermission(p => p.CanExport);

    /// <summary>Statuses a lead can be moved to in bulk. Disqualifying needs a reason for each lead, and converting is its own step.</summary>
    private IReadOnlyList<PicklistValueDto> BulkStatuses => App.Bootstrap?.Picklists.FirstOrDefault(p => p.Key == "lead_status")?.Values
        .Where(v => v.IsActive && v.Value is not ("disqualified" or "converted")).ToList() ?? [];

    private async Task LoadSavedViewsAsync() => _savedViews = await SavedViews.LoadAsync(Http, "leads", App.Bootstrap?.User.UserId, App.IsAdmin);

    private async Task SaveViewAsync(SaveViewRequest view)
    {
        var problem = await SavedViews.SaveAsync(Http, "leads", view, T["We could not save this view."]);
        if (problem is not null)
        {
            Snackbar.Add(problem, Severity.Error);
            return;
        }

        Snackbar.Add(T["View saved"], Severity.Success);
        await LoadSavedViewsAsync();
    }

    private async Task DeleteViewAsync(Guid id)
    {
        if (!await Dialogs.ConfirmAsync(T["Delete this view?"], T["The tab is removed for everyone it was shared with."], T["Delete"], danger: true))
        {
            return;
        }

        var problem = await SavedViews.DeleteAsync(Http, id, T["We could not delete this view."]);
        if (problem is not null)
        {
            Snackbar.Add(problem, Severity.Error);
            return;
        }

        await LoadSavedViewsAsync();
    }

    private async Task EditRowAsync(Guid id)
    {
        var response = await Http.GetAsync($"api/v1/leads/{id}");
        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add(await ProblemText.FromAsync(response, T["We could not open this record."]), Severity.Error);
            return;
        }

        _form?.OpenEdit((await response.Content.ReadFromJsonAsync<LeadDto>())!);
        _drawer = true;
    }

    private async Task DeleteRowAsync(Guid id, string? name)
    {
        if (!await Dialogs.ConfirmAsync(T["Delete {0}?", name ?? T["this record"]], T["This cannot be undone."], T["Delete"], danger: true))
        {
            return;
        }

        var response = await Http.DeleteAsync($"api/v1/leads/{id}");
        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add(await ProblemText.FromAsync(response, T["We could not delete this record."]), Severity.Error);
            return;
        }

        Snackbar.Add(T["Deleted"], Severity.Success);
        if (_list is not null)
        {
            await _list.ReloadAsync();
        }
    }

    private bool _moveDialogOpen;
    private LeadListItemDto? _movingLead;
    private BulkSelection? _bulkMovingSelection;
    private string? _targetViewKey;

    private string CurrentViewKey => _list?.CurrentViewKey ?? string.Empty;

    private IReadOnlyList<ListView> AvailableViewsForMove => _list?.AllViewsList ?? [.. _views, .. _savedViews];

    private void OpenMoveToViewDialog(LeadListItemDto lead)
    {
        _movingLead = lead;
        _bulkMovingSelection = null;
        _targetViewKey = null;
        _moveDialogOpen = true;
    }

    private void OpenBulkMoveToViewDialog(BulkSelection selection)
    {
        _movingLead = null;
        _bulkMovingSelection = selection;
        _targetViewKey = null;
        _moveDialogOpen = true;
    }

    private async Task ConfirmMoveLeadAsync()
    {
        if (string.IsNullOrWhiteSpace(_targetViewKey))
        {
            return;
        }

        _moveDialogOpen = false;
        var sourceViewKey = _list?.CurrentViewKey;
        var targetName = AvailableViewsForMove.FirstOrDefault(v => v.Key == _targetViewKey)?.Label ?? _targetViewKey;

        if (_movingLead is not null)
        {
            var lead = _movingLead;
            var problem = await SavedViews.MoveRecordAsync(Http, "leads", lead.Id, _targetViewKey, sourceViewKey, T["We could not move this lead."]);
            if (problem is not null)
            {
                Snackbar.Add(problem, Severity.Error);
                return;
            }

            Snackbar.Add(T["Moved lead to {0}", targetName], Severity.Success);
        }
        else if (_bulkMovingSelection is not null && _bulkMovingSelection.Ids.Count > 0)
        {
            var ids = _bulkMovingSelection.Ids;
            var problem = await SavedViews.MoveRecordsAsync(Http, "leads", ids, _targetViewKey, sourceViewKey, T["We could not move the selected leads."]);
            if (problem is not null)
            {
                Snackbar.Add(problem, Severity.Error);
                return;
            }

            Snackbar.Add(T["Moved {0} leads to {1}", ids.Count, targetName], Severity.Success);
            await _bulkMovingSelection.Done();
        }

        await LoadSavedViewsAsync();
        if (_list is not null)
        {
            await _list.ReloadAsync();
        }
    }
}
