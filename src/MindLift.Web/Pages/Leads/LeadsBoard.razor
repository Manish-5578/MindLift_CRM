@page "/leads/board"
@using MindLift.Shared.Filtering
@using FilterOperator = MindLift.Shared.Filtering.FilterOperator
@inject HttpClient Http
@inject AuthSession Session
@inject AppState App
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject Translator T

<PageTitle>@T["{0} board", T[App.ModuleLabel(AppModule.Leads)]] · MindLift</PageTitle>

<div class="ml-page ml-page--narrow">
    <PageHeader Title="@App.ModuleLabel(AppModule.Leads)" Subtitle="@SubtitleText">
        <Actions>
            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Medium" data-testid="layout-toggle">
                <MudButton Color="Color.Primary" Href="/leads/board">@T["Board"]</MudButton>
                <MudButton Href="/leads">@T["List"]</MudButton>
            </MudButtonGroup>
            @if (CanCreate)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="OpenNewLead" data-testid="primary-action">@T["New lead"]</MudButton>
            }
        </Actions>
    </PageHeader>

    <div class="ml-row ml-row--wrap" style="margin-bottom:16px" data-testid="board-toolbar">
        <MudTextField T="string" Value="_search" ValueChanged="SearchAsync" Immediate="true" DebounceInterval="300" Placeholder="@T["Search name, email, company or phone"]"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                      Class="ml-grow" Style="max-width:360px" data-testid="search" />
        <MudSwitch T="bool" Value="_mineOnly" ValueChanged="MineAsync" Label="@T["Only mine"]" Color="Color.Primary" data-testid="mine-only" />
    </div>

    @if (_error is not null)
    {
        <ErrorState Message="@_error" OnRetry="LoadAllAsync" />
    }
    else if (_loading && _columns.Count == 0)
    {
        <SkeletonCards Count="4" />
    }
    else
    {
        <KanbanBoard TItem="LeadListItemDto" Columns="_columns" Items="_view" Card="_card" OnMove="MoveAsync" EmptyText="No leads here">
            <ColumnFooter Context="column">
                @if (HasMore(column.Key))
                {
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => ShowMoreAsync(column.Key)" data-testid="@MoreTestId(column.Key)">@T["Show more ({0} left)", Remaining(column.Key)]</MudButton>
                }
            </ColumnFooter>
        </KanbanBoard>
    }
</div>

<LeadFormDrawer @ref="_form" @bind-Open="_drawer" OnSaved="OnSaved" />

@code {
    private const int PageSize = 25;
    private const string Disqualified = "disqualified";

    private LeadFormDrawer? _form;
    private bool _drawer;
    private bool _loading = true;
    private string? _error;
    private string? _search;
    private bool _mineOnly;
    private int _requestId;

    private List<KanbanColumn> _columns = [];
    private readonly Dictionary<string, List<LeadListItemDto>> _items = new();
    private readonly Dictionary<string, int> _totals = new();
    private readonly Dictionary<string, int> _pages = new();
    private IReadOnlyDictionary<string, IReadOnlyList<LeadListItemDto>> _view = new Dictionary<string, IReadOnlyList<LeadListItemDto>>();
    private RenderFragment<LeadListItemDto> _card = _ => _ => { };

    private bool CanCreate => App.Bootstrap?.Permissions.Any(p => p.Module == "Leads" && p.CanCreate) == true;

    private string? SubtitleText => _columns.Count == 0 ? null : $"{_totals.Values.Sum():N0} {App.ModuleLabel(AppModule.Leads).ToLowerInvariant()}";

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsSignedIn)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        _card = lead =>
            @<div class="ml-stack-sm">
                <a href="@("/leads/" + lead.Id)" draggable="false" class="ml-link" style="text-decoration:none">
                    <MudText Typo="Typo.subtitle1" Class="ml-truncate">@lead.FullName</MudText>
                </a>
                <MudText Typo="Typo.body2" Class="ml-muted ml-truncate">@(lead.CompanyName ?? lead.Email ?? lead.Phone ?? "—")</MudText>
                <div class="ml-row ml-row--between">
                    <MudText Typo="Typo.caption" Class="ml-muted">@SourceLabel(lead.Source) · <DateText Value="@lead.CreatedAtUtc" /></MudText>
                    <UserAvatar Name="@(lead.OwnerName ?? "?")" Id="@lead.OwnerId" Size="24" />
                </div>
            </div>;

        BuildColumns();
        await LoadAllAsync();
    }

    /// <summary>One column per active lead status except Converted, which moves to contacts and deals.</summary>
    private void BuildColumns()
    {
        var statuses = App.Bootstrap?.Picklists.FirstOrDefault(p => p.Key == "lead_status")?.Values
            .Where(v => v.IsActive && v.Value != "converted").OrderBy(v => v.SortOrder).ToList() ?? [];
        _columns = statuses.Select(s => new KanbanColumn(s.Value, T.Pick(s.Label, s.LabelAr), StatusDot(s.Value, s.Color))).ToList();
    }

    private static string StatusDot(string status, string? color) => color ?? status switch
    {
        "new" => "#4F46E5",
        "working" => "#F59E0B",
        "qualified" => "#16A34A",
        "disqualified" => "#94A3B8",
        _ => "#64748B",
    };

    private string SourceLabel(string? code)
        => code is null ? T["No source"] : App.PicklistLabel("lead_source", code);

    private static string MoreTestId(string key) => "kanban-more-" + key;

    private bool HasMore(string key) => _items.TryGetValue(key, out var list) && list.Count < _totals.GetValueOrDefault(key);

    private int Remaining(string key) => _totals.GetValueOrDefault(key) - (_items.TryGetValue(key, out var list) ? list.Count : 0);

    private async Task SearchAsync(string? text)
    {
        _search = string.IsNullOrWhiteSpace(text) ? null : text.Trim();
        await LoadAllAsync();
    }

    private async Task MineAsync(bool value)
    {
        _mineOnly = value;
        await LoadAllAsync();
    }

    private async Task LoadAllAsync()
    {
        var request = ++_requestId;
        _loading = true;
        _error = null;
        try
        {
            var results = await Task.WhenAll(_columns.Select(c => FetchAsync(c.Key, 1)));
            if (request != _requestId)
            {
                return; // A newer search was started. Ignore this answer.
            }

            _items.Clear();
            _totals.Clear();
            _pages.Clear();
            for (var i = 0; i < _columns.Count; i++)
            {
                _items[_columns[i].Key] = results[i].Items.ToList();
                _totals[_columns[i].Key] = results[i].Total;
                _pages[_columns[i].Key] = 1;
            }

            Publish();
        }
        catch (ListLoadException ex)
        {
            _error = ex.Message;
        }
        catch (HttpRequestException)
        {
            _error = T["We could not reach MindLift. Check your connection and try again."];
        }
        finally
        {
            if (request == _requestId)
            {
                _loading = false;
            }
        }
    }

    private async Task ShowMoreAsync(string key)
    {
        var next = _pages.GetValueOrDefault(key, 1) + 1;
        try
        {
            var page = await FetchAsync(key, next);
            _items[key].AddRange(page.Items);
            _totals[key] = page.Total;
            _pages[key] = next;
            Publish();
        }
        catch (Exception ex) when (ex is ListLoadException or HttpRequestException)
        {
            Snackbar.Add(T["We could not load more leads."], Severity.Error);
        }
    }

    private async Task<PagedResult<LeadListItemDto>> FetchAsync(string status, int page)
    {
        var filter = new FilterGroup
        {
            Conditions = [new FilterCondition { Field = "status", Op = FilterOperator.Eq, Value = JsonSerializer.SerializeToElement(status) }],
        };
        if (_mineOnly)
        {
            filter.Conditions.Add(new FilterCondition { Field = "owner_id", Op = FilterOperator.Eq, Value = JsonSerializer.SerializeToElement("@me") });
        }

        var response = await Http.PostAsJsonAsync("api/v1/leads/query", new ListQuery(_search, filter, "created_at", "desc", page, PageSize));
        if (!response.IsSuccessStatusCode)
        {
            throw new ListLoadException(await ProblemText.FromAsync(response, T["We could not load your leads. Try again."]));
        }

        return (await response.Content.ReadFromJsonAsync<PagedResult<LeadListItemDto>>())!;
    }

    /// <summary>Hands the board its columns (with the real totals) and cards.</summary>
    private void Publish()
    {
        _columns = _columns.Select(c => c with { Total = _totals.GetValueOrDefault(c.Key) }).ToList();
        _view = _items.ToDictionary(kv => kv.Key, kv => (IReadOnlyList<LeadListItemDto>)kv.Value);
    }

    private async Task MoveAsync(KanbanMove<LeadListItemDto> move)
    {
        var lead = move.Item;
        HttpResponseMessage response;
        if (move.ToKey == Disqualified)
        {
            var reason = await Dialogs.PromptReasonAsync($"Disqualify {lead.FullName}?", T["Say why this lead is not a fit. It stays on record."], T["Reason *"], T["Disqualify"], danger: true);
            if (reason is null)
            {
                return;
            }

            response = await Http.PostAsJsonAsync($"api/v1/leads/{lead.Id}/disqualify", new DisqualifyLeadRequest(reason, null));
        }
        else
        {
            var full = await Http.GetFromJsonAsync<LeadDto>($"api/v1/leads/{lead.Id}");
            if (full is null)
            {
                Snackbar.Add(T["We could not open this lead."], Severity.Error);
                return;
            }

            response = await Http.PutAsJsonAsync($"api/v1/leads/{lead.Id}", new SaveLeadRequest(
                full.FirstName, full.LastName, full.Email, full.Phone, full.CompanyName, move.ToKey, full.Source, full.Rating,
                full.Description, full.Tags, full.OwnerId, full.CustomFields));
        }

        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add(await ProblemText.FromAsync(response, T["We could not move this lead."]), Severity.Error);
        }
        else
        {
            var label = _columns.FirstOrDefault(c => c.Key == move.ToKey)?.Label ?? move.ToKey;
            Snackbar.Add($"{lead.FullName} moved to {label}", Severity.Success);
        }

        // Counts and order come from the server, so both columns are loaded again whether or not the move worked.
        await LoadAllAsync();
    }

    private void OpenNewLead()
    {
        _form?.OpenNew();
        _drawer = true;
    }

    private async Task OnSaved()
    {
        Snackbar.Add(T["Lead saved"], Severity.Success);
        await LoadAllAsync();
    }
}
