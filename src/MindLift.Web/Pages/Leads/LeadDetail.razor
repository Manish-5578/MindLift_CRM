@page "/leads/{Id:guid}"
@inject HttpClient Http
@inject AuthSession Session
@inject AppState App
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject Translator T

<PageTitle>@T["Lead"] · MindLift</PageTitle>

<div class="ml-page ml-page--narrow">
    @if (_loading)
    {
        <MlCard Loading="true" />
    }
    else if (_lead is null)
    {
        <ErrorState Title="We could not open this lead" Message="@(_error ?? "It may have been deleted, or you may not have access to it.")" OnRetry="LoadAsync" />
    }
    else
    {
        <PageHeader Title="@($"{_lead.FirstName} {_lead.LastName}".Trim())" Subtitle="@(_lead.CompanyName ?? _lead.Email ?? "")"
                    Breadcrumbs="@(new List<BreadcrumbItem> { new(App.ModuleLabel(AppModule.Leads), BackUrl), new(_lead.FirstName, null, true) })">
            <Actions>
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.ArrowBack" Href="@BackUrl">@T["Back"]</MudButton>
                @if (!_converted && !_disqualified)
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Handshake" OnClick="QuickMoveToEngagementAsync">@T["Move to engagement"]</MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="FindDuplicatesAsync" data-testid="find-duplicates">@T["Find duplicates"]</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Transform" OnClick="OpenConvertDialogAsync" data-testid="convert-lead-btn">@T["Convert"]</MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="() => _showDisqualify = !_showDisqualify">@T["Disqualify"]</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenEdit" data-testid="primary-action">@T["Edit"]</MudButton>
                }
                else if (_disqualified)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick='() => SetStatusAsync("new")' data-testid="reopen-lead-btn">@T["Reopen lead"]</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenEdit" data-testid="primary-action">@T["Edit"]</MudButton>
                }
            </Actions>
        </PageHeader>

        <div class="ml-row ml-row--wrap align-center gap-3" style="margin-bottom:24px" data-testid="lead-status-bar">
            <div class="d-flex align-center gap-2">
                <MudText Typo="Typo.subtitle2" Class="ml-muted">@T["Status:"]</MudText>
                @if (!_converted)
                {
                    <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small" data-testid="status-button-group">
                        @foreach (var s in AvailableStatuses)
                        {
                            var isCurrent = s.Value == _lead.Status;
                            <MudButton Variant="@(isCurrent ? Variant.Filled : Variant.Outlined)"
                                       Color="@(isCurrent ? StatusButtonColor(s.Value) : Color.Default)"
                                       Disabled="@(isCurrent || _statusBusy)"
                                       OnClick="() => SetStatusAsync(s.Value)"
                                       data-testid="@("status-btn-" + s.Value)">
                                @T.Pick(s.Label, s.LabelAr)
                            </MudButton>
                        }
                    </MudButtonGroup>
                }
                else
                {
                    <StatusChip Text="@T["Converted"]" Color="@StatusColors.For("Won")" />
                }
            </div>
            @if (_disqualified)
            {
                <StatusChip Text="@T["Disqualified"]" Color="@StatusColors.For("Lost")" />
            }
            @if (_lead.Rating is not null) { <StatusChip Text="@RatingLabel(_lead.Rating)" Dot="false" /> }
            @if (_lead.Source is not null) { <StatusChip Text="@SourceLabel(_lead.Source)" Dot="false" /> }
            <MudText Typo="Typo.body2" Class="ml-muted">@T["Created"] <DateText Value="@_lead.CreatedAtUtc" /></MudText>
        </div>

        @if (NextCallback is { } cb)
        {
            <MudAlert Severity="@(cb.IsOverdue ? Severity.Error : Severity.Info)" Dense="true" Class="mb-4" Icon="@Icons.Material.Filled.PhoneCallback" data-testid="lead-callback-alert">
                <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                    <div>
                        <strong>@(cb.IsOverdue ? T["Overdue Callback:"] : T["Upcoming Callback:"])</strong>
                        <span class="ml-2">@cb.Subject</span> · <DateText Value="@cb.DueAtUtc" Danger="@cb.IsOverdue" />
                        @if (!string.IsNullOrWhiteSpace(cb.Description))
                        {
                            <span class="ml-2 ml-muted">(@cb.Description)</span>
                        }
                    </div>
                    <div class="d-flex align-center gap-1">
                        <MudButton Variant="Variant.Filled" Color="@(cb.IsOverdue ? Color.Error : Color.Primary)" Size="Size.Small" StartIcon="@Icons.Material.Filled.Check" OnClick="() => OpenOutcomeDialogAsync(cb)" data-testid="complete-callback-btn">
                            @T["Complete"]
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" StartIcon="@Icons.Material.Filled.Update" OnClick="() => OpenRescheduleDialogAsync(cb)" data-testid="reschedule-callback-btn">
                            @T["Reschedule"]
                        </MudButton>
                    </div>
                </div>
            </MudAlert>
        }

        @if (_converted)
        {
            <MudAlert Severity="Severity.Success" Class="mb-4" data-testid="converted-banner">
                <div class="d-flex flex-column gap-2">
                    <div>
                        <strong>@T["This lead was converted"]</strong> <DateText Value="@_lead.ConvertedAtUtc" />.
                    </div>
                    <div class="d-flex align-center gap-2 flex-wrap mt-1">
                        @if (_lead.ConvertedContactId.HasValue)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Person" Href="@($"/contacts/{_lead.ConvertedContactId}")">
                                @T["View Contact"]
                            </MudButton>
                        }
                        @if (_lead.ConvertedAccountId.HasValue)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" StartIcon="@Icons.Material.Filled.Business" Href="@($"/accounts/{_lead.ConvertedAccountId}")">
                                @T["View Account"]
                            </MudButton>
                        }
                        @if (_lead.ConvertedDealId.HasValue)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.MonetizationOn" Href="@($"/deals/{_lead.ConvertedDealId}")">
                                @T["View Deal"]
                            </MudButton>
                        }
                    </div>
                </div>
            </MudAlert>
        }

        @if (_showDisqualify && !_converted)
        {
            <MlCard Title="Disqualify this lead" Class="mb-4">
                <div class="ml-stack">
                    <MudTextField @bind-Value="_reason" Label="@T["Reason *"]" Variant="Variant.Outlined" Margin="Margin.Dense" data-testid="disqualify-reason"
                                  Error="@(_reasonError is not null)" ErrorText="@_reasonError" />
                    <MudTextField @bind-Value="_notes" Label="@T["Notes"]" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
                    <div class="ml-row" style="justify-content:flex-end">
                        <MudButton OnClick="() => _showDisqualify = false">@T["Cancel"]</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="DisqualifyAsync" data-testid="disqualify-submit">@T["Disqualify"]</MudButton>
                    </div>
                </div>
            </MlCard>
        }

        @if (_showDuplicates && !_converted)
        {
            <MlCard Title="Possible duplicates" Subtitle="Leads and contacts with the same email, phone or name." Class="mb-4" TestId="duplicates-panel">
                <div class="ml-stack">
                    @if (_candidates.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="ml-muted" data-testid="no-duplicates">@T["Nothing else shares this lead's email, phone or name."]</MudText>
                    }

                    @foreach (var candidate in _candidates)
                    {
                        var current = candidate;
                        <div class="ml-row" style="padding:6px 0;border-bottom:1px solid var(--ml-border)" data-testid="duplicate-row">
                            @if (current.Kind == LeadKind)
                            {
                                <MudCheckBox T="bool" Value="_selectedIds.Contains(current.Id)" ValueChanged="v => ToggleCandidate(current.Id, v)" Color="Color.Primary" aria-label="@("Merge " + current.FullName)" />
                            }
                            <div class="ml-grow">
                                <MudText Typo="Typo.subtitle2">@current.FullName</MudText>
                                <MudText Typo="Typo.caption" Class="ml-muted">@KindLabel(current.Kind) · @(current.Email ?? current.Phone ?? "No contact details") · @current.Reason</MudText>
                            </div>
                        </div>
                    }

                    @if (_candidates.Any(c => c.Kind == LeadKind))
                    {
                        <MudText Typo="Typo.caption" Class="ml-muted">@T["Tick the leads to fold into this one. Contacts are shown for information and cannot be merged here."]</MudText>
                    }

                    <div class="ml-row" style="justify-content:flex-end">
                        <MudButton OnClick="() => _showDuplicates = false">@T["Close"]</MudButton>
                        @if (_candidates.Any(c => c.Kind == LeadKind))
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="MergeAsync" data-testid="merge-submit">@T["Merge selected"]</MudButton>
                        }
                    </div>
                </div>
            </MlCard>
        }


        @if (_proactiveDuplicates.Count > 0 && !_converted && !_showDuplicates)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4" Icon="@Icons.Material.Filled.WarningAmber">
                <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                    <span style="font-weight: 500;">@T["{0} potential duplicate record(s) detected for this lead.", _proactiveDuplicates.Count]</span>
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small" StartIcon="@Icons.Material.Filled.CompareArrows" OnClick="OpenProactiveMergeAsync" data-testid="proactive-merge-btn">
                        @T["Compare & Merge"]
                    </MudButton>
                </div>
            </MudAlert>
        }

        <MudGrid Spacing="4" Class="mb-4">
            <MudItem xs="12" md="6">
                <MlCard Title="Details">
                    <KeyValueList Items="@Details()" />
                    @if (_custom.Count > 0)
                    {
                        <div class="mt-4 pt-3" style="border-top:1px solid var(--ml-border)">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">@T["Custom Fields"]</MudText>
                            <KeyValueList Items="@CustomItems()" />
                        </div>
                    }
                </MlCard>
            </MudItem>

            <MudItem xs="12" md="6">
                <MlCard Title="Notes" Subtitle="@T["Chronological record of lead notes and updates."]" TestId="lead-notes-card">
                    <div class="ml-stack gap-3">
                        <div class="d-flex flex-column gap-2" style="border:1px solid var(--ml-border);padding:16px;border-radius:8px;background:var(--mud-palette-surface)">
                            <MudTextField @bind-Value="_newNoteContent" 
                                          @bind-Value:after="StateHasChanged"
                                          Immediate="true"
                                          Placeholder="@T["Write a note..."]" 
                                          Lines="3" 
                                          Variant="Variant.Outlined" 
                                          Margin="Margin.Dense" 
                                          data-testid="lead-note-input" />
                            <div class="d-flex justify-end gap-2">
                                <MudButton Variant="Variant.Filled" 
                                           Color="Color.Primary" 
                                           Size="Size.Small" 
                                           StartIcon="@Icons.Material.Filled.AddComment" 
                                           Disabled="@(string.IsNullOrWhiteSpace(_newNoteContent) || _savingNote)" 
                                           OnClick="AddNoteAsync" 
                                           data-testid="add-note-btn">
                                    @if (_savingNote) { <MudProgressCircular Size="Size.Small" Indeterminate="true" /> }
                                    else { @T["Add note"] }
                                </MudButton>
                            </div>
                        </div>

                        @if (_loadingNotes)
                        {
                            <MudProgressLinear Indeterminate="true" />
                        }
                        else if (_notesList.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="ml-muted pa-3" data-testid="no-notes">@T["No notes yet. Add the first note above."]</MudText>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-3 mt-2" data-testid="notes-history" style="max-height:480px;overflow-y:auto">
                                @foreach (var note in _notesList)
                                {
                                    <div class="pa-3 rounded-lg" style="border:1px solid var(--ml-border);background:var(--mud-palette-surface)" data-testid="note-item">
                                        <div class="d-flex align-center justify-space-between mb-2">
                                            <div class="d-flex align-center gap-2">
                                                <MudAvatar Size="Size.Small" Color="Color.Primary">
                                                    @(string.IsNullOrWhiteSpace(note.AuthorName) ? "U" : note.AuthorName[0].ToString().ToUpper())
                                                </MudAvatar>
                                                <MudText Typo="Typo.subtitle2" Style="font-weight:600" data-testid="note-author">
                                                    @note.AuthorName
                                                </MudText>
                                                <MudText Typo="Typo.caption" Class="ml-muted" data-testid="note-date">
                                                    · <DateText Value="@note.CreatedAtUtc" />
                                                </MudText>
                                            </div>
                                            @if (note.Id != Guid.Empty)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Default" OnClick="() => DeleteNoteAsync(note.Id)" aria-label="@T["Delete"]" data-testid="delete-note-btn" />
                                            }
                                        </div>
                                        <MudText Typo="Typo.body2" Style="white-space:pre-wrap;overflow-wrap:anywhere" data-testid="note-content">
                                            @note.Content
                                        </MudText>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </MlCard>
            </MudItem>
        </MudGrid>

        <div class="mt-4"><RecordActivities @ref="_activities" LeadId="Id" OnChanged="ReloadTimelineAsync" /></div>
        <div class="mt-4"><RecordTimeline @ref="_timeline" EntityType="leads" EntityId="Id" /></div>
        <div class="mt-4"><RecordFiles EntityType="leads" EntityId="Id" /></div>
    }
</div>

<LeadFormDrawer @ref="_form" @bind-Open="_drawer" OnSaved="LoadAsync" />

@code {
    private RecordTimeline? _timeline;
    private RecordActivities? _activities;
    private List<LeadNoteDto> _notesList = [];
    private bool _loadingNotes;
    private bool _savingNote;
    private string? _newNoteContent;

    private ActivityDto? NextCallback => _activities?.Items?
        .Where(a => a.Type == ActivityTypes.Call && a.Status == "Open" && a.DueAtUtc.HasValue)
        .OrderBy(a => a.DueAtUtc)
        .FirstOrDefault();

    private async Task LoadNotesAsync()
    {
        _loadingNotes = true;
        try
        {
            _notesList = await Http.GetFromJsonAsync<List<LeadNoteDto>>($"api/v1/leads/{Id}/notes") ?? [];
        }
        catch
        {
            _notesList = [];
        }
        finally
        {
            _loadingNotes = false;
        }

        if (_notesList.Count == 0 && !string.IsNullOrWhiteSpace(_lead?.Description))
        {
            _notesList.Add(new LeadNoteDto(Guid.Empty, Id, _lead.Description, _lead.OwnerId, "System", _lead.CreatedAtUtc));
        }
    }

    private async Task AddNoteAsync()
    {
        if (string.IsNullOrWhiteSpace(_newNoteContent)) return;
        _savingNote = true;
        try
        {
            var res = await Http.PostAsJsonAsync($"api/v1/leads/{Id}/notes", new CreateLeadNoteRequest(_newNoteContent));
            if (res.IsSuccessStatusCode)
            {
                var note = await res.Content.ReadFromJsonAsync<LeadNoteDto>();
                if (note is not null)
                {
                    _notesList.Insert(0, note);
                }
                _newNoteContent = string.Empty;
                Snackbar.Add(T["Note added successfully"], Severity.Success);
                await ReloadTimelineAsync();
                if (_activities is not null) await _activities.LoadAsync();
            }
            else
            {
                Snackbar.Add(await ProblemText.FromAsync(res, T["Could not add note."]), Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _savingNote = false;
        }
    }

    private async Task DeleteNoteAsync(Guid noteId)
    {
        var res = await Http.DeleteAsync($"api/v1/leads/{Id}/notes/{noteId}");
        if (res.IsSuccessStatusCode)
        {
            _notesList.RemoveAll(n => n.Id == noteId);
            Snackbar.Add(T["Note deleted"], Severity.Success);
        }
        else
        {
            Snackbar.Add(await ProblemText.FromAsync(res, T["Could not delete note."]), Severity.Error);
        }
    }

    private async Task OpenOutcomeDialogAsync(ActivityDto act)
    {
        if (_activities is not null)
        {
            await _activities.RecordOutcomeAsync(act);
        }
    }

    private async Task OpenRescheduleDialogAsync(ActivityDto act)
    {
        if (_activities is not null)
        {
            await _activities.RescheduleAsync(act);
        }
    }

    private async Task ReloadTimelineAsync()
    {
        if (_timeline is not null)
        {
            await _timeline.ReloadAsync();
        }
    }

    private async Task OnNoteSavedAsync(string? note)
    {
        if (_lead is not null)
        {
            _lead = _lead with { Description = note };
        }
        if (_activities is not null)
        {
            await _activities.LoadAsync();
        }
        await ReloadTimelineAsync();
    }
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "returnView")] public string? ReturnView { get; set; }

    private string BackUrl => string.IsNullOrWhiteSpace(ReturnView) ? "/leads" : $"/leads?view={Uri.EscapeDataString(ReturnView)}";

    private LeadDto? _lead;
    private bool _loading = true;
    private string? _error;
    private LeadFormDrawer? _form;
    private bool _drawer;

    private void OpenEdit()
    {
        if (_lead is null) return;
        _form?.OpenEdit(_lead);
        _drawer = true;
    }
    private const string LeadKind = "lead";

    private bool _showDuplicates;
    private List<DuplicateCandidateDto> _candidates = [];
    private readonly HashSet<Guid> _selectedIds = [];

    private static string KindLabel(string kind) => kind switch
    {
        "lead" => "Lead",
        "contact" => "Contact",
        "account" => "Company",
        _ => kind,
    };

    private void ToggleCandidate(Guid id, bool selected)
    {
        if (selected)
        {
            _selectedIds.Add(id);
        }
        else
        {
            _selectedIds.Remove(id);
        }
    }

    private async Task FindDuplicatesAsync()
    {
        if (_lead is null)
        {
            return;
        }

        _showDuplicates = true;
        _selectedIds.Clear();
        var response = await Http.PostAsJsonAsync("api/v1/leads/check-duplicates",
            new CheckDuplicatesRequest(_lead.FirstName, _lead.LastName, _lead.Email, _lead.Phone, _lead.CompanyName));
        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add(await ProblemText.FromAsync(response, T["We could not look for duplicates."]), Severity.Error);
            _candidates = [];
            return;
        }

        // The check also returns this lead itself. It is not a duplicate of itself.
        _candidates = (await response.Content.ReadFromJsonAsync<List<DuplicateCandidateDto>>() ?? []).Where(c => c.Id != Id).ToList();
    }

    private List<DuplicateCandidateDto> _proactiveDuplicates = [];

    private async Task OpenProactiveMergeAsync()
    {
        if (_proactiveDuplicates.Count == 0) return;
        var candidateIds = _proactiveDuplicates.Where(c => c.Kind == LeadKind).Select(c => c.Id).Take(2).ToList();
        if (candidateIds.Count == 0)
        {
            _showDuplicates = true;
            _candidates = _proactiveDuplicates;
            return;
        }

        var parameters = new DialogParameters
        {
            ["EntityType"] = "lead",
            ["MasterId"] = Id,
            ["DuplicateIds"] = candidateIds
        };

        var dialog = await Dialogs.ShowAsync<SideBySideMergeDialog>(string.Empty, parameters);
        var result = await dialog.Result;
        if (!result.Canceled && result.Data is true)
        {
            _showDuplicates = false;
            _selectedIds.Clear();
            await LoadAsync();
        }
    }

    private async Task MergeAsync()
    {
        if (_lead is null)
        {
            return;
        }

        if (_selectedIds.Count == 0)
        {
            Snackbar.Add(T["Tick at least one lead to merge."], Severity.Warning);
            return;
        }

        if (_selectedIds.Count > 2)
        {
            Snackbar.Add(T["Select up to 2 duplicates at a time for side-by-side consolidation."], Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["EntityType"] = "lead",
            ["MasterId"] = Id,
            ["DuplicateIds"] = _selectedIds.ToList()
        };

        var dialog = await Dialogs.ShowAsync<SideBySideMergeDialog>(string.Empty, parameters);
        var result = await dialog.Result;
        if (!result.Canceled && result.Data is true)
        {
            _showDuplicates = false;
            _selectedIds.Clear();
            await LoadAsync();
        }
    }

    private bool _showConvert;
    private bool _showDisqualify;
    private string _reason = string.Empty;
    private string? _reasonError;
    private string? _notes;
    private string? _accountName;
    private bool _createDeal;
    private string? _dealName;
    private decimal? _amount;

    private bool _converted => _lead?.Status == "converted";
    private bool _disqualified => _lead?.Status == "disqualified";

    private IReadOnlyDictionary<string, JsonElement> _custom => _lead?.CustomFields ?? new Dictionary<string, JsonElement>();

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsSignedIn)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var response = await Http.GetAsync($"api/v1/leads/{Id}");
            if (response.IsSuccessStatusCode)
            {
                _lead = await response.Content.ReadFromJsonAsync<LeadDto>();
                _accountName ??= _lead?.CompanyName;
                await LoadNotesAsync();

                try
                {
                    var dupsRes = await Http.GetAsync($"api/v1/leads/{Id}/duplicates");
                    if (dupsRes.IsSuccessStatusCode)
                    {
                        _proactiveDuplicates = (await dupsRes.Content.ReadFromJsonAsync<List<DuplicateCandidateDto>>() ?? []).Where(c => c.Id != Id).ToList();
                    }
                    else
                    {
                        _proactiveDuplicates = [];
                    }
                }
                catch
                {
                    _proactiveDuplicates = [];
                }
            }
            else
            {
                _lead = null;
                _error = await ProblemText.FromAsync(response, T["It may have been deleted, or you may not have access to it."]);
            }
        }
        catch (HttpRequestException)
        {
            _error = T["We could not reach MindLift. Check your connection and try again."];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DisqualifyAsync()
    {
        _reasonError = null;
        if (string.IsNullOrWhiteSpace(_reason))
        {
            _reasonError = T["Say why this lead is not a fit."];
            return;
        }

        var response = await Http.PostAsJsonAsync($"api/v1/leads/{Id}/disqualify", new DisqualifyLeadRequest(_reason.Trim(), _notes));
        if (!response.IsSuccessStatusCode)
        {
            var fields = await ProblemText.FieldErrorsAsync(response);
            if (fields.Count > 0)
            {
                _reasonError = string.Join(" ", fields.Values);
                return;
            }

            Snackbar.Add(await ProblemText.FromAsync(response, T["Could not disqualify this lead."]), Severity.Error);
            return;
        }

        _showDisqualify = false;
        _reason = string.Empty;
        Snackbar.Add(T["Lead disqualified"], Severity.Success);
        await LoadAsync();
    }

    private async Task QuickMoveToEngagementAsync()
    {
        if (_lead is null) return;
        bool hasSufficient = (!string.IsNullOrWhiteSpace(_lead.FirstName) || !string.IsNullOrWhiteSpace(_lead.LastName))
            && !string.IsNullOrWhiteSpace(_lead.CompanyName);

        if (hasSufficient)
        {
            try
            {
                var res = await Http.PostAsJsonAsync($"api/v1/leads/{Id}/quick-convert-engagement", new QuickConvertEngagementRequest());
                if (res.IsSuccessStatusCode)
                {
                    var result = await res.Content.ReadFromJsonAsync<ConvertLeadResult>();
                    Snackbar.Add(T["Lead successfully moved to Engagement!"], Severity.Success, config =>
                    {
                        if (result?.DealId != null)
                        {
                            config.Action = T["View Engagement"];
                            config.ActionColor = Color.Primary;
                            config.OnClick = _ => { Nav.NavigateTo($"/deals/{result.DealId}"); return Task.CompletedTask; };
                        }
                    });
                    await LoadAsync();
                    return;
                }
            }
            catch { /* fallback to dialog */ }
        }

        var parameters = new DialogParameters<LeadConvertDialog>
        {
            { x => x.LeadId, Id },
            { x => x.TargetMode, "engagement" }
        };
        var dialog = await Dialogs.ShowAsync<LeadConvertDialog>(T["Move Lead to Engagement"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
        var diagResult = await dialog.Result;
        if (!diagResult.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task OpenConvertDialogAsync()
    {
        var parameters = new DialogParameters<LeadConvertDialog>
        {
            { x => x.LeadId, Id }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true,
            CloseOnEscapeKey = true
        };
        var dialog = await Dialogs.ShowAsync<LeadConvertDialog>(T["Convert Lead"], parameters, options);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            await LoadAsync();
        }
    }

    private IReadOnlyList<(string Label, string? Value)> Details()
    {
        if (_lead is null)
        {
            return [];
        }

        var items = new List<(string Label, string? Value)>
        {
            ("Email", _lead.Email),
            ("Phone", _lead.Phone),
            ("Company", _lead.CompanyName),
            ("Address", _lead.Address),
            ("City", _lead.City),
            ("State", _lead.State),
            ("Source", SourceLabel(_lead.Source)),
            ("Rating", RatingLabel(_lead.Rating)),
            ("Status", StatusLabel(_lead.Status)),
        };

        // The reason only applies to disqualified leads; showing an empty one on other leads is noise.
        if (_lead.Status == "disqualified")
        {
            items.Add(("Disqualified because", _lead.DisqualifyReason));
        }

        return items;
    }

    private IReadOnlyList<(string Label, string? Value)> CustomItems()
    {
        var fields = App.Bootstrap?.Fields.GetValueOrDefault("leads")?.Where(f => f.IsCustom).ToList() ?? [];
        return fields
            .Where(f => _custom.ContainsKey(f.Key))
            .Select(f => (f.Label, (string?)Render(_custom[f.Key])))
            .ToList();
    }

    private static string? Render(JsonElement value) => value.ValueKind switch
    {
        JsonValueKind.String => value.GetString(),
        JsonValueKind.Number => value.GetRawText(),
        JsonValueKind.True => "Yes",
        JsonValueKind.False => "No",
        JsonValueKind.Array => string.Join(", ", value.EnumerateArray().Select(v => v.GetString())),
        _ => null,
    };

    private string StatusLabel(string code) => PicklistLabel("lead_status", code);
    private string? SourceLabel(string? code) => code is null ? null : PicklistLabel("lead_source", code);
    private string? RatingLabel(string? code) => code is null ? null : PicklistLabel("lead_rating", code);

    private string PicklistLabel(string key, string code)
        => App.PicklistLabel(key, code);

    private bool _statusBusy;

    private IReadOnlyList<PicklistValueDto> AvailableStatuses
    {
        get
        {
            var list = App.Bootstrap?.Picklists.FirstOrDefault(p => p.Key == "lead_status")?.Values
                .Where(v => v.IsActive && v.Value != "converted" && v.Value != "disqualified").OrderBy(v => v.SortOrder).ToList() ?? [];
            if (list.Count == 0)
            {
                return
                [
                    new(Guid.Empty, "new", "New", "جديد", "New", null, 0, true, true, true),
                    new(Guid.Empty, "working", "Contacted", "تم التواصل", "Working", null, 1, false, true, true),
                    new(Guid.Empty, "qualified", "Qualified", "مؤهل", "Qualified", null, 2, false, true, true),
                ];
            }
            return list;
        }
    }

    private static Color StatusButtonColor(string status) => status switch
    {
        "new" => Color.Primary,
        "working" => Color.Warning,
        "qualified" => Color.Success,
        _ => Color.Primary
    };

    private async Task SetStatusAsync(string status)
    {
        if (_lead is null || _statusBusy) return;
        _statusBusy = true;
        try
        {
            var res = await Http.PostAsJsonAsync($"api/v1/leads/{Id}/status", new ChangeLeadStatusRequest(status));
            if (res.IsSuccessStatusCode)
            {
                var updated = await res.Content.ReadFromJsonAsync<LeadDto>();
                if (updated is not null)
                {
                    _lead = updated;
                }
                Snackbar.Add(T["Status updated to {0}", StatusLabel(status)], Severity.Success);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(await ProblemText.FromAsync(res, T["We could not update the status."]), Severity.Error);
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add(T["Network error. Please try again."], Severity.Error);
        }
        finally
        {
            _statusBusy = false;
        }
    }
}
