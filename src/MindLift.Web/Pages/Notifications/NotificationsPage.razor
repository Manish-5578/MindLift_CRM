@page "/notifications"
@implements IDisposable
@inject HttpClient Http
@inject AuthSession Session
@inject NotificationClient Notifications
@inject NavigationManager Nav

<PageTitle>Notifications · MindLift</PageTitle>

<div class="ml-page ml-page--form">
    <PageHeader Title="Notifications" Subtitle="Assignments, mentions, reminders and results of your imports.">
        <Actions>
            <MudButton Variant="Variant.Outlined" Href="/notifications/preferences" data-testid="open-preferences">Preferences</MudButton>
            @if (_unread > 0)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="MarkAllAsync" data-testid="primary-action">Mark all as read</MudButton>
            }
        </Actions>
    </PageHeader>

    <div class="ml-row ml-row--wrap" style="margin-bottom:16px" data-testid="notification-tabs">
        <MudChip T="string" Variant="@(!_unreadOnly ? Variant.Filled : Variant.Outlined)" Color="@(!_unreadOnly ? Color.Primary : Color.Default)" OnClick="() => SetFilterAsync(false)" data-testid="tab-all">All</MudChip>
        <MudChip T="string" Variant="@(_unreadOnly ? Variant.Filled : Variant.Outlined)" Color="@(_unreadOnly ? Color.Primary : Color.Default)" OnClick="() => SetFilterAsync(true)" data-testid="tab-unread">Unread@(_unread > 0 ? $" ({_unread})" : "")</MudChip>
    </div>

    @if (_error is not null)
    {
        <ErrorState Message="@_error" OnRetry="ReloadAsync" />
    }
    else if (_loading && _items.Count == 0)
    {
        <SkeletonTable Rows="5" Columns="2" />
    }
    else if (_items.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.NotificationsNone" Title="@(_unreadOnly ? "You are all caught up" : "No notifications yet")" Message="@(_unreadOnly ? "Everything has been read." : "When someone assigns you something or mentions you, it shows up here.")" />
    }
    else
    {
        <MlCard>
            @foreach (var item in _items)
            {
                var current = item;
                <div class="@RowClass(current)" @onclick="() => OpenAsync(current)" role="button" tabindex="0" data-testid="notification-row">
                    <div class="ml-row ml-row--between">
                        <MudText Typo="Typo.subtitle2" Style="@(current.IsRead ? "font-weight:400" : null)">@current.Title</MudText>
                        <MudText Typo="Typo.caption" Class="ml-faint"><DateText Value="@current.CreatedAtUtc" /></MudText>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(current.Body))
                    {
                        <MudText Typo="Typo.body2" Class="ml-muted">@current.Body</MudText>
                    }
                </div>
            }
        </MlCard>

        @if (_items.Count < _total)
        {
            <div class="ml-row" style="justify-content:center;margin-top:16px">
                <MudButton Variant="Variant.Outlined" OnClick="MoreAsync" Disabled="_loading" data-testid="load-more">Show more</MudButton>
            </div>
        }
    }
</div>

@code {
    private const int PageSize = 25;

    private List<NotificationDto> _items = [];
    private bool _unreadOnly;
    private bool _loading = true;
    private string? _error;
    private int _page = 1;
    private int _total;
    private int _unread;

    private string RowClass(NotificationDto item) => item.IsRead ? "ml-notification" : "ml-notification ml-notification--unread";

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsSignedIn)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        Notifications.Received += OnReceived;
        await ReloadAsync();
    }

    private void OnReceived(NotificationDto notification) => _ = InvokeAsync(async () => await ReloadAsync());

    private async Task SetFilterAsync(bool unreadOnly)
    {
        _unreadOnly = unreadOnly;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _page = 1;
        _items = [];
        await LoadPageAsync();
    }

    private async Task MoreAsync()
    {
        _page++;
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var page = await Http.GetFromJsonAsync<NotificationPageDto>($"api/v1/notifications?unreadOnly={_unreadOnly}&page={_page}&pageSize={PageSize}");
            if (page is not null)
            {
                _items.AddRange(page.Items);
                _total = page.Total;
                _unread = page.Unread;
                Notifications.SetUnread(page.Unread);
            }
        }
        catch (HttpRequestException)
        {
            _error = "We could not load your notifications. Check your connection and try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenAsync(NotificationDto item)
    {
        if (!item.IsRead)
        {
            await Http.PostAsync($"api/v1/notifications/{item.Id}/read", null);
            await Notifications.RefreshCountAsync();
        }

        if (item.Url is not null)
        {
            Nav.NavigateTo(item.Url);
        }
    }

    private async Task MarkAllAsync()
    {
        await Http.PostAsync("api/v1/notifications/read-all", null);
        await ReloadAsync();
    }

    public void Dispose() => Notifications.Received -= OnReceived;
}
