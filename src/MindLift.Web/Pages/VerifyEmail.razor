@page "/verify-email"
@layout AuthLayout
@inject HttpClient Http

<PageTitle>Confirm your email · MindLift</PageTitle>

<div class="ml-wizard" style="max-width:420px;margin-top:48px">
    <div class="ml-stack">
        <MudText Typo="Typo.h4" data-testid="page-title">Confirm your email</MudText>

        @if (_working)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (_ok)
        {
            <MudAlert Severity="Severity.Success" data-testid="verify-ok">Thank you. Your email address is confirmed.</MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Error" data-testid="verify-error">@_error</MudAlert>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Href="/" data-testid="primary-action">Continue to MindLift</MudButton>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Token { get; set; }

    private bool _working = true;
    private bool _ok;
    private string _error = "This link is not complete. Open the link from the email again.";

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token))
        {
            _working = false;
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync("api/v1/auth/verify-email", new VerifyEmailRequest(Email, Token));
            _ok = response.IsSuccessStatusCode;
            if (!_ok)
            {
                _error = await ProblemText.FromAsync(response, "This link has expired or was already used.");
            }
        }
        catch (HttpRequestException)
        {
            _error = "We could not reach MindLift. Check your connection and try again.";
        }
        finally
        {
            _working = false;
        }
    }
}
