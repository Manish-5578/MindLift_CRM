@page "/verify-email"
@layout AuthLayout
@inject HttpClient Http
@inject Translator T
@inject NavigationManager Nav

<PageTitle>@T["Confirm your email"] · MindLift</PageTitle>

<div class="ml-wizard" style="max-width:420px;margin-top:48px">
    <div class="ml-stack">
        <MudText Typo="Typo.h4" data-testid="page-title">@T["Confirm your email"]</MudText>

        @if (_working)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (_ok)
        {
            <MudAlert Severity="Severity.Success" data-testid="verify-ok">@T["Thank you. Your email address is confirmed."]</MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Error" data-testid="verify-error">@_error</MudAlert>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Href="/" data-testid="primary-action">@T["Continue to MindLift"]</MudButton>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Token { get; set; }

    private bool _working = true;
    private bool _ok;
    private string _error = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var email = Email;
        var token = Token;

        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(token))
        {
            _error = T["This link is not complete. Open the link from the email again."];
            _working = false;
            return;
        }

        Nav.NavigateTo("/verify-email", replace: true);

        try
        {
            var response = await Http.PostAsJsonAsync("api/v1/auth/verify-email", new VerifyEmailRequest(email, token));
            _ok = response.IsSuccessStatusCode;
            if (!_ok)
            {
                _error = await ProblemText.FromAsync(response, T["This link has expired or was already used."]);
            }
        }
        catch (HttpRequestException)
        {
            _error = T["We could not reach MindLift. Check your connection and try again."];
        }
        finally
        {
            _working = false;
        }
    }
}
