    private async Task OpenStageGates(PipelineDto pipeline, PipelineStageDto stage)
    {
        var parameters = new DialogParameters<StageGatesDialog>
        {
            { x => x.PipelineId, pipeline.Id },
            { x => x.StageId, stage.Id },
            { x => x.StageName, stage.Name },
            { x => x.Currency, App.Bootstrap?.Currencies.BaseCurrency ?? "USD" }
        };
        await Dialogs.ShowAsync<StageGatesDialog>(T["Stage Gates: {0}", stage.Name], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
    }
