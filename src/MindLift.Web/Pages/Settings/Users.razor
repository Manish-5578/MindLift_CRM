@page "/settings/users"
@inject HttpClient Http
@inject AppState App
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject Translator T


<PageTitle>@T["Users"] · MindLift</PageTitle>

<div class="ml-page ml-page--form">
    <PageHeader Title="Users" Subtitle="Add people, change roles and deactivate accounts.">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenAddUser" data-testid="primary-action">@T["Add user"]</MudButton>
        </Actions>
    </PageHeader>
    <SettingsNav Current="/settings/users" />

    @if (_loading)
    {
        <SkeletonTable Rows="6" Columns="4" />
    }
    else if (_users is null)
    {
        <ErrorState OnRetry="LoadAsync" />
    }
    else
    {
        @if (_pending is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3" data-testid="deactivate-confirm">
                @T["Deactivate {0}? They lose access straight away. Their records stay in the workspace.", _pending.FullName]
                <div class="ml-row" style="justify-content:flex-end;margin-top:8px">
                    <MudButton Size="Size.Small" OnClick="() => _pending = null">@T["Cancel"]</MudButton>
                    <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" OnClick="ConfirmDeactivateAsync">@T["Deactivate"]</MudButton>
                </div>
            </MudAlert>
        }
        <MlCard Flush="true">
            @foreach (var user in _users.Items)
            {
                <div class="ml-row ml-row--wrap" style="padding:12px 20px;border-bottom:1px solid var(--ml-border);min-height:56px" data-testid="row">
                    <UserAvatar Name="@user.FullName" Id="@user.Id" Size="32" />
                    <div class="ml-grow" style="min-width:0;overflow-wrap:anywhere">
                        <MudText Typo="Typo.subtitle2">@user.FullName</MudText>
                        <MudText Typo="Typo.caption" Class="ml-muted">@user.Email · @(user.RoleName ?? "No role")</MudText>
                    </div>
                    @if (user.MustChangePassword) { <StatusChip Text="Needs password reset" Color="@StatusColors.For("New")" /> }
                    @if (!user.IsActive) { <StatusChip Text="Inactive" Color="@StatusColors.For("Expired")" /> }
                    else if (user.IsTenantOwner) { <StatusChip Text="Owner" Color="@StatusColors.For("Won")" /> }
                    @if (user.IsActive && !user.IsTenantOwner && user.Id != App.Bootstrap!.User.UserId)
                    {
                        <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => _pending = user">@T["Deactivate"]</MudButton>
                    }
                </div>
            }
            @if (_users.Items.Count == 0)
            {
                <EmptyState Title="No users yet" Message="Add your team to get started." Compact="true" />
            }
        </MlCard>
    }
</div>

<FormDrawer Open="_invite" OpenChanged="v => _invite = v" Title="Add user" SubmitText="Add user" Busy="_busy" OnSubmit="AddUserAsync">
    <div class="ml-stack">
        <MudTextField @bind-Value="_email" Label="@T["Email *"]" InputType="InputType.Email" Variant="Variant.Outlined" Margin="Margin.Dense" data-testid="invite-email" />
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_first" Label="@T["First name *"]" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_last" Label="@T["Last name *"]" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        </MudGrid>
        <MudSelect T="Guid?" @bind-Value="_roleId" Label="@T["Role *"]" Variant="Variant.Outlined" Margin="Margin.Dense" data-testid="invite-role">
            @foreach (var role in _roles)
            {
                <MudSelectItem T="Guid?" Value="@role.Id">@role.Name</MudSelectItem>
            }
        </MudSelect>
        @if (_roles.Count == 0)
        {
            <MudAlert Severity="Severity.Warning" Dense="true">@T["No roles found in this workspace. Please create roles in Settings > Roles."]</MudAlert>
        }

        <div>
            <div class="ml-row" style="gap:8px;align-items:flex-start">
                <div class="ml-grow">
                    <PasswordInput @bind-Value="_password" Label="@T["Temporary password *"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Required="true"
                                   HelperText="@T["At least 8 chars (upper, lower, digit). The user must reset this on their first login."]"
                                   data-testid="invite-password" />
                </div>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="GeneratePassword"
                            StartIcon="@Icons.Material.Outlined.AutoFixHigh" Style="margin-top:4px">
                    @T["Generate"]
                </MudButton>
            </div>
        </div>

        @if (_error is not null) { <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert> }
    </div>
</FormDrawer>

@code {
    private PagedResult<UserListItem>? _users;
    private List<RoleDto> _roles = [];
    private bool _loading = true;
    private bool _invite;
    private bool _busy;
    private string _email = string.Empty;
    private string _first = string.Empty;
    private string _last = string.Empty;
    private string _password = string.Empty;
    private Guid? _roleId;
    private string? _error;

    private void OpenAddUser()
    {
        _error = null;
        _roleId ??= _roles.FirstOrDefault(r => r.Name == "Staff")?.Id ?? _roles.FirstOrDefault(r => r.Name == "Admin")?.Id ?? _roles.FirstOrDefault()?.Id;
        _invite = true;
        if (string.IsNullOrWhiteSpace(_password))
        {
            GeneratePassword();
        }
    }

    private void GeneratePassword()
    {
        const string uppers = "ABCDEFGHJKLMNPQRSTUVWXYZ";
        const string lowers = "abcdefghijkmnopqrstuvwxyz";
        const string digits = "23456789";
        const string specials = "!@#$%";
        var rnd = new Random();
        var chars = new List<char>
        {
            uppers[rnd.Next(uppers.Length)],
            lowers[rnd.Next(lowers.Length)],
            digits[rnd.Next(digits.Length)],
            specials[rnd.Next(specials.Length)]
        };
        const string all = uppers + lowers + digits + specials;
        for (int i = 0; i < 6; i++)
        {
            chars.Add(all[rnd.Next(all.Length)]);
        }
        _password = new string(chars.OrderBy(_ => rnd.Next()).ToArray());
    }

    protected override async Task OnInitializedAsync()
    {
        if (!App.IsAdmin)
        {
            Nav.NavigateTo("/");
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _users = await Http.GetFromJsonAsync<PagedResult<UserListItem>>("api/v1/users?pageSize=200");
            _roles = await Http.GetFromJsonAsync<List<RoleDto>>("api/v1/roles") ?? [];
            _roleId ??= _roles.FirstOrDefault(r => r.Name == "Staff")?.Id ?? _roles.FirstOrDefault(r => r.Name == "Admin")?.Id ?? _roles.FirstOrDefault()?.Id;
        }
        catch (HttpRequestException)
        {
            _users = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddUserAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_first) || string.IsNullOrWhiteSpace(_last) || string.IsNullOrWhiteSpace(_password) || _roleId is null)
        {
            _error = T["Fill in every field marked with *."];
            return;
        }

        _busy = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/v1/users",
                new CreateUserRequest(_email.Trim(), _first.Trim(), _last.Trim(), _roleId.Value, _password.Trim()));
            if (!response.IsSuccessStatusCode)
            {
                var fields = await ProblemText.FieldErrorsAsync(response);
                _error = fields.Count > 0 ? string.Join(" ", fields.Values) : await ProblemText.FromAsync(response, T["We could not add the user."]);
                return;
            }

            _invite = false;
            _email = _first = _last = _password = string.Empty;
            Snackbar.Add(T["User added successfully with temporary password. They must reset it upon first login."], Severity.Success);
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private UserListItem? _pending;

    private async Task ConfirmDeactivateAsync()
    {
        var user = _pending!;
        _pending = null;
        var response = await Http.PostAsync($"api/v1/users/{user.Id}/deactivate", JsonContent.Create(new DeactivateUserRequest(null)));
        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add(await ProblemText.FromAsync(response, T["Could not deactivate this user."]), Severity.Error);
            return;
        }

        Snackbar.Add(T["User deactivated"], Severity.Success);
        await LoadAsync();
    }
}
