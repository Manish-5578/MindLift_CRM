        "account-hierarchy" => "Multi-tier parent/child account tree & rollup calculations",
        "customer-health" => "Automated health scoring, NPS and CSAT survey ingress",
        "linkedin-lookup" => "One-click contact & company LinkedIn profile enrichment",
        "dashboard-widgets" => "Configurable KPI cards and dynamic chart widgets",
        "velocity-reports" => "Deal stage duration, conversion rates & funnel analytics",
        "leaderboards" => "Gamified sales rep rankings, podium medals & quotas",
