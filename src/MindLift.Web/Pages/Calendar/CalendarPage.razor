@page "/calendar"
@using System.Globalization
@inject HttpClient Http
@inject AuthSession Session
@inject AppState App
@inject NavigationManager Nav

<PageTitle>@App.ModuleLabel(AppModule.Calendar) · MindLift</PageTitle>

<div class="ml-page">
    <PageHeader Title="@App.ModuleLabel(AppModule.Calendar)" Subtitle="@RangeTitle">
        <Actions>
            <MudButton Variant="Variant.Outlined" OnClick="Today" data-testid="cal-today">Today</MudButton>
            <MudIconButton Icon="@Icons.Material.Outlined.ChevronLeft" OnClick="() => Shift(-7)" aria-label="Previous week" data-testid="cal-prev" />
            <MudIconButton Icon="@Icons.Material.Outlined.ChevronRight" OnClick="() => Shift(7)" aria-label="Next week" data-testid="cal-next" />
            <MudSwitch T="bool" Value="_mineOnly" ValueChanged="MineAsync" Label="Only mine" Color="Color.Primary" data-testid="cal-mine" />
        </Actions>
    </PageHeader>

    @if (_error is not null)
    {
        <ErrorState Message="@_error" OnRetry="LoadAsync" />
    }
    else if (_loading)
    {
        <SkeletonCards Count="3" />
    }
    else
    {
        <div class="ml-week" data-testid="cal-week">
            @foreach (var day in _days)
            {
                var current = day;
                <section class="ml-week__day" data-testid="@("cal-day-" + current.ToString("yyyy-MM-dd"))" aria-label="@current.ToString("dddd d MMMM", CultureInfo.InvariantCulture)">
                    <header class="ml-week__head">
                        <MudText Typo="Typo.subtitle2">@current.ToString("ddd d", CultureInfo.InvariantCulture)</MudText>
                        <MudText Typo="Typo.caption" Class="ml-muted">@current.ToString("MMM", CultureInfo.InvariantCulture)</MudText>
                    </header>
                    @foreach (var item in EventsOn(current))
                    {
                        var entry = item;
                        <a class="@EventClass(entry)" href="@(entry.Href ?? "#")" data-testid="cal-event" data-kind="@entry.Kind">
                            <span class="ml-week__time">@entry.StartUtc.ToString("HH:mm", CultureInfo.InvariantCulture)</span>
                            <span class="ml-truncate">@entry.Title</span>
                            @if (entry.LinkedName is not null)
                            {
                                <span class="ml-muted ml-truncate">@entry.LinkedName</span>
                            }
                        </a>
                    }
                    @if (!EventsOn(current).Any())
                    {
                        <MudText Typo="Typo.caption" Class="ml-faint">Nothing</MudText>
                    }
                </section>
            }
        </div>
        <MudText Typo="Typo.caption" Class="ml-muted" Style="margin-top:12px">Times are shown in UTC. Meetings are created from a record (Activities on a contact, lead, account or deal).</MudText>
    }
</div>

@code {
    private DateOnly _start;
    private List<DateOnly> _days = [];
    private List<CalendarEventDto> _events = [];
    private bool _loading = true;
    private bool _mineOnly = true;
    private string? _error;

    private string RangeTitle => _days.Count == 0 ? string.Empty : $"{_days[0]:d MMM} – {_days[^1]:d MMM yyyy}";

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsSignedIn)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        _start = today.AddDays(-(((int)today.DayOfWeek + 6) % 7));
        await LoadAsync();
    }

    private async Task Today()
    {
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        _start = today.AddDays(-(((int)today.DayOfWeek + 6) % 7));
        await LoadAsync();
    }

    private async Task Shift(int days)
    {
        _start = _start.AddDays(days);
        await LoadAsync();
    }

    private async Task MineAsync(bool value)
    {
        _mineOnly = value;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _days = Enumerable.Range(0, 7).Select(i => _start.AddDays(i)).ToList();
        try
        {
            var from = _start.ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc).ToString("yyyy-MM-ddTHH:mm:ssZ", CultureInfo.InvariantCulture);
            var to = _start.AddDays(7).ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc).ToString("yyyy-MM-ddTHH:mm:ssZ", CultureInfo.InvariantCulture);
            var url = $"api/v1/calendar/events?from={from}&to={to}";
            if (_mineOnly && Session.Me is { } me)
            {
                url += $"&userIds={me.UserId}";
            }

            _events = await Http.GetFromJsonAsync<List<CalendarEventDto>>(url) ?? [];
        }
        catch (HttpRequestException)
        {
            _error = "We could not load the calendar. Try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private IEnumerable<CalendarEventDto> EventsOn(DateOnly day)
        => _events.Where(e => DateOnly.FromDateTime(e.StartUtc) == day).OrderBy(e => e.StartUtc);

    private static string EventClass(CalendarEventDto e) => e.Kind switch
    {
        "booking" => "ml-week__event ml-week__event--booking",
        "task" => "ml-week__event ml-week__event--task",
        _ => "ml-week__event ml-week__event--meeting",
    };
}
