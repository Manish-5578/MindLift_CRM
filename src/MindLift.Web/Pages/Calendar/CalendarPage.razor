@page "/calendar"
@using System.Globalization
@using MindLift.Shared.Calendar
@inject HttpClient Http
@inject AuthSession Session
@inject AppState App
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject Translator T

<PageTitle>@T[App.ModuleLabel(AppModule.Calendar)] · MindLift</PageTitle>

<div class="ml-page">
    <PageHeader Title="@App.ModuleLabel(AppModule.Calendar)" Subtitle="@RangeTitle">
        <Actions>
            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small" data-testid="cal-views">
                <MudButton Color='@(_view == "day" ? Color.Primary : Color.Default)' OnClick='() => SetViewAsync("day")' data-testid="cal-view-day">@T["Day"]</MudButton>
                <MudButton Color='@(_view == "week" ? Color.Primary : Color.Default)' OnClick='() => SetViewAsync("week")' data-testid="cal-view-week">@T["Week"]</MudButton>
                <MudButton Color='@(_view == "month" ? Color.Primary : Color.Default)' OnClick='() => SetViewAsync("month")' data-testid="cal-view-month">@T["Month"]</MudButton>
            </MudButtonGroup>
            <MudButton Variant="Variant.Outlined" OnClick="Today" data-testid="cal-today">@T["Today"]</MudButton>
            <MudIconButton Icon="@Icons.Material.Outlined.ChevronLeft" OnClick="() => Shift(-1)" aria-label="@T["Previous"]" data-testid="cal-prev" />
            <MudIconButton Icon="@Icons.Material.Outlined.ChevronRight" OnClick="() => Shift(1)" aria-label="@T["Next"]" data-testid="cal-next" />
        </Actions>
    </PageHeader>

    <div class="ml-row ml-row--wrap" style="margin-bottom:16px">
        <MudSelect T="string" Value="_who" ValueChanged="WhoChangedAsync" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:220px" Label="@T["Show"]" data-testid="cal-who">
            <MudSelectItem T="string" Value="@("me")">@T["My calendar"]</MudSelectItem>
            <MudSelectItem T="string" Value="@("everyone")">@T["Everyone"]</MudSelectItem>
            @foreach (var user in _users)
            {
                <MudSelectItem T="string" Value="@user.Id.ToString()">@user.FullName</MudSelectItem>
            }
        </MudSelect>
    </div>

    @if (_error is not null)
    {
        <ErrorState Message="@_error" OnRetry="LoadAsync" />
    }
    else if (_loading)
    {
        <SkeletonCards Count="3" />
    }
    else if (_view == "month")
    {
        <div class="ml-month" data-testid="cal-month">
            @foreach (var name in new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" })
            {
                <div class="ml-month__head">@name</div>
            }
            @foreach (var day in _days)
            {
                var current = day;
                var dayEvents = EventsOn(current).ToList();
                <div class="@MonthCellClass(current)" data-testid="@("cal-day-" + current.ToString("yyyy-MM-dd"))" @ondragover:preventDefault="true" @ondrop="() => DropAsync(current)">
                    <div class="ml-month__date">@current.Day</div>
                    @foreach (var entry in dayEvents.Take(3))
                    {
                        <div class="@EventClass(entry)" draggable="true" data-testid="cal-event" data-kind="@entry.Kind" @ondragstart="() => _dragging = entry">
                            <span class="ml-truncate">@Formatting.Format(entry.StartUtc, "HH:mm", T) @entry.Title</span>
                        </div>
                    }
                    @if (dayEvents.Count > 3)
                    {
                        <div class="ml-muted">@T["+{0} more", dayEvents.Count - 3]</div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class='@(_view == "day" ? "ml-week ml-week--day" : "ml-week")' data-testid="cal-week">
            @foreach (var day in _days)
            {
                var current = day;
                <section class="ml-week__day" data-testid="@("cal-day-" + current.ToString("yyyy-MM-dd"))" aria-label="@Formatting.Format(current, "dddd d MMMM", T)"
                         @ondragover:preventDefault="true" @ondrop="() => DropAsync(current)">
                    <header class="ml-week__head">
                        <MudText Typo="Typo.subtitle2">@Formatting.Format(current, "ddd d", T)</MudText>
                        <MudText Typo="Typo.caption" Class="ml-muted">@Formatting.Format(current, "MMM", T)</MudText>
                    </header>
                    @foreach (var item in EventsOn(current))
                    {
                        var entry = item;
                        <a class="@EventClass(entry)" href="@(entry.Href ?? "#")" draggable="true" @ondragstart="() => _dragging = entry"
                           data-testid="cal-event" data-kind="@entry.Kind">
                            <span class="ml-week__time">@Formatting.Format(entry.StartUtc, "HH:mm", T)</span>
                            <span class="ml-truncate">@entry.Title</span>
                            @if (entry.LinkedName is not null)
                            {
                                <span class="ml-muted ml-truncate">@entry.LinkedName</span>
                            }
                        </a>
                    }
                    @if (!EventsOn(current).Any())
                    {
                        <MudText Typo="Typo.caption" Class="ml-faint">@T["Nothing"]</MudText>
                    }
                </section>
            }
        </div>
    }
    <MudText Typo="Typo.caption" Class="ml-muted" Style="margin-top:12px">@T["Times are UTC. Drag a meeting or task to another day to move it; it keeps its time. Meetings are created from a record."]</MudText>
</div>

@code {
    private string _view = "week";
    private DateOnly _anchor;
    private List<DateOnly> _days = [];
    private List<CalendarEventDto> _events = [];
    private List<UserListItem> _users = [];
    private string _who = "me";
    private bool _loading = true;
    private string? _error;
    private CalendarEventDto? _dragging;

    private string RangeTitle => _days.Count == 0 ? string.Empty
        : _view == "month" ? Formatting.Format(_anchor, "MMMM yyyy", T)
        : _view == "day" ? Formatting.Format(_anchor, "dddd d MMMM yyyy", T)
        : $"{_days[0]:d MMM} – {_days[^1]:d MMM yyyy}";

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsSignedIn)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        _anchor = DateOnly.FromDateTime(DateTime.UtcNow);
        _users = await RecordLookupsUsers();
        Rebuild();
        await LoadAsync();
    }

    private async Task<List<UserListItem>> RecordLookupsUsers()
    {
        try
        {
            var page = await Http.GetFromJsonAsync<PagedResult<UserListItem>>("api/v1/users?pageSize=200");
            return page?.Items.Where(u => u.IsActive).ToList() ?? [];
        }
        catch (HttpRequestException)
        {
            return [];
        }
    }

    /// <summary>The days shown for the view: one day, seven days from the week's Monday, or the six weeks around the month.</summary>
    private void Rebuild() => _days = CalendarGrid.Days(_view, _anchor).ToList();

    private async Task SetViewAsync(string view)
    {
        _view = view;
        Rebuild();
        await LoadAsync();
    }

    private async Task Today()
    {
        _anchor = DateOnly.FromDateTime(DateTime.UtcNow);
        Rebuild();
        await LoadAsync();
    }

    private async Task Shift(int step)
    {
        _anchor = CalendarGrid.Shift(_view, _anchor, step);
        Rebuild();
        await LoadAsync();
    }

    private async Task WhoChangedAsync(string value)
    {
        _who = value;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var (fromUtc, toUtc) = CalendarGrid.Range(_days);
            var from = Formatting.Format(fromUtc, "yyyy-MM-ddTHH:mm:ssZ", T);
            var to = Formatting.Format(toUtc, "yyyy-MM-ddTHH:mm:ssZ", T);
            var url = $"api/v1/calendar/events?from={from}&to={to}";
            if (_who == "everyone")
            {
                url += string.Concat(_users.Select(u => $"&userIds={u.Id}"));
            }
            else if (_who == "me")
            {
                if (Session.Me is { } me)
                {
                    url += $"&userIds={me.UserId}";
                }
            }
            else
            {
                url += $"&userIds={_who}";
            }

            _events = await Http.GetFromJsonAsync<List<CalendarEventDto>>(url) ?? [];
        }
        catch (HttpRequestException)
        {
            _error = T["We could not load the calendar. Try again."];
        }
        finally
        {
            _loading = false;
        }
    }

    private IEnumerable<CalendarEventDto> EventsOn(DateOnly day)
        => _events.Where(e => DateOnly.FromDateTime(e.StartUtc) == day).OrderBy(e => e.StartUtc);

    /// <summary>Drop a dragged meeting or task on a day: it moves to that day and keeps its time of day.</summary>
    private async Task DropAsync(DateOnly day)
    {
        var entry = _dragging;
        _dragging = null;
        if (entry is null || entry.Kind == "booking" || DateOnly.FromDateTime(entry.StartUtc) == day)
        {
            if (entry?.Kind == "booking")
            {
                Snackbar.Add(T["A booking moves from its meeting; move the meeting instead."], Severity.Info);
            }

            return;
        }

        var newStart = CalendarGrid.Moved(entry.StartUtc, day);
        var response = await Http.PatchAsJsonAsync($"api/v1/activities/{entry.Id}/schedule", new { StartAt = newStart, EndAt = (DateTime?)null });
        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add(await ProblemText.FromAsync(response, T["We could not move this item."]), Severity.Error);
            return;
        }

        Snackbar.Add($"Moved to {day:d MMM}", Severity.Success);
        await LoadAsync();
    }

    private string MonthCellClass(DateOnly day) => "ml-month__cell" + (CalendarGrid.IsOtherMonth(day, _anchor) ? " ml-month__cell--other" : string.Empty);

    private static string EventClass(CalendarEventDto e) => e.Kind switch
    {
        "booking" => "ml-week__event ml-week__event--booking",
        "task" => "ml-week__event ml-week__event--task",
        _ => "ml-week__event ml-week__event--meeting",
    };
}
