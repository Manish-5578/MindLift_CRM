@page "/deals/{Id:guid}"
@inject HttpClient Http
@inject AuthSession Session
@inject AppState App
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject Translator T

<PageTitle>@T["Deal"] · MindLift</PageTitle>

<div class="ml-page ml-page--narrow">
    @if (_loading)
    {
        <MlCard Loading="true" />
    }
    else if (_deal is null)
    {
        <ErrorState Title="We could not open this deal" Message="@(_error ?? "It may have been deleted, or you may not have access to it.")" OnRetry="LoadAsync" />
    }
    else
    {
        <RecordDetailLayout Title="@_deal.Name" Subtitle="@(_deal.AccountName ?? string.Empty)"
                            Breadcrumbs="@(new List<BreadcrumbItem> { new(App.ModuleLabel(AppModule.Deals), "/deals"), new(_deal.Name, null, true) })">
            <Badges>
                <StatusChip Text="@_deal.Status" Color="@StatusColors.For(_deal.Status == "Won" ? "Won" : _deal.Status == "Lost" ? "Lost" : "Working")" />
                @if (_deal.IsRotting) { <StatusChip Text="Rotting" Color="@StatusColors.For("Lost")" Dot="false" /> }
                <MoneyText Amount="_deal.Amount" Currency="@_deal.Currency" />
            </Badges>
            <Actions>
                @if (Can(p => p.CanDelete))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="DeleteAsync" data-testid="delete-deal">@T["Delete"]</MudButton>
                }
                @if (Can(p => p.CanEdit))
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenEdit" data-testid="primary-action">@T["Edit"]</MudButton>
                }
            </Actions>
            <ChildContent>
                <MlCard Title="Stage">
                    <div class="ml-row ml-row--wrap" data-testid="stage-bar">
                        @foreach (var stage in Stages)
                        {
                            var current = stage;
                            <MudButton Variant="@(current.Id == _deal.StageId ? Variant.Filled : Variant.Outlined)" Size="Size.Small"
                                       Color="@StageColor(current)" Disabled="@(!Can(p => p.CanEdit))"
                                       OnClick="() => MoveAsync(current)" data-testid="@("stage-" + current.Id)">@T.Pick(current.Name, current.NameAr)</MudButton>
                        }
                    </div>
                    <MudText Typo="Typo.caption" Class="ml-muted mt-2" data-testid="days-in-stage">@T["In this stage for {0} days", (int)(DateTime.UtcNow - _deal.StageChangedAtUtc).TotalDays]</MudText>
                    @if (!string.IsNullOrWhiteSpace(_stageMoveError))
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3" Variant="Variant.Outlined"
                                  ShowCloseIcon="true" CloseIconClicked="() => _stageMoveError = null" data-testid="stage-gating-alert">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Small" Color="Color.Warning" />
                                <div>
                                    <strong>@T["Stage Move Blocked:"]</strong> @_stageMoveError
                                </div>
                            </div>
                        </MudAlert>
                    }
                </MlCard>

                <MlCard Title="Details">
                    <div class="ml-kv" data-testid="deal-details">
                        <div class="ml-kv__label">@T["Amount"]</div><div class="ml-kv__value"><MoneyText Amount="_deal.Amount" Currency="@_deal.Currency" />@if (_deal.Currency != BaseCurrency) { <span class="ml-muted"> ≈ @_deal.AmountInBase.ToString("N0") @BaseCurrency</span> }</div>
                        <div class="ml-kv__label">@T["Probability"]</div><div class="ml-kv__value">@_deal.Probability%</div>
                        <div class="ml-kv__label">@T["Expected close"]</div><div class="ml-kv__value"><DateText Value="@_deal.ExpectedCloseDate" /></div>
                        <div class="ml-kv__label">@T["Forecast category"]</div>
                        <div class="ml-kv__value">
                            <MudMenu Dense="true" AnchorOrigin="Origin.BottomLeft" Disabled="@(!Can(p => p.CanEdit))">
                                <ActivatorContent>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                             Color="@ForecastCategoryColor(_deal.ForecastCategory)"
                                             Icon="@Icons.Material.Filled.ArrowDropDown"
                                             Style="cursor: pointer;">
                                        @ForecastCategoryLabel(_deal.ForecastCategory)
                                    </MudChip>
                                </ActivatorContent>
                                <ChildContent>
                                    @foreach (var cat in ForecastCategories.All)
                                    {
                                        <MudMenuItem OnClick="() => ChangeForecastCategoryAsync(cat)">
                                            @ForecastCategoryLabel(cat)
                                        </MudMenuItem>
                                    }
                                </ChildContent>
                            </MudMenu>
                        </div>
                        @if (_deal.ClosedAtUtc is not null)
                        {
                            <div class="ml-kv__label">@T["Closed"]</div><div class="ml-kv__value"><DateText Value="@_deal.ClosedAtUtc" /></div>
                        }
                        @if (_deal.LostReason is not null)
                        {
                            <div class="ml-kv__label">@T["Lost because"]</div><div class="ml-kv__value" data-testid="lost-reason-text">@LostReasonLabel(_deal.LostReason)@(string.IsNullOrWhiteSpace(_deal.LostNotes) ? "" : " — " + _deal.LostNotes)</div>
                        }
                        <div class="ml-kv__label">@T["Company"]</div><div class="ml-kv__value">@if (_deal.AccountId is { } accountId) { <a href="@("/accounts/" + accountId)" class="ml-link">@_deal.AccountName</a> } else { <span class="ml-faint">—</span> }</div>
                        <div class="ml-kv__label">@T["Owner"]</div><div class="ml-kv__value"><FieldValue Kind="FormFieldKind.User" Value="@_deal.OwnerId.ToString()" Users="_users" /></div>
                        <div class="ml-kv__label">@T["Notes"]</div><div class="ml-kv__value"><FieldValue Kind="FormFieldKind.Multiline" Value="@_deal.Description" /></div>
                        @foreach (var field in CustomFields)
                        {
                            <div class="ml-kv__label">@field.Label</div>
                            <div class="ml-kv__value"><FieldValue Value="@CustomText(field.Key)" /></div>
                        }
                    </div>
                </MlCard>

                @if (_lineItemsFeatureAvailable)
                {
                    <MlCard Title="Products & Line Items" TestId="deal-line-items-card">
                        <HeaderActions>
                            @if (Can(p => p.CanEdit))
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.AddShoppingCart"
                                           OnClick="OpenAddLineItemDialog" data-testid="add-line-item-btn">
                                    @T["Add Product / Item"]
                                </MudButton>
                            }
                        </HeaderActions>
                        <ChildContent>
                            @if (_lineItemsLoading)
                            {
                                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
                            }
                            else if (_lineItemsSummary is null || _lineItemsSummary.Items.Count == 0)
                            {
                                <div class="pa-4 text-center">
                                    <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Color="Color.Default" Style="font-size: 2.5rem; opacity: 0.5;" />
                                    <MudText Typo="Typo.body2" Class="ml-muted mt-2">
                                        @T["No products or line items added to this deal yet. Add items to track products and calculate the total."]
                                    </MudText>
                                </div>
                            }
                            else
                            {
                                <MudSimpleTable Dense="true" Hover="true" Elevation="0" Style="background: transparent;">
                                    <thead>
                                        <tr>
                                            <th>@T["Item / Product"]</th>
                                            <th style="text-align: right;">@T["Qty"]</th>
                                            <th style="text-align: right;">@T["Unit Price"]</th>
                                            <th style="text-align: right;">@T["Discount"]</th>
                                            <th style="text-align: right;">@T["Tax"]</th>
                                            <th style="text-align: right;">@T["Total"]</th>
                                            @if (Can(p => p.CanEdit))
                                            {
                                                <th style="width: 48px;"></th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in _lineItemsSummary.Items)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="d-flex flex-column">
                                                        <div class="d-flex align-center gap-2">
                                                            <span style="font-weight: 500;">@item.ProductName</span>
                                                            @if (!string.IsNullOrWhiteSpace(item.ProductSku))
                                                            {
                                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default" Class="pa-1" Style="font-size: 11px; height: 18px;">
                                                                    @item.ProductSku
                                                                </MudChip>
                                                            }
                                                        </div>
                                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                                        {
                                                            <MudText Typo="Typo.caption" Class="ml-muted">@item.Description</MudText>
                                                        }
                                                    </div>
                                                </td>
                                                <td style="text-align: right;">@item.Quantity.ToString("G29")</td>
                                                <td style="text-align: right;">@item.UnitPrice.ToString("N2") @_lineItemsSummary.Currency</td>
                                                <td style="text-align: right;">
                                                    @if (item.DiscountPercent > 0)
                                                    {
                                                        <span style="color: var(--mud-palette-error);">@item.DiscountPercent% (-@item.DiscountAmount.ToString("N2"))</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="ml-muted">—</span>
                                                    }
                                                </td>
                                                <td style="text-align: right;">
                                                    @if (item.TaxRate > 0)
                                                    {
                                                        <span>@item.TaxRate%</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="ml-muted">—</span>
                                                    }
                                                </td>
                                                <td style="text-align: right; font-weight: 600;">
                                                    @item.TotalAmount.ToString("N2") @_lineItemsSummary.Currency
                                                </td>
                                                @if (Can(p => p.CanEdit))
                                                {
                                                    <td style="text-align: center;">
                                                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error"
                                                                       OnClick="() => DeleteLineItemAsync(item.Id, item.ProductName)"
                                                                       data-testid="@($"delete-line-item-{item.Id}")" />
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>

                                <div class="d-flex justify-end mt-4 pt-3" style="border-top: 1px solid var(--mud-palette-divider);">
                                    <div style="min-width: 240px;" class="d-flex flex-column gap-1">
                                        <div class="d-flex justify-space-between text-caption">
                                            <span class="ml-muted">@T["Subtotal:"]</span>
                                            <span>@_lineItemsSummary.SubTotal.ToString("N2") @_lineItemsSummary.Currency</span>
                                        </div>
                                        @if (_lineItemsSummary.TotalDiscount > 0)
                                        {
                                            <div class="d-flex justify-space-between text-caption">
                                                <span class="ml-muted">@T["Total Discount:"]</span>
                                                <span style="color: var(--mud-palette-error);">-@_lineItemsSummary.TotalDiscount.ToString("N2") @_lineItemsSummary.Currency</span>
                                            </div>
                                        }
                                        @if (_lineItemsSummary.TotalTax > 0)
                                        {
                                            <div class="d-flex justify-space-between text-caption">
                                                <span class="ml-muted">@T["Total Tax:"]</span>
                                                <span>+@_lineItemsSummary.TotalTax.ToString("N2") @_lineItemsSummary.Currency</span>
                                            </div>
                                        }
                                        <div class="d-flex justify-space-between align-center pt-2 mt-1" style="border-top: 1px dashed var(--mud-palette-divider); font-weight: 600;">
                                            <span>@T["Grand Total:"]</span>
                                            <span style="color: var(--mud-palette-primary); font-size: 1.1rem;">
                                                @_lineItemsSummary.GrandTotal.ToString("N2") @_lineItemsSummary.Currency
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </ChildContent>
                    </MlCard>
                }

                @* Revenue Splits Card *@
                <MlCard Title="Revenue Splits" TestId="deal-splits-card">
                    <HeaderActions>
                        @if (Can(p => p.CanEdit))
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.CallSplit"
                                       OnClick="OpenManageSplitsDialog" data-testid="manage-splits-btn">
                                @T["Manage Splits"]
                            </MudButton>
                        }
                    </HeaderActions>
                    <ChildContent>
                        @if (_splitsLoading)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
                        }
                        else if (_splitsSummary is null || _splitsSummary.Splits.Count == 0)
                        {
                            <div class="pa-4 text-center">
                                <MudIcon Icon="@Icons.Material.Outlined.CallSplit" Color="Color.Default" Style="font-size: 2.2rem; opacity: 0.5;" />
                                <MudText Typo="Typo.body2" Class="ml-muted mt-1">
                                    @T["No split members configured. 100% credited to deal owner."]
                                </MudText>
                            </div>
                        }
                        else
                        {
                            <MudSimpleTable Dense="true" Hover="true" Elevation="0" Style="background: transparent;">
                                <thead>
                                    <tr>
                                        <th>@T["Team Member"]</th>
                                        <th>@T["Type"]</th>
                                        <th style="text-align: right;">@T["Percentage"]</th>
                                        <th style="text-align: right;">@T["Split Amount"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in _splitsSummary.Splits)
                                    {
                                        <tr>
                                            <td>
                                                <div style="font-weight: 500;">@s.UserName</div>
                                                @if (!string.IsNullOrWhiteSpace(s.Note)) { <div class="text-caption ml-muted">@s.Note</div> }
                                            </td>
                                            <td>
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(s.SplitType == "Revenue" ? Color.Primary : Color.Secondary)">
                                                    @s.SplitType
                                                </MudChip>
                                            </td>
                                            <td style="text-align: right; font-weight: 600;">@s.Percentage.ToString("G29")%</td>
                                            <td style="text-align: right; font-weight: 600;">@s.Amount.ToString("N2") @_splitsSummary.Currency</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                            @if (!_splitsSummary.IsValid)
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                                    @T["Total revenue splits do not equal 100% ({0}%). Click 'Manage Splits' to adjust.", _splitsSummary.TotalRevenuePercentage.ToString("G29")]
                                </MudAlert>
                            }
                        }
                    </ChildContent>
                </MlCard>

                @* Competitor Tracking Card *@
                <MlCard Title="Competitors" TestId="deal-competitors-card">
                    <HeaderActions>
                        @if (Can(p => p.CanEdit))
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Security"
                                       OnClick="OpenAddCompetitorDialog" data-testid="add-competitor-btn">
                                @T["Add Competitor"]
                            </MudButton>
                        }
                    </HeaderActions>
                    <ChildContent>
                        @if (_competitorsLoading)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
                        }
                        else if (_dealCompetitors.Count == 0)
                        {
                            <div class="pa-4 text-center">
                                <MudIcon Icon="@Icons.Material.Outlined.Shield" Color="Color.Default" Style="font-size: 2.2rem; opacity: 0.5;" />
                                <MudText Typo="Typo.body2" Class="ml-muted mt-1">
                                    @T["No competitors identified on this deal yet. Add competitors to track threat level and counter-strategy."]
                                </MudText>
                            </div>
                        }
                        else
                        {
                            <MudSimpleTable Dense="true" Hover="true" Elevation="0" Style="background: transparent;">
                                <thead>
                                    <tr>
                                        <th>@T["Competitor"]</th>
                                        <th>@T["Threat Level"]</th>
                                        <th>@T["Observed Intelligence"]</th>
                                        @if (Can(p => p.CanEdit))
                                        {
                                            <th style="width: 80px; text-align: center;">@T["Action"]</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in _dealCompetitors)
                                    {
                                        <tr>
                                            <td>
                                                <div style="font-weight: 600;">@c.CompetitorName</div>
                                                @if (!string.IsNullOrWhiteSpace(c.Website))
                                                {
                                                    <div class="text-caption"><a href="@c.Website" target="_blank" class="ml-link">@c.Website</a></div>
                                                }
                                            </td>
                                            <td>
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                                         Color="@(c.ThreatLevel == "High" ? Color.Error : c.ThreatLevel == "Medium" ? Color.Warning : Color.Info)">
                                                    @c.ThreatLevel
                                                </MudChip>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(c.StrengthsObserved))
                                                {
                                                    <div class="text-caption"><strong>@T["Strengths:"]</strong> @c.StrengthsObserved</div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(c.WeaknessesObserved))
                                                {
                                                    <div class="text-caption"><strong>@T["Gaps:"]</strong> @c.WeaknessesObserved</div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(c.Notes))
                                                {
                                                    <div class="text-caption ml-muted" style="font-style: italic;">@c.Notes</div>
                                                }
                                            </td>
                                            @if (Can(p => p.CanEdit))
                                            {
                                                <td style="text-align: center;">
                                                    <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Color="Color.Primary"
                                                                   OnClick="() => OpenEditDealCompetitorDialog(c)" />
                                                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error"
                                                                   OnClick="() => RemoveDealCompetitorAsync(c.CompetitorId, c.CompetitorName)" />
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        }
                    </ChildContent>
                </MlCard>

                <MlCard Title="Stage history">
                    <Timeline Items="HistoryItems()" EmptyText="No moves yet." />
                </MlCard>

                @if (_deal.Status == "Won")
                {
                    <MlCard Title="Onboarding" TestId="onboarding-card">
                        @if (_onboarding.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="ml-muted" data-testid="no-onboarding">@T["No onboarding checklist applies to this deal. Add one in Settings, Onboarding checklists."]</MudText>
                        }
                        @foreach (var progress in _onboarding)
                        {
                            <div class="ml-stack-sm" data-testid="onboarding-progress">
                                <div class="ml-row ml-row--between"><MudText Typo="Typo.subtitle2">@progress.TemplateName</MudText><MudText Typo="Typo.caption" Class="ml-muted" data-testid="onboarding-count">@T["{0} of {1} done", progress.Completed, progress.Total]</MudText></div>
                                <MudProgressLinear Color="Color.Success" Value="@(progress.Total == 0 ? 0 : 100.0 * progress.Completed / progress.Total)" />
                            </div>
                        }
                    </MlCard>
                }

                <RecordActivities @ref="_activities" DealId="Id" OnChanged="LoadAsync" />
                <RecordTimeline @ref="_timeline" EntityType="deals" EntityId="Id" />
                <RecordDocuments EntityType="deals" EntityId="Id" />
                <RecordFiles EntityType="deals" EntityId="Id" />
            </ChildContent>
            <Aside>
                <MlCard Title="@($"People ({_deal.Contacts.Count})")">
                    @if (_deal.Contacts.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="ml-muted">@T["No contacts on this deal."]</MudText>
                    }
                    @foreach (var contact in _deal.Contacts)
                    {
                        <div class="ml-row" style="padding:4px 0" data-testid="deal-contact-row">
                            <div class="ml-grow">
                                <a href="@("/contacts/" + contact.ContactId)" class="ml-link">@contact.FullName</a>
                                <MudText Typo="Typo.caption" Class="ml-muted">@(contact.Role ?? (contact.IsPrimary ? "Main contact" : "—"))</MudText>
                            </div>
                            @if (contact.IsPrimary) { <StatusChip Text="Main" Dot="false" /> }
                        </div>
                    }
                </MlCard>
            </Aside>
        </RecordDetailLayout>
    }
</div>

<DealFormDrawer @ref="_form" @bind-Open="_drawer" OnSaved="OnSaved" />

@code {
    private RecordTimeline? _timeline;

    private async Task ReloadTimelineAsync()
    {
        if (_timeline is not null)
        {
            await _timeline.ReloadAsync();
        }
    }
    [Parameter] public Guid Id { get; set; }

    private DealFormDrawer? _form;
    private RecordActivities? _activities;
    private bool _drawer;
    private bool _loading = true;
    private string? _error;
    private DealDto? _deal;
    private IReadOnlyList<DealStageHistoryDto> _history = [];
    private IReadOnlyList<OnboardingProgressDto> _onboarding = [];
    private List<UserListItem> _users = [];
    private bool _lineItemsLoading = false;
    private bool _lineItemsFeatureAvailable = false;
    private DealLineItemsSummaryDto? _lineItemsSummary;
    private string? _stageMoveError;
    private bool _splitsLoading;
    private DealSplitSummaryDto? _splitsSummary;
    private bool _competitorsLoading;
    private readonly List<DealCompetitorDto> _dealCompetitors = [];

    private Color ForecastCategoryColor(string cat) => cat switch
    {
        "Closed" => Color.Success,
        "Commit" => Color.Primary,
        "BestCase" => Color.Info,
        "Pipeline" => Color.Warning,
        _ => Color.Default
    };

    private string ForecastCategoryLabel(string cat) => cat switch
    {
        "Closed" => T["Closed"],
        "Commit" => T["Commit"],
        "BestCase" => T["Best Case"],
        "Pipeline" => T["Pipeline"],
        "Omitted" => T["Omitted"],
        _ => cat
    };

    private async Task ChangeForecastCategoryAsync(string newCategory)
    {
        try
        {
            var res = await Http.PutAsJsonAsync($"api/v1/forecasting/deals/{Id}/category", new UpdateDealForecastCategoryRequest(newCategory));
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add(T["Forecast category updated to {0}.", ForecastCategoryLabel(newCategory)], Severity.Success);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(await res.Content.ReadAsStringAsync(), Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task LoadSplitsAsync()
    {
        _splitsLoading = true;
        try
        {
            _splitsSummary = await Http.GetFromJsonAsync<DealSplitSummaryDto>($"api/v1/deals/{Id}/splits");
        }
        catch
        {
            _splitsSummary = null;
        }
        finally
        {
            _splitsLoading = false;
        }
    }

    private async Task OpenManageSplitsDialog()
    {
        var parameters = new DialogParameters<DealSplitsDialog>
        {
            { x => x.DealId, Id },
            { x => x.DealName, _deal?.Name ?? "" },
            { x => x.DealAmount, _deal?.Amount ?? 0m },
            { x => x.Currency, _deal?.Currency ?? "USD" },
            { x => x.DefaultOwnerId, _deal?.OwnerId ?? Guid.Empty },
            { x => x.Users, _users }
        };
        var dialog = await Dialogs.ShowAsync<DealSplitsDialog>(T["Deal Revenue Splits"], parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadSplitsAsync();
        }
    }

    private async Task LoadDealCompetitorsAsync()
    {
        _competitorsLoading = true;
        try
        {
            var list = await Http.GetFromJsonAsync<IReadOnlyList<DealCompetitorDto>>($"api/v1/deals/{Id}/competitors");
            _dealCompetitors.Clear();
            if (list is not null)
            {
                _dealCompetitors.AddRange(list);
            }
        }
        catch
        {
            _dealCompetitors.Clear();
        }
        finally
        {
            _competitorsLoading = false;
        }
    }

    private async Task OpenAddCompetitorDialog()
    {
        var parameters = new DialogParameters<DealCompetitorDialog>
        {
            { x => x.DealId, Id },
            { x => x.ExcludeCompetitorIds, _dealCompetitors.Select(c => c.CompetitorId).ToList() }
        };
        var dialog = await Dialogs.ShowAsync<DealCompetitorDialog>(T["Add Competitor to Deal"], parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadDealCompetitorsAsync();
        }
    }

    private async Task OpenEditDealCompetitorDialog(DealCompetitorDto existing)
    {
        var parameters = new DialogParameters<DealCompetitorDialog>
        {
            { x => x.DealId, Id },
            { x => x.Existing, existing }
        };
        var dialog = await Dialogs.ShowAsync<DealCompetitorDialog>(T["Edit Deal Competitor"], parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadDealCompetitorsAsync();
        }
    }

    private async Task RemoveDealCompetitorAsync(Guid competitorId, string competitorName)
    {
        if (!await Dialogs.ConfirmAsync(T["Remove Competitor"], T["Remove {0} from this deal?", competitorName], T["Remove"], danger: true))
        {
            return;
        }

        var res = await Http.DeleteAsync($"api/v1/deals/{Id}/competitors/{competitorId}");
        if (res.IsSuccessStatusCode)
        {
            Snackbar.Add(T["Competitor removed from deal."], Severity.Success);
            await LoadDealCompetitorsAsync();
        }
        else
        {
            Snackbar.Add(await res.Content.ReadAsStringAsync(), Severity.Error);
        }
    }

    private string BaseCurrency => App.Bootstrap?.Currencies.BaseCurrency ?? string.Empty;

    private IReadOnlyList<PipelineStageDto> Stages
        => App.Bootstrap?.Pipelines.FirstOrDefault(p => p.Id == _deal?.PipelineId)?.Stages.OrderBy(s => s.SortOrder).ToList() ?? [];

    private IReadOnlyList<FieldDto> CustomFields => App.Bootstrap?.Fields.GetValueOrDefault("deals")?.Where(f => f.IsCustom).ToList() ?? [];

    private bool Can(Func<ModulePermissionDto, bool> check) => App.Bootstrap?.Permissions.Any(p => p.Module == "Deals" && check(p)) == true;

    private Color StageColor(PipelineStageDto stage) => stage.StageType switch { "Won" => Color.Success, "Lost" => Color.Error, _ => Color.Primary };

    private string? CustomText(string key)
        => _deal!.CustomFields.TryGetValue(key, out var value) && value.ValueKind != JsonValueKind.Null ? value.ToString() : null;

    private string LostReasonLabel(string code)
        => App.PicklistLabel("lost_reason", code);

    protected override async Task OnParametersSetAsync()
    {
        if (!Session.IsSignedIn)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        _users = await RecordLookups.UsersAsync(Http);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var response = await Http.GetAsync($"api/v1/deals/{Id}");
            _deal = response.IsSuccessStatusCode ? await response.Content.ReadFromJsonAsync<DealDto>() : null;
            if (!response.IsSuccessStatusCode)
            {
                _error = await ProblemText.FromAsync(response, T["We could not open this deal."]);
            }
            else
            {
                _history = await Http.GetFromJsonAsync<List<DealStageHistoryDto>>($"api/v1/deals/{Id}/history") ?? [];
                _onboarding = _deal!.Status == "Won" ? await Http.GetFromJsonAsync<List<OnboardingProgressDto>>($"api/v1/activities/onboarding/{Id}") ?? [] : [];
                await LoadLineItemsAsync();
                await LoadSplitsAsync();
                await LoadDealCompetitorsAsync();
            }
        }
        catch (HttpRequestException)
        {
            _deal = null;
            _error = T["We could not reach MindLift. Check your connection and try again."];
        }
        finally
        {
            _loading = false;
        }
    }

    private IReadOnlyList<TimelineItem> HistoryItems()
        => _history.Select(h => new TimelineItem(h.ChangedAtUtc,
            h.FromStage is null ? T["Created in {0}", T.Pick(h.ToStage, h.ToStageAr)] : $"{T.Pick(h.FromStage, h.FromStageAr)} → {T.Pick(h.ToStage, h.ToStageAr)}",
            string.Join(" · ", new[] { h.ChangedBy, h.DaysInFromStage is { } days ? T["{0} days in {1}", days.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture), T.Pick(h.FromStage ?? string.Empty, h.FromStageAr)] : null }.Where(s => !string.IsNullOrWhiteSpace(s))),
            Icons.Material.Outlined.SwapHoriz)).ToList();

    private void OpenEdit()
    {
        _form?.OpenEdit(_deal!);
        _drawer = true;
    }

    private async Task OnSaved()
    {
        Snackbar.Add(T["Deal saved"], Severity.Success);
        await LoadAsync();
    }

    private async Task MoveAsync(PipelineStageDto stage)
    {
        if (stage.Id == _deal!.StageId)
        {
            return;
        }

        string? lostReason = null;
        string? lostNotes = null;
        if (stage.StageType == "Lost")
        {
            var reasons = App.Bootstrap?.Picklists.FirstOrDefault(p => p.Key == "lost_reason")?.Values.Where(v => v.IsActive).OrderBy(v => v.SortOrder).ToList() ?? [];
            var parameters = new DialogParameters<LostDealDialog> { { x => x.Title, $"Mark {_deal.Name} as lost?" }, { x => x.Reasons, reasons } };
            var reference = await Dialogs.ShowAsync<LostDealDialog>("Lost", parameters, new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, BackdropClick = false, CloseButton = false });
            var result = await reference.Result;
            if (result is not { Canceled: false } || result.Data is not LostDealDialog.Result lost)
            {
                return;
            }

            lostReason = lost.Reason;
            lostNotes = lost.Notes;
        }
        else if (stage.StageType == "Won" && !await Dialogs.ConfirmAsync($"Mark {_deal.Name} as won?", T["The close date is set to today."], T["Mark as won"]))
        {
            return;
        }

        var response = await Http.PatchAsJsonAsync($"api/v1/deals/{Id}/stage", new ChangeDealStageRequest(stage.Id, lostReason, lostNotes, null, _deal.Version));
        if (!response.IsSuccessStatusCode)
        {
            var problemMsg = await ProblemText.FromAsync(response, T["We could not move this deal."]);
            Snackbar.Add(problemMsg, Severity.Error);
            _stageMoveError = problemMsg;
        }
        else
        {
            _stageMoveError = null;
        }

        await LoadAsync();
        if (_activities is not null)
        {
            await _activities.LoadAsync();
        }

        await ReloadTimelineAsync();
    }

    private async Task DeleteAsync()
    {
        if (!await Dialogs.ConfirmAsync($"Delete {_deal!.Name}?", T["The deal is removed from your lists. This cannot be undone from here."], T["Delete"], danger: true))
        {
            return;
        }

        var response = await Http.DeleteAsync($"api/v1/deals/{Id}");
        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add(await ProblemText.FromAsync(response, T["We could not delete this deal."]), Severity.Error);
            return;
        }

        Snackbar.Add(T["Deal deleted"], Severity.Success);
        Nav.NavigateTo("/deals");
    }

    private async Task LoadLineItemsAsync()
    {
        _lineItemsLoading = true;
        try
        {
            var res = await Http.GetAsync($"api/v1/deals/{Id}/line-items");
            if (res.IsSuccessStatusCode)
            {
                _lineItemsSummary = await res.Content.ReadFromJsonAsync<DealLineItemsSummaryDto>();
                _lineItemsFeatureAvailable = true;
            }
            else if (res.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                _lineItemsFeatureAvailable = false;
                _lineItemsSummary = null;
            }
        }
        catch
        {
            _lineItemsFeatureAvailable = false;
            _lineItemsSummary = null;
        }
        finally
        {
            _lineItemsLoading = false;
        }
    }

    private async Task OpenAddLineItemDialog()
    {
        var parameters = new DialogParameters<DealLineItemDialog>
        {
            { x => x.DealId, Id },
            { x => x.Currency, _deal?.Currency ?? "USD" }
        };
        var reference = await Dialogs.ShowAsync<DealLineItemDialog>(T["Add Product or Line Item"], parameters);
        var result = await reference.Result;
        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task DeleteLineItemAsync(Guid lineItemId, string productName)
    {
        if (!await Dialogs.ConfirmAsync($"Remove {productName}?", T["This item will be removed and the deal amount will be recalculated."], T["Remove"], danger: true))
        {
            return;
        }

        var response = await Http.DeleteAsync($"api/v1/deals/{Id}/line-items/{lineItemId}");
        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add(T["Item removed"], Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(await ProblemText.FromAsync(response, T["Could not remove item."]), Severity.Error);
        }
    }
}
