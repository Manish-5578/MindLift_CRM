@page "/pay/{Token}"
@layout AuthLayout
@using MindLift.Shared.Contracts
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject Translator T
@inject IJSRuntime JS

<PageTitle>@(_checkout is not null ? $"{_checkout.Title} · {T["Checkout"]}" : T["Secure Checkout"]) · MindLift</PageTitle>

<div style="min-height: 100vh; background: var(--mud-palette-background-grey); padding: 32px 16px;">
    <div style="max-width: 680px; margin: 0 auto;">
        @if (_loading)
        {
            <div class="py-12 text-center">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                <div class="mt-3 text-caption ml-muted">@T["Securing checkout session..."]</div>
            </div>
        }
        else if (_checkout is null)
        {
            <MudPaper Class="pa-8 text-center" Elevation="1" Style="border-radius: 12px;">
                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Style="font-size: 3rem;" />
                <MudText Typo="Typo.h5" Class="mt-2" Style="font-weight: 700;">@T["Payment Link Unavailable"]</MudText>
                <MudText Typo="Typo.body2" Class="ml-muted mt-1">
                    @(_error ?? T["This payment link may have expired, been cancelled, or is invalid. Please contact the merchant for a new payment link."])
                </MudText>
            </MudPaper>
        }
        else if (_receipt is not null)
        {
            @* Payment Receipt / Confirmation View *@
            <MudPaper Class="pa-8 text-center" Elevation="2" Style="border-radius: 16px; border-top: 6px solid var(--mud-palette-success);">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Style="font-size: 4rem;" />
                <MudText Typo="Typo.h5" Class="mt-3" Style="font-weight: 700;">@T["Payment Successful!"]</MudText>
                <MudText Typo="Typo.body2" Class="ml-muted mt-1">
                    @T["Thank you. Your payment has been confirmed and credited to your account."]
                </MudText>

                <MudDivider Class="my-4" />

                <div class="d-flex flex-column gap-2 text-caption mx-auto" style="max-width: 380px; text-align: left;">
                    <div class="d-flex justify-space-between">
                        <span class="ml-muted">@T["Receipt Number:"]</span>
                        <strong>@_receipt.ReceiptNumber</strong>
                    </div>
                    <div class="d-flex justify-space-between">
                        <span class="ml-muted">@T["Payment Ref:"]</span>
                        <code>@_receipt.LinkNumber</code>
                    </div>
                    <div class="d-flex justify-space-between">
                        <span class="ml-muted">@T["Date & Time:"]</span>
                        <span>@_receipt.PaidAt.ToString("MMM dd, yyyy HH:mm UTC")</span>
                    </div>
                    <div class="d-flex justify-space-between">
                        <span class="ml-muted">@T["Method:"]</span>
                        <span>@_receipt.PaymentMethodUsed.ToUpperInvariant()</span>
                    </div>
                    <div class="d-flex justify-space-between align-center pt-2 mt-2" style="border-top: 1px dashed var(--mud-palette-divider);">
                        <span style="font-weight: 600;">@T["Amount Paid:"]</span>
                        <span style="font-weight: 800; font-size: 1.25rem; color: var(--mud-palette-success);">
                            @_receipt.Currency @_receipt.AmountPaid.ToString("N2")
                        </span>
                    </div>
                    @if (_receipt.RemainingBalance > 0)
                    {
                        <div class="d-flex justify-space-between text-caption pt-1" style="color: var(--mud-palette-warning);">
                            <span>@T["Remaining Balance:"]</span>
                            <strong>@_receipt.Currency @_receipt.RemainingBalance.ToString("N2")</strong>
                        </div>
                    }
                </div>

                <div class="mt-6">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintReceipt">
                        @T["Print Receipt"]
                    </MudButton>
                </div>
            </MudPaper>
        }
        else
        {
            @* Active Payment Form *@
            <MudPaper Class="pa-6" Elevation="2" Style="border-radius: 16px; border: 1px solid var(--mud-palette-divider);">
                <div class="d-flex justify-space-between align-center flex-wrap gap-2 pb-4" style="border-bottom: 1px solid var(--mud-palette-divider);">
                    <div class="d-flex align-center gap-3">
                        @if (!string.IsNullOrWhiteSpace(_checkout.CompanyLogoUrl))
                        {
                            <img src="@_checkout.CompanyLogoUrl" alt="Logo" style="max-height: 38px; max-width: 140px; object-fit: contain;" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Success" Size="Size.Small" />
                        }
                        <span style="font-weight: 700; font-size: 14px; text-transform: uppercase; letter-spacing: 0.5px;">@(!string.IsNullOrWhiteSpace(_checkout.CompanyName) ? _checkout.CompanyName : T["Secure Payment Portal"])</span>
                    </div>
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                        @_checkout.LinkNumber
                    </MudChip>
                </div>

                <div class="my-4">
                    <MudText Typo="Typo.h5" Style="font-weight: 700;">@_checkout.Title</MudText>
                    @if (!string.IsNullOrWhiteSpace(_checkout.Description))
                    {
                        <MudText Typo="Typo.body2" Class="ml-muted mt-1">@_checkout.Description</MudText>
                    }
                    @if (!string.IsNullOrWhiteSpace(_checkout.InvoiceNumber))
                    {
                        <div class="text-caption ml-muted mt-1">@T["Linked Invoice:"] <strong>@_checkout.InvoiceNumber</strong></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_checkout.QuoteNumber))
                    {
                        <div class="text-caption ml-muted mt-1">@T["Linked Proposal:"] <strong>@_checkout.QuoteNumber</strong></div>
                    }
                </div>

                @* Amount Callout *@
                <MudPaper Class="pa-4 mb-5" Elevation="0" Style="border-radius: 12px; background: var(--mud-palette-surface); border: 2px solid var(--mud-palette-primary);">
                    <div class="d-flex justify-space-between align-center">
                        <div>
                            <div class="text-caption ml-muted">@T["Total Due:"]</div>
                            <div class="text-h4" style="font-weight: 800; color: var(--mud-palette-primary);">
                                @_checkout.Currency @_checkout.RemainingAmount.ToString("N2")
                            </div>
                        </div>
                        @if (_checkout.PaidAmount > 0)
                        {
                            <div style="text-align: right;">
                                <div class="text-caption ml-muted">@T["Previously Paid:"]</div>
                                <div style="font-weight: 600; color: var(--mud-palette-success);">
                                    @_checkout.Currency @_checkout.PaidAmount.ToString("N2")
                                </div>
                            </div>
                        }
                    </div>

                    @if (_checkout.AllowPartial)
                    {
                        <div class="mt-3 pt-3" style="border-top: 1px dashed var(--mud-palette-divider);">
                            <MudNumericField @bind-Value="_payAmount" Label="@T["Custom Payment Amount"]"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" Min="1m" Max="@_checkout.RemainingAmount" Format="N2" />
                            <div class="text-caption ml-muted mt-1">@T["This merchant accepts partial payments towards this invoice." ]</div>
                        </div>
                    }
                </MudPaper>

                @* Payment Details Form *@
                <div class="d-flex flex-column gap-3">
                    <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">@T["Payment Information"]</MudText>

                    <MudTextField @bind-Value="_cardHolderName" Label="@T["Cardholder Full Name *"]"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="e.g. Jane Doe" Required="true" />

                    <MudTextField @bind-Value="_cardNumber" Label="@T["Card Number *"]"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="4532 •••• •••• 8891"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.CreditCard" Required="true" />

                    <div class="d-flex gap-3">
                        <MudTextField @bind-Value="_cardExpiry" Label="@T["Expires (MM/YY) *"]"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="MM/YY" Required="true" />

                        <MudTextField @bind-Value="_cardCvc" Label="@T["CVC / CVV *"]"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="123" InputType="InputType.Password" Required="true" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_payError))
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_payError</MudAlert>
                    }

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.Lock" FullWidth="true" Class="mt-4 py-3"
                               OnClick="ProcessPaymentAsync" Disabled="_processing">
                        @(_processing ? T["Processing Secure Payment..."] : T["Pay {0} {1}", _checkout.Currency, (_payAmount > 0 ? _payAmount : _checkout.RemainingAmount).ToString("N2")])
                    </MudButton>

                    <div class="d-flex justify-center align-center gap-2 mt-2 text-caption ml-muted">
                        <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small" />
                        <span>@T["256-bit encrypted checkout. PCI-DSS compliant payment processing."]</span>
                    </div>
                </div>
            </MudPaper>
        }
    </div>
</div>

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    private bool _loading = true;
    private string? _error;
    private PublicCheckoutDto? _checkout;
    private PaymentReceiptDto? _receipt;

    private decimal _payAmount;
    private string _cardHolderName = string.Empty;
    private string _cardNumber = string.Empty;
    private string _cardExpiry = string.Empty;
    private string _cardCvc = string.Empty;

    private bool _processing;
    private string? _payError;

    protected override async Task OnInitializedAsync()
    {
        await LoadCheckoutAsync();
    }

    private async Task LoadCheckoutAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _checkout = await Http.GetFromJsonAsync<PublicCheckoutDto>($"api/v1/payment-links/public/checkout/{Token}");
            if (_checkout is not null)
            {
                _payAmount = _checkout.RemainingAmount;
                _cardHolderName = _checkout.CustomerName ?? "";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ProcessPaymentAsync()
    {
        if (string.IsNullOrWhiteSpace(_cardHolderName))
        {
            _payError = T["Please enter the cardholder name."];
            return;
        }

        if (string.IsNullOrWhiteSpace(_cardNumber) || _cardNumber.Length < 12)
        {
            _payError = T["Please enter a valid card number."];
            return;
        }

        if (_payAmount <= 0)
        {
            _payError = T["Payment amount must be greater than zero."];
            return;
        }

        _processing = true;
        _payError = null;
        try
        {
            var rawDigits = new string(_cardNumber.Where(char.IsDigit).ToArray());
            var last4 = rawDigits.Length >= 4 ? rawDigits[^4..] : "4242";

            var req = new ProcessPaymentRequest
            {
                PaymentToken = Token,
                Amount = _payAmount,
                PaymentMethod = "card",
                CardHolderName = _cardHolderName.Trim(),
                CardLast4 = last4,
                Reference = $"CH_{Guid.NewGuid():N}"[..16].ToUpperInvariant()
            };

            var res = await Http.PostAsJsonAsync("api/v1/payment-links/public/pay", req);
            if (!res.IsSuccessStatusCode)
            {
                _payError = await res.Content.ReadAsStringAsync();
                return;
            }

            _receipt = await res.Content.ReadFromJsonAsync<PaymentReceiptDto>();
            Snackbar.Add(T["Payment processed successfully!"], Severity.Success);
        }
        catch (Exception ex)
        {
            _payError = ex.Message;
        }
        finally
        {
            _processing = false;
        }
    }

    private async Task PrintReceipt()
    {
        await JS.InvokeVoidAsync("print");
    }
}
