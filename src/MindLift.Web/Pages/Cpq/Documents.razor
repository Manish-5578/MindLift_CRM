@page "/documents"
@using MindLift.Shared.Contracts
@using MindLift.Shared.Enums
@using MindLift.UI.Components
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject Translator T

<PageTitle>@T["Documents & Smart OCR"] · MindLift</PageTitle>

<div class="ml-page">
    <!-- Header -->
    <div class="d-flex flex-wrap align-center justify-space-between gap-3 mb-4">
        <div>
            <MudText Typo="Typo.h5" Style="font-weight:700">@T["Documents & Smart OCR"]</MudText>
            <MudText Typo="Typo.body2" Class="ml-muted">@T["Upload contracts, customer proposals, vendor invoices, and track secure customer portal document requests."]</MudText>
        </div>

        <div class="d-flex flex-wrap align-center gap-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Outlined.AssignmentReturn" OnClick="OpenNewRequestDialog" Size="Size.Small">
                @T["Request Customer File"]
            </MudButton>
            <MudSelect T="string" Value="_uploadType" ValueChanged="v => _uploadType = v ?? string.Empty" Label="@T["Read as"]" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                       Style="min-width:200px" data-testid="upload-type">
                <MudSelectItem T="string" Value="@string.Empty">@T["Decide from the document"]</MudSelectItem>
                @foreach (var type in _types)
                {
                    <MudSelectItem T="string" Value="@type.Key">@type.Name</MudSelectItem>
                }
            </MudSelect>
            <MudFileUpload T="IBrowserFile" FilesChanged="UploadDocumentAsync" Accept=".pdf,.png,.jpg,.jpeg,.tif,.tiff,.webp,.bmp,.txt">
                <CustomContent Context="upload">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.CloudUpload" Disabled="_uploading" Size="Size.Small"
                               OnClick="@(() => upload.OpenFilePickerAsync())" id="upload-document">
                        @if (_uploading) { <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" /> }
                        @T["Upload Document"]
                    </MudButton>
                </CustomContent>
            </MudFileUpload>
        </div>
    </div>

    <!-- KPI Cards -->
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Outlined="true" Class="pa-3 d-flex align-center gap-3" Style="border-radius:12px">
                <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                    <MudIcon Icon="@Icons.Material.Outlined.FolderShared" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.caption" Class="ml-muted">@T["Total Documents"]</MudText>
                    <MudText Typo="Typo.h6" Style="font-weight:700">@_documents.Count</MudText>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Outlined="true" Class="pa-3 d-flex align-center gap-3" Style="border-radius:12px">
                <MudAvatar Color="Color.Success" Variant="Variant.Filled" Size="Size.Medium">
                    <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.caption" Class="ml-muted">@T["OCR Processed"]</MudText>
                    <MudText Typo="Typo.h6" Style="font-weight:700">@_documents.Count(d => d.OcrStatus == DocumentOcrStatus.Completed)</MudText>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Outlined="true" Class="pa-3 d-flex align-center gap-3" Style="border-radius:12px">
                <MudAvatar Color="Color.Info" Variant="Variant.Filled" Size="Size.Medium">
                    <MudIcon Icon="@Icons.Material.Outlined.PendingActions" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.caption" Class="ml-muted">@T["Open Portal Requests"]</MudText>
                    <MudText Typo="Typo.h6" Style="font-weight:700">@_requests.Count(r => r.Status == "Open")</MudText>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Outlined="true" Class="pa-3 d-flex align-center gap-3" Style="border-radius:12px">
                <MudAvatar Color="Color.Warning" Variant="Variant.Filled" Size="Size.Medium">
                    <MudIcon Icon="@Icons.Material.Outlined.Storage" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.caption" Class="ml-muted">@T["Total Storage"]</MudText>
                    <MudText Typo="Typo.h6" Style="font-weight:700">@FormatFileSize(_documents.Sum(d => d.FileSizeBytes))</MudText>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- Tab Navigation -->
    <MudTabs @bind-ActivePanelIndex="_activeTab" Rounded="true" Border="true" ApplyEffectsToContainer="true" Class="mb-4">
        <MudTabPanel Text="Documents & OCR" Icon="@Icons.Material.Outlined.FolderShared" />
        <MudTabPanel Text="Customer Portal Requests" Icon="@Icons.Material.Outlined.PendingActions" BadgeData="@_requests.Count(r => r.Status == "Open")" BadgeColor="Color.Warning" />
    </MudTabs>

    @if (_activeTab == 0)
    {
        <!-- Filters Bar -->
        <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-4 d-flex flex-wrap align-center justify-space-between gap-3" Style="border-radius:12px">
            <div class="d-flex flex-wrap align-center gap-2">
                <MudTextField @bind-Value="_searchQuery" Placeholder="@T["Search by file name, vendor, invoice #..."]" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Immediate="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="min-width:280px" />
                <MudSelect T="string" @bind-Value="_categoryFilter" Placeholder="@T["All Categories"]" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="min-width:160px">
                    <MudSelectItem T="string" Value="@("")">@T["All Categories"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Invoice")">@T["Invoice"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Contract")">@T["Contract"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Receipt")">@T["Receipt"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Identity")">@T["Identity"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@("General")">@T["General"]</MudSelectItem>
                    @foreach (var type in _types)
                    {
                        <MudSelectItem T="string" Value="@type.Key">@type.Name</MudSelectItem>
                    }
                </MudSelect>
            </div>
        </MudPaper>

        @if (_loading)
        {
            <SkeletonTable Rows="6" Columns="6" />
        }
        else if (FilteredDocuments.Count == 0)
        {
            <EmptyState Title="No documents found" Subtitle="@T["Upload your first business document to extract vendor names, totals, and invoice numbers."]" ActionLabel="Upload Document" />
        }
        else
        {
            <MudTable Items="@FilteredDocuments" Dense="true" Hover="true" Outlined="true" Style="border-radius:12px; overflow:hidden">
                <HeaderContent>
                    <MudTh>@T["File"]</MudTh>
                    <MudTh>@T["Category"]</MudTh>
                    <MudTh>@T["OCR Status"]</MudTh>
                    <MudTh>@T["Detected Intelligence"]</MudTh>
                    <MudTh>@T["Portal"]</MudTh>
                    <MudTh>@T["Upload Date"]</MudTh>
                    <MudTh Style="text-align:right">@T["Actions"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="File">
                        <div class="d-flex align-center gap-2">
                            <MudAvatar Color="@GetFileColor(context.ContentType)" Variant="Variant.Outlined" Size="Size.Small">
                                <MudIcon Icon="@GetFileIcon(context.ContentType)" Size="Size.Small" />
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.body2" Style="font-weight:600">@context.FileName</MudText>
                                <MudText Typo="Typo.caption" Class="ml-muted">@FormatFileSize(context.FileSizeBytes)</MudText>
                            </div>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Category">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                            @TypeName(context.Category)
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="OCR Status">
                        <MudChip T="string" Size="Size.Small" Color="@GetOcrColor(context)" Variant="Variant.Filled" data-testid="doc-ocr-status">
                            @StatusText(context)
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Intelligence">
                        @if (KeyFields(context).Count > 0)
                        {
                            <div class="d-flex flex-column gap-1" data-testid="doc-key-fields">
                                @foreach (var f in KeyFields(context))
                                {
                                    <MudText Typo="Typo.caption"><span class="ml-muted">@(string.IsNullOrWhiteSpace(f.Label) ? f.FieldName : f.Label):</span> <strong>@f.Value</strong></MudText>
                                }
                            </div>
                        }
                        else if (context.OcrResult != null && (!string.IsNullOrWhiteSpace(context.OcrResult.DetectedVendor) || !string.IsNullOrWhiteSpace(context.OcrResult.DetectedInvoiceNumber) || context.OcrResult.DetectedTotal.HasValue))
                        {
                            <div class="d-flex flex-column gap-1">
                                @if (!string.IsNullOrWhiteSpace(context.OcrResult.DetectedVendor))
                                {
                                    <MudText Typo="Typo.body2" Style="font-weight:600">@context.OcrResult.DetectedVendor</MudText>
                                }
                                <div class="d-flex align-center gap-2">
                                    @if (!string.IsNullOrWhiteSpace(context.OcrResult.DetectedInvoiceNumber))
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Style="font-size:0.75rem">#@context.OcrResult.DetectedInvoiceNumber</MudChip>
                                    }
                                    @if (context.OcrResult.DetectedTotal.HasValue)
                                    {
                                        <MudText Typo="Typo.caption" Style="font-weight:700; color:var(--mud-palette-success)">@context.OcrResult.DetectedTotal.Value.ToString("N2")</MudText>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="ml-muted">@T["No structured fields extracted"]</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Portal">
                        @{ var linked = context.AssociatedContactId.HasValue || context.AssociatedAccountId.HasValue; }
                        <MudTooltip Text="@T[linked ? SharingTooltip : UnlinkedTooltip]">
                            <MudSwitch T="bool" Value="context.SharedWithPortal" ValueChanged="@(v => SetSharingAsync(context, v))"
                                       Disabled="@(!linked || _sharingBusy.Contains(context.Id))" Color="Color.Info" Size="Size.Small"
                                       Label="@(context.SharedWithPortal ? SharedLabel : InternalLabel)" id="@($"share-{context.Id}")" />
                        </MudTooltip>
                    </MudTd>
                    <MudTd DataLabel="Date">
                        <MudText Typo="Typo.body2">@Formatting.Format(context.UploadedAt, "MMM dd, yyyy HH:mm", T)</MudText>
                    </MudTd>
                    <MudTd DataLabel="Actions" Style="text-align:right">
                        <div class="d-flex justify-end gap-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.RateReview" Href="@($"/documents/review/{context.Id}")">
                                @T["Review"]
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Visibility" OnClick="@(() => ViewDocumentDetails(context))">
                                @T["OCR Details"]
                            </MudButton>
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    }
    else
    {
        <!-- Customer Requests Table -->
        @if (_loadingRequests)
        {
            <SkeletonTable Rows="5" Columns="5" />
        }
        else if (_requests.Count == 0)
        {
            <EmptyState Title="No document requests" Subtitle="@T["Request compliance, tax, or contract files from your clients to receive them directly into MindLift."]" ActionLabel="New Request" OnAction="OpenNewRequestDialog" />
        }
        else
        {
            <MudTable Items="@_requests" Dense="true" Hover="true" Outlined="true" Style="border-radius:12px; overflow:hidden">
                <HeaderContent>
                    <MudTh>@T["Title"]</MudTh>
                    <MudTh>@T["Description"]</MudTh>
                    <MudTh>@T["Due Date"]</MudTh>
                    <MudTh>@T["Status"]</MudTh>
                    <MudTh>@T["Requested Date"]</MudTh>
                    <MudTh Style="text-align:right">@T["Action"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Title">
                        <MudText Typo="Typo.body2" Style="font-weight:600">@context.Title</MudText>
                    </MudTd>
                    <MudTd DataLabel="Description">
                        <MudText Typo="Typo.caption" Class="ml-muted">@(context.Description ?? "No instructions provided")</MudText>
                    </MudTd>
                    <MudTd DataLabel="Due Date">
                        @if (context.DueDate.HasValue)
                        {
                            var isOverdue = context.DueDate.Value < DateOnly.FromDateTime(DateTime.UtcNow) && context.Status == "Open";
                            <MudChip T="string" Size="Size.Small" Color="@(isOverdue ? Color.Error : Color.Default)" Variant="Variant.Outlined">
                                @Formatting.Format(context.DueDate.Value, "MMM dd, yyyy", T)
                            </MudChip>
                        }
                        else
                        {
                            <span class="ml-muted">@T["No deadline"]</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small" Color="@GetRequestStatusColor(context.Status)" Variant="Variant.Filled">
                            @context.Status
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Requested Date">
                        <MudText Typo="Typo.body2">@Formatting.Format(context.CreatedAt, "MMM dd, yyyy", T)</MudText>
                    </MudTd>
                    <MudTd DataLabel="Action" Style="text-align:right">
                        <div class="d-flex justify-end gap-1">
                            @if (context.Status == "Submitted")
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Outlined.CheckCircle"
                                           Disabled="_statusBusy" OnClick="@(() => SetRequestStatusAsync(context, Completed))">@T["Approve"]</MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Replay"
                                           Disabled="_statusBusy" OnClick="@(() => SetRequestStatusAsync(context, Open))">@T["Ask again"]</MudButton>
                            }
                            else if (context.Status == "Open")
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@T["Awaiting client"]</MudChip>
                                <MudIconButton Icon="@Icons.Material.Outlined.Cancel" Size="Size.Small" Color="Color.Error" aria-label="@T["Cancel request"]"
                                               Disabled="_statusBusy" OnClick="@(() => SetRequestStatusAsync(context, Cancelled))" />
                            }
                            else if (context.Status == "Cancelled")
                            {
                                <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="_statusBusy" OnClick="@(() => SetRequestStatusAsync(context, Open))">@T["Reopen"]</MudButton>
                            }
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    }
</div>

<!-- OCR Details Dialog -->
<MudDialog @bind-Visible="_detailsDialogOpen" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true })">
    <TitleContent>
        <div class="d-flex align-center justify-space-between">
            <MudText Typo="Typo.h6" Style="font-weight:700">@T["OCR Intelligence"] · @_activeDoc?.FileName</MudText>
            <MudChip T="string" Color="@GetOcrColor(_activeDoc?.OcrStatus ?? DocumentOcrStatus.Pending)" Size="Size.Small" Variant="Variant.Filled">
                @T[_activeDoc?.OcrStatus.ToString() ?? string.Empty]
            </MudChip>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_activeDoc is not null)
        {
            <MudGrid Spacing="2" Class="mb-3">
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-2" Style="border-radius:8px">
                        <MudText Typo="Typo.caption" Class="ml-muted">@T["Vendor Detected"]</MudText>
                        <MudText Typo="Typo.body2" Style="font-weight:600">@(_activeDoc.OcrResult?.DetectedVendor ?? "Not found")</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-2" Style="border-radius:8px">
                        <MudText Typo="Typo.caption" Class="ml-muted">@T["Invoice / Doc #"]</MudText>
                        <MudText Typo="Typo.body2" Style="font-weight:600">@(_activeDoc.OcrResult?.DetectedInvoiceNumber ?? "Not found")</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-2" Style="border-radius:8px">
                        <MudText Typo="Typo.caption" Class="ml-muted">@T["Extracted Total"]</MudText>
                        <MudText Typo="Typo.body2" Style="font-weight:600; color:var(--mud-palette-success)">@(_activeDoc.OcrResult?.DetectedTotal?.ToString("N2") ?? "Not found")</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <MudText Typo="Typo.subtitle2" Style="font-weight:700" Class="mb-1">@T["Extracted Text Content"]</MudText>
            <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-3" Style="background:var(--mud-palette-background-grey); border-radius:8px; max-height:220px; overflow-y:auto; font-family:monospace; font-size:0.85rem">
                @if (!string.IsNullOrWhiteSpace(_activeDoc.OcrResult?.ExtractedText))
                {
                    <pre style="white-space:pre-wrap; margin:0">@_activeDoc.OcrResult.ExtractedText</pre>
                }
                else
                {
                    <span class="ml-muted">@T["No text extracted."]</span>
                }
            </MudPaper>

            <div class="d-flex align-center justify-space-between">
                <MudText Typo="Typo.caption" Class="ml-muted">@T["Fields Extracted: {0}", _activeDoc.OcrResult?.ExtractedFields.Count ?? 0]</MudText>
                <MudText Typo="Typo.caption" Class="ml-muted">@T["Uploaded: {0}", Formatting.Format(_activeDoc.UploadedAt, "MMM dd, yyyy HH:mm", T)]</MudText>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _detailsDialogOpen = false)">@T["Close"]</MudButton>
        @if (_activeDoc is not null)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Refresh" OnClick="@(() => ReprocessOcrAsync(_activeDoc.Id))">
                @T["Re-process OCR"]
            </MudButton>
        }
    </DialogActions>
</MudDialog>

<!-- Request Customer File Dialog -->
<MudDialog @bind-Visible="_requestDialogOpen" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true })">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight:700">@T["Request Document from Customer"]</MudText>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column gap-3 py-2">
            <MudAutocomplete T="ContactListItemDto" @bind-Value="_newReqContact" SearchFunc="SearchContactsAsync" ToStringFunc="@(c => c is null ? string.Empty : ContactLabel(c))"
                             Label="@T["Customer contact"]" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" DebounceInterval="300" MinCharacters="1"
                             ResetValueOnEmptyText="true" AdornmentIcon="@Icons.Material.Outlined.Person" id="request-contact" />
            <MudTextField @bind-Value="_newReqTitle" Label="@T["Document Name / Title"]" Placeholder="@T["e.g. Valid Trade License 2026"]" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudTextField @bind-Value="_newReqDescription" Label="@T["Instructions for Customer"]" Lines="3" Placeholder="@T["Please ensure the trade license is valid for at least 6 months and stamped."]" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudDatePicker @bind-Date="_newReqDueDate" Label="@T["Due Date"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _requestDialogOpen = false)">@T["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitNewRequestAsync" Disabled="@(string.IsNullOrWhiteSpace(_newReqTitle) || _newReqContact is null || _submittingReq)">
            @if (_submittingReq) { <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" /> }
            @T["Send Request"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private int _activeTab = 0;
    private bool _loading = true;
    private bool _loadingRequests = false;
    private bool _uploading = false;
    private List<BusinessDocumentDto> _documents = [];
    private List<PortalDocumentRequestDto> _requests = [];

    private string _searchQuery = "";
    private string _categoryFilter = "";

    private bool _detailsDialogOpen = false;
    private BusinessDocumentDto? _activeDoc;

    private List<DocumentTypeChoiceDto> _types = [];
    private string _uploadType = string.Empty;
    private CancellationTokenSource? _cts;
    private bool _polling;

    // Document request dialog fields
    private bool _requestDialogOpen = false;
    private bool _submittingReq = false;
    private string _newReqTitle = "";
    private string _newReqDescription = "";
    private DateTime? _newReqDueDate = DateTime.Today.AddDays(14);
    private ContactListItemDto? _newReqContact;

    private bool _statusBusy;
    private readonly HashSet<Guid> _sharingBusy = [];

    // Constants keep string literals out of @(...) attribute expressions.
    private const string Completed = "Completed";
    private const string Open = "Open";
    private const string Cancelled = "Cancelled";
    private const string SharedLabel = "Shared";
    private const string InternalLabel = "Internal";
    private const string SharingTooltip = "Visible to the linked customer in their portal when on";
    private const string UnlinkedTooltip = "Link this document to a contact or account before sharing";

    private static string ContactLabel(ContactListItemDto c) =>
        string.IsNullOrWhiteSpace(c.Email) ? c.FullName : $"{c.FullName} · {c.Email}";

    private async Task<IEnumerable<ContactListItemDto>> SearchContactsAsync(string? text, CancellationToken ct)
    {
        try
        {
            var resp = await Http.PostAsJsonAsync("api/v1/contacts/query", new ListQuery(text, null, null, null, 1, 20), ct);
            if (!resp.IsSuccessStatusCode) return [];
            var page = await resp.Content.ReadFromJsonAsync<PagedResult<ContactListItemDto>>(cancellationToken: ct);
            return page?.Items ?? [];
        }
        catch (OperationCanceledException)
        {
            return [];
        }
    }

    private async Task SetRequestStatusAsync(PortalDocumentRequestDto request, string status)
    {
        _statusBusy = true;
        try
        {
            var resp = await Http.PostAsJsonAsync($"api/v1/document-requests/{request.Id}/status", new UpdateDocumentRequestStatusRequest(status));
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add(status switch
                {
                    Completed => T["Request approved. The customer's files are marked as reviewed."],
                    Cancelled => T["Request cancelled."],
                    _ => "Request reopened. The customer can upload again."
                }, Severity.Success);
                await LoadRequestsAsync();
                if (status == Completed) await LoadDocumentsAsync();
            }
            else
            {
                Snackbar.Add(T["Could not update the request."], Severity.Error);
            }
        }
        finally
        {
            _statusBusy = false;
        }
    }

    private async Task SetSharingAsync(BusinessDocumentDto doc, bool shared)
    {
        _sharingBusy.Add(doc.Id);
        try
        {
            var resp = await Http.PutAsJsonAsync($"api/v1/documents/{doc.Id}/portal-sharing", new SetDocumentSharingRequest(shared));
            if (resp.IsSuccessStatusCode)
            {
                doc.SharedWithPortal = shared;
                Snackbar.Add(shared ? T["Shared with the customer portal."] : T["Removed from the customer portal."], Severity.Success);
            }
            else
            {
                Snackbar.Add(T["Could not change portal sharing."], Severity.Error);
            }
        }
        finally
        {
            _sharingBusy.Remove(doc.Id);
        }
    }

    private List<BusinessDocumentDto> FilteredDocuments => _documents.Where(d =>
        (string.IsNullOrWhiteSpace(_searchQuery) ||
         d.FileName.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
         (d.OcrResult?.DetectedVendor != null && d.OcrResult.DetectedVendor.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)) ||
         (d.OcrResult?.DetectedInvoiceNumber != null && d.OcrResult.DetectedInvoiceNumber.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))) &&
        (string.IsNullOrWhiteSpace(_categoryFilter) || d.Category.Equals(_categoryFilter, StringComparison.OrdinalIgnoreCase))
    ).ToList();

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        await LoadTypesAsync();
        await LoadDocumentsAsync();
        await LoadRequestsAsync();
        StartPolling();
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    private async Task LoadTypesAsync()
    {
        try
        {
            _types = await Http.GetFromJsonAsync<List<DocumentTypeChoiceDto>>("api/v1/documents/types") ?? [];
        }
        catch (HttpRequestException)
        {
            _types = [];
        }
    }

    private string TypeName(string category) => _types.FirstOrDefault(t => t.Key == category)?.Name ?? category;

    private bool AnyReading => _documents.Any(d => d.Status is "Queued" or "Processing");

    /// <summary>While any document is waiting or being read, the list asks again every few seconds so each one updates by itself.</summary>
    private void StartPolling()
    {
        if (_polling || !AnyReading)
        {
            return;
        }

        _polling = true;
        var token = _cts?.Token ?? CancellationToken.None;
        _ = Task.Run(async () =>
        {
            try
            {
                while (!token.IsCancellationRequested)
                {
                    await Task.Delay(4000, token);
                    await InvokeAsync(async () =>
                    {
                        try
                        {
                            _documents = await Http.GetFromJsonAsync<List<BusinessDocumentDto>>("api/v1/documents") ?? _documents;
                        }
                        catch (HttpRequestException)
                        {
                            // Tried again on the next tick.
                        }

                        StateHasChanged();
                    });
                    if (!AnyReading)
                    {
                        return;
                    }
                }
            }
            catch (OperationCanceledException)
            {
                // The page was left.
            }
            finally
            {
                _polling = false;
            }
        }, token);
    }

    private static List<OcrExtractedFieldDto> KeyFields(BusinessDocumentDto doc)
        => doc.OcrResult?.ExtractedFields.Where(f => !string.IsNullOrWhiteSpace(f.Value) && !string.IsNullOrWhiteSpace(f.Key)).Take(3).ToList() ?? [];

    private string StatusText(BusinessDocumentDto doc) => doc.Status switch
    {
        "Queued" => T["Waiting to be read"],
        "Processing" => T["Reading…"],
        "Failed" => T["Failed"],
        _ => doc.OcrStatus.ToString(),
    };

    private static Color GetOcrColor(BusinessDocumentDto doc) => doc.Status switch
    {
        "Queued" => Color.Default,
        "Processing" => Color.Info,
        "Failed" => Color.Error,
        _ => doc.OcrStatus switch
        {
            DocumentOcrStatus.Completed => Color.Success,
            DocumentOcrStatus.Processing => Color.Info,
            DocumentOcrStatus.Failed => Color.Error,
            _ => Color.Default,
        },
    };

    private async Task LoadDocumentsAsync()
    {
        _loading = true;
        try
        {
            _documents = await Http.GetFromJsonAsync<List<BusinessDocumentDto>>("api/v1/documents") ?? [];
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load documents: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadRequestsAsync()
    {
        _loadingRequests = true;
        try
        {
            _requests = await Http.GetFromJsonAsync<List<PortalDocumentRequestDto>>("api/v1/document-requests") ?? [];
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load document requests: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingRequests = false;
        }
    }

    private void OpenNewRequestDialog()
    {
        _newReqTitle = "";
        _newReqDescription = "";
        _newReqDueDate = DateTime.Today.AddDays(14);
        _newReqContact = null;
        _requestDialogOpen = true;
    }

    private async Task SubmitNewRequestAsync()
    {
        if (string.IsNullOrWhiteSpace(_newReqTitle) || _newReqContact is null) return;
        _submittingReq = true;
        try
        {
            var req = new SaveDocumentRequest(
                ContactId: _newReqContact.Id,
                AccountId: _newReqContact.AccountId,
                DealId: null,
                Title: _newReqTitle.Trim(),
                Description: string.IsNullOrWhiteSpace(_newReqDescription) ? null : _newReqDescription.Trim(),
                DueDate: _newReqDueDate.HasValue ? DateOnly.FromDateTime(_newReqDueDate.Value) : null
            );

            var resp = await Http.PostAsJsonAsync("api/v1/document-requests", req);
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add(T["Document request published to customer portal!"], Severity.Success);
                _requestDialogOpen = false;
                await LoadRequestsAsync();
                _activeTab = 1;
            }
            else
            {
                Snackbar.Add(T["Failed to create document request."], Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _submittingReq = false;
        }
    }

    private static Color GetOcrColor(DocumentOcrStatus s) => s switch
    {
        DocumentOcrStatus.Completed => Color.Success,
        DocumentOcrStatus.Processing => Color.Info,
        DocumentOcrStatus.Failed => Color.Error,
        _ => Color.Default
    };

    private Color GetRequestStatusColor(string status) => status switch
    {
        "Submitted" => Color.Info,
        "Completed" => Color.Success,
        "Cancelled" => Color.Error,
        _ => Color.Warning
    };

    private Color GetFileColor(string ct) => ct switch
    {
        var x when x.Contains("pdf") => Color.Error,
        var x when x.Contains("image") => Color.Info,
        _ => Color.Primary
    };

    private string GetFileIcon(string ct) => ct switch
    {
        var x when x.Contains("pdf") => Icons.Material.Outlined.PictureAsPdf,
        var x when x.Contains("image") => Icons.Material.Outlined.Image,
