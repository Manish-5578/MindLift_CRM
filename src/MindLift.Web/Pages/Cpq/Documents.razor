    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F2} MB";
    }

    private async Task UploadDocumentAsync(IBrowserFile file)
    {
        if (file == null) return;
        _uploading = true;
        try
        {
            using var content = new MultipartFormDataContent();
            var streamContent = new StreamContent(file.OpenReadStream(10 * 1024 * 1024)); // 10MB limit
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType ?? "application/octet-stream");
            content.Add(streamContent, "file", file.Name);
            content.Add(new StringContent(string.IsNullOrEmpty(_uploadType) ? "General" : _uploadType), "category");

            var resp = await Http.PostAsync("api/v1/documents/upload", content);
            if (resp.IsSuccessStatusCode)
            {
                var doc = await resp.Content.ReadFromJsonAsync<BusinessDocumentDto>();

                // Upload only stores the file. Reading it can take a minute with AI, so it is queued and happens in the background.
                var queued = doc is null ? null : await Http.PostAsJsonAsync($"api/v1/documents/{doc.Id}/read", new ReadDocumentRequest(null));
                if (queued is { IsSuccessStatusCode: true })
                {
                    Snackbar.Add(string.Format(T["Document '{0}' uploaded. It is being read."], file.Name), Severity.Success);
                }
                else
                {
                    Snackbar.Add(string.Format(T["Document '{0}' uploaded, but reading it could not be started. Open it and use Read again."], file.Name), Severity.Warning);
                }

                await LoadDocumentsAsync();
                StartPolling();
            }
            else
            {
                var err = await resp.Content.ReadAsStringAsync();
                Snackbar.Add($"Upload error: {err}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Upload error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _uploading = false;
        }
    }

    private void ViewDocumentDetails(BusinessDocumentDto doc)
    {
        _activeDoc = doc;
        _detailsDialogOpen = true;
    }

    private async Task ReprocessOcrAsync(Guid id)
    {
        try
        {
            var resp = await Http.PostAsJsonAsync($"api/v1/documents/{id}/read", new ReadDocumentRequest(null));
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add(T["Reading started. This page updates when it is done."], Severity.Info);
                _detailsDialogOpen = false;
                await LoadDocumentsAsync();
                StartPolling();
            }
            else
            {
                Snackbar.Add(await ProblemText.FromAsync(resp, T["Failed to reprocess document."]), Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }
