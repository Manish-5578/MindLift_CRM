@page "/forgot-password"
@layout AuthLayout
@inject HttpClient Http

<PageTitle>Forgot password · MindLift</PageTitle>

<div class="ml-wizard" style="max-width:420px;margin-top:48px">
    <div class="ml-stack">
        <MudText Typo="Typo.h4" data-testid="page-title">Forgot your password?</MudText>
        <MudText Typo="Typo.body2" Class="ml-muted">Enter your email and we will send you a link to choose a new one.</MudText>

        @if (_sent)
        {
            <MudAlert Severity="Severity.Success" data-testid="forgot-sent">If that email belongs to an account, a link is on its way. It works for one hour.</MudAlert>
        }
        else
        {
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" data-testid="forgot-error">@_error</MudAlert>
            }

            <MudTextField @bind-Value="_email" Label="Email" Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Email" Required="true" OnKeyDown="OnKey" data-testid="forgot-email" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Disabled="_busy" OnClick="SendAsync" data-testid="primary-action">Send the link</MudButton>
        }

        <MudText Typo="Typo.body2" Class="ml-muted"><MudLink Href="/login" Class="ml-link">Back to sign in</MudLink></MudText>
    </div>
</div>

@code {
    private string _email = string.Empty;
    private string? _error;
    private bool _busy;
    private bool _sent;

    private async Task OnKey(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") await SendAsync();
    }

    private async Task SendAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_email) || !_email.Contains('@'))
        {
            _error = "Enter the email you signed up with.";
            return;
        }

        _busy = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/v1/auth/forgot-password", new ForgotPasswordRequest(_email.Trim()));
            if (!response.IsSuccessStatusCode)
            {
                _error = await ProblemText.FromAsync(response, "We could not send the link. Try again.");
                return;
            }

            _sent = true;
        }
        catch (HttpRequestException)
        {
            _error = "We could not reach MindLift. Check your connection and try again.";
        }
        finally
        {
            _busy = false;
        }
    }
}
