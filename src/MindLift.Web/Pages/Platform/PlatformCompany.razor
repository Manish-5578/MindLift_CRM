@page "/platform/companies/{Id:guid}"
@layout PlatformLayout
@inject Translator T
@inject HttpClient Http
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>@(_d?.Company.Name ?? "Company") · MindLift platform</PageTitle>

<a class="pc-back" href="/platform/companies"><MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />@T["All companies"]</a>

@if (_notFound)
{
    <div class="pc-card pc-empty" data-testid="company-missing">
        <div class="pc-empty__art"><MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" /></div>
        <h3 style="margin:0">@T["That company does not exist"]</h3>
    </div>
}
else if (_d is null)
{
    <div class="pc-skel" style="height:170px;margin-bottom:24px"></div>
    <div class="pc-skel" style="height:360px"></div>
}
else
{
    var c = _d.Company;
    <section class="pc-hero pc-rise" data-testid="company-hero">
        <div class="pc-hero__bg" style="background:@Pc.Gradient(c.Name)"></div>
        <div class="pc-hero__in">
            <PcAvatar Name="@c.Name" Size="84" />
            <div style="min-width:0">
                <h1 data-testid="company-name">@c.Name</h1>
                <div class="pc-hero__meta">
                    <PcStatusPill Status="@c.Status" />
                    <span class="pc-chip">@c.PlanName plan</span>
                    <span class="pc-chip">@c.Slug</span>
                    @if (c.Country is { Length: > 0 }) { <span class="pc-chip">@c.Country</span> }
                    @if (c.Industry is { Length: > 0 }) { <span class="pc-chip">@c.Industry</span> }
                </div>
            </div>
            <div class="pc-hero__right">
                <div style="text-align:center">
                    <PcRing Value="c.Health" Size="72" Color="#fff" Title="@T["Health score"]" />
                    <div style="font-size:11px;opacity:.85;margin-top:4px;font-weight:650">@T["HEALTH"]</div>
                </div>
                <button class="pc-btn" @onclick="() => _supportOpen = true" data-testid="support-open"><MudIcon Icon="@Icons.Material.Filled.SupportAgent" Size="Size.Small" />@T["Support view"]</button>
                <div style="position:relative">
                    <button class="pc-btn" @onclick="() => _statusOpen = !_statusOpen" data-testid="status-menu"><MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" />@T["Status"]</button>
                    @if (_statusOpen)
                    {
                        <div class="pc-search__panel" style="inset-inline-start:auto;inset-inline-end:0;min-width:190px;top:46px;color:var(--pc-text)">
                            @foreach (var status in Statuses)
                            {
                                var st = status;
                                <div class="pc-search__item" style="@(st == c.Status ? "opacity:.45;pointer-events:none" : "")" @onclick="() => ChangeStatusAsync(st)" data-testid="set-status-@st">@Pc.StatusLabel(st)</div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    @if (_supportOpen)
    {
        <div class="pc-slide" data-testid="support-panel">
            <div class="pc-slide__scrim" @onclick="() => _supportOpen = false"></div>
            <div class="pc-slide__panel">
                <div class="pc-slide__head"><div class="pc-card__title" style="font-size:18px">Support view of @c.Name</div><button class="pc-btn pc-btn--icon pc-btn--ghost" @onclick="() => _supportOpen = false" aria-label="@T["Close"]"><MudIcon Icon="@Icons.Material.Filled.Close" /></button></div>
                <div class="pc-slide__body">
                    <div class="pc-card__hint">@T["You will see the workspace as its owner sees it, in a new tab, for up to 30 minutes. It is read-only: nothing can be changed. Your reason, and every page you look at, is recorded in the audit trail."]</div>
                    <div class="pc-field"><label for="support-reason">@T["Why do you need to look?"]</label><textarea id="support-reason" class="pc-textarea" style="min-height:90px" @bind="_supportReason" @bind:event="oninput" placeholder="@T["For example: the customer says the lead list is empty"]" data-testid="support-reason"></textarea></div>
                </div>
                <div class="pc-slide__foot">
                    <button class="pc-btn" @onclick="() => _supportOpen = false">@T["Cancel"]</button>
                    <button class="pc-btn pc-btn--primary" disabled="@((_supportReason ?? "").Trim().Length < 5 || _saving)" @onclick="StartSupportAsync" data-testid="support-start-button">@T["Open support view"]</button>
                </div>
            </div>
        </div>
    }

    <div class="pc-tabs" role="tablist" data-testid="company-tabs">
        <button role="tab" class="@Tab("overview")" @onclick='() => _tab = "overview"' data-testid="tab-overview"><MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Small" />@T["Overview"]</button>
        <button role="tab" class="@Tab("modules")" @onclick='() => _tab = "modules"' data-testid="tab-modules"><MudIcon Icon="@Icons.Material.Filled.Widgets" Size="Size.Small" />@T["Modules"] <span class="pc-chip pc-chip--brand">@(ModulesOn)/@(Switchable.Count + CoreCount)</span></button>
        <button role="tab" class="@Tab("plan")" @onclick='() => _tab = "plan"' data-testid="tab-plan"><MudIcon Icon="@Icons.Material.Filled.Diamond" Size="Size.Small" />@T["Plan & limits"]</button>
        <button role="tab" class="@Tab("billing")" @onclick="OpenBillingAsync" data-testid="tab-billing"><MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Small" />@T["Billing"]</button>
        <button role="tab" class="@Tab("data")" @onclick="OpenDataAsync" data-testid="tab-data"><MudIcon Icon="@Icons.Material.Filled.Storage" Size="Size.Small" />@T["Data"]</button>
        <button role="tab" class="@Tab("history")" @onclick='() => _tab = "history"' data-testid="tab-history"><MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" />@T["History"]</button>
    </div>

    @if (_tab == "overview")
    {
        <div class="pc-grid pc-grid--kpi">
            <PcKpi ShowZero="true" Index="0" Label="@T["Users"]" Value="c.Users" Icon="@Icons.Material.Filled.Groups" Solid="#6366F1"><Foot>@c.ActiveUsers7d signed in this week</Foot></PcKpi>
            <PcKpi ShowZero="true" Index="1" Label="@T["Leads and contacts"]" Value="c.Leads + c.Contacts" Icon="@Icons.Material.Filled.Contacts" Solid="#06B6D4"><Foot>@c.Leads leads · @c.Contacts contacts</Foot></PcKpi>
            <PcKpi ShowZero="true" Index="2" Label="@T["Accounts and deals"]" Value="c.Accounts + c.Deals" Icon="@Icons.Material.Filled.Handshake" Solid="#10B981"><Foot>@c.Accounts accounts · @c.Deals deals</Foot></PcKpi>
            <PcKpi ShowZero="true" Index="3" Label="@T["Documents"]" Value="c.Documents" Icon="@Icons.Material.Filled.DocumentScanner" Solid="#F59E0B"><Foot>@(c.AiAllowed ? (c.AiEnabled ? "AI reading is on" : "AI reading is allowed") : "AI reading is off")</Foot></PcKpi>
        </div>
        <div class="pc-grid pc-grid--two">
            <div class="pc-card pc-rise">
                <div class="pc-card__head"><div class="pc-card__title">@T["Usage against the plan"]</div></div>
                <div class="pc-meter" style="margin-bottom:26px">
                    <div class="pc-meter__top"><span class="pc-card__hint">@T["People"]</span><b class="pc-num">@c.Users <small style="font-size:14px;color:var(--pc-text-3)">of @_d.MaxUsers</small></b></div>
                    <div class="pc-bar @(Pct(c.Users, _d.MaxUsers) >= 90 ? "pc-bar--warn" : "")"><i style="width:@Pct(c.Users, _d.MaxUsers)%"></i></div>
                </div>
                <div class="pc-meter">
                    <div class="pc-meter__top"><span class="pc-card__hint">@T["Records"]</span><b class="pc-num">@Pc.Num(_d.Records) <small style="font-size:14px;color:var(--pc-text-3)">of @Pc.Num(_d.MaxRecords)</small></b></div>
                    <div class="pc-bar @(Pct(_d.Records, _d.MaxRecords) >= 90 ? "pc-bar--warn" : "")"><i style="width:@Pct(_d.Records, _d.MaxRecords)%"></i></div>
                </div>
            </div>
            <div class="pc-card pc-rise" style="--i:1">
                <div class="pc-card__head"><div class="pc-card__title">@T["About this company"]</div></div>
                <div class="pc-kv"><span>@T["Owner"]</span><span>@(_d.OwnerName ?? "-")@(_d.OwnerEmail is null ? "" : " · " + _d.OwnerEmail)</span></div>
                <div class="pc-kv"><span>@T["Joined"]</span><span>@Pc.Date(c.CreatedAt)</span></div>
                <div class="pc-kv"><span>@T["Last signed in"]</span><span>@Pc.Ago(c.LastActiveAt)</span></div>
                @if (c.Status == "Trial") { <div class="pc-kv"><span>@T["Trial ends"]</span><span>@Pc.Date(c.TrialEndsAt)</span></div> }
                <div class="pc-kv"><span>@T["Modules"]</span><span>@c.ModulesEnabled of @c.ModulesTotal available to them</span></div>
                @if (_d.TenantDisabledModules.Count > 0)
                {
                    <div class="pc-kv"><span>@T["Hidden by their own admin"]</span><span>@string.Join(", ", _d.TenantDisabledModules)</span></div>
                }
            </div>
        </div>
    }
    else if (_tab == "modules")
    {
        <div class="pc-card pc-rise" style="margin-bottom:22px">
            <div class="pc-mods__head">
                <PcRing Value="ModulesPct" Size="76" Color="#6366F1" Title="@T["Share of modules switched on"]" />
                <div style="flex:1;min-width:220px">
                    <div class="pc-card__title" style="font-size:18px" data-testid="modules-summary">@ModulesOn of @(Switchable.Count + CoreCount) modules are on for @c.Name</div>
                    <div class="pc-card__hint" style="margin-top:4px">@T["A module you switch off disappears from this company and its API refuses it straight away. Core modules are always on. A module left out of the plan can only be added by changing the plan."]</div>
                </div>
                <input class="pc-input" style="min-width:220px" placeholder="@T["Find a module"]" @bind="_find" @bind:event="oninput" data-testid="module-find" />
            </div>
            <div class="pc-presets" data-testid="presets">
                <span class="pc-card__hint" style="align-self:center;margin-inline-end:4px">@T["Start from"]</span>
                @foreach (var p in _presets)
                {
                    var preset = p;
                    <button class="pc-preset" title="@preset.Description" @onclick="() => ApplyPreset(preset)" data-testid="preset-@preset.Key">@preset.Name</button>
                }
            </div>
        </div>

        @foreach (var group in ModuleCatalogGroups())
        {
            <div class="pc-mods__cat">@group.Key</div>
            <div class="pc-mods__grid">
                @foreach (var m in group)
                {
                    var module = m;
                    var on = IsOn(module);
                    var changed = Changed(module);
                    var planOff = PlanOff(module);
                    var locked = module.Core || planOff;
                    var soon = !module.Available;
                    <button type="button" class="pc-mod @(on ? "is-on" : "") @(changed ? "is-changed" : "") @(locked ? "is-locked" : "") @(soon ? "is-soon" : "")"
                            disabled="@(locked || soon)" @onclick="() => Toggle(module)" data-testid="module-@module.Key" aria-pressed="@(on ? "true" : "false")">
                        <span class="pc-mod__icon"><MudIcon Icon="@Pc.Icon(module.Icon)" /></span>
                        <span style="min-width:0;flex:1">
                            <span class="pc-mod__name" style="display:block">@module.Name</span>
                            <span class="pc-mod__desc" style="display:block">@module.Description</span>
                            @if (soon) { <span class="pc-mod__tag">@T["Coming soon"]</span> }
                            else if (planOff) { <span class="pc-mod__tag pc-mod__tag--warn">Not in the @c.PlanName plan</span> }
                            else if (locked) { <span class="pc-mod__tag">@T["Always on"]</span> }
                            else if (TenantOff(module)) { <span class="pc-mod__tag pc-mod__tag--warn">@T["Hidden by their admin"]</span> }
                        </span>
                        @if (!locked && !soon) { <span class="pc-switch"></span> }
                    </button>
                }
            </div>
        }

        @if (Dirty)
        {
            <div class="pc-savebar" data-testid="save-bar" role="status">
                <div class="pc-savebar__text">
                    <b>@(_off.Except(_savedOff).Count() + _savedOff.Except(_off).Count()) unsaved change@(_off.Except(_savedOff).Count() + _savedOff.Except(_off).Count() == 1 ? "" : "s")</b>
                    <div>@DiffText</div>
                </div>
                <button class="pc-btn pc-btn--ghost" @onclick="Discard" data-testid="discard">@T["Discard"]</button>
                <button class="pc-btn pc-btn--primary" @onclick="SaveModulesAsync" disabled="@_saving" data-testid="save-modules"><MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />@(_saving ? "Saving" : "Save modules")</button>
            </div>
        }
    }
    else if (_tab == "plan")
    {
        <div class="pc-plans" style="margin-bottom:24px" data-testid="plan-cards">
            @foreach (var p in _plans.Where(p => p.IsActive || p.Key == c.PlanKey))
            {
                var plan = p;
                <div class="pc-card pc-plan pc-interactive @(plan.Key == c.PlanKey ? "is-current" : "")" @onclick="() => ChangePlanAsync(plan)" data-testid="plan-@plan.Key">
                    @if (plan.Key == c.PlanKey) { <div class="pc-plan__ribbon">@T["Current"]</div> }
                    <div class="pc-card__title" style="font-size:18px">@plan.Name</div>
                    <div class="pc-plan__price pc-num">@Pc.Money(plan.PriceMonthly)<small> / month</small></div>
                    <ul>
                        <li><MudIcon Icon="@Icons.Material.Filled.CheckCircle" />@plan.MaxUsers users</li>
                        <li><MudIcon Icon="@Icons.Material.Filled.CheckCircle" />@Pc.Num(plan.MaxRecords) records</li>
                        <li><MudIcon Icon="@Icons.Material.Filled.CheckCircle" />@plan.Companies companies on it</li>
                    </ul>
                </div>
            }
        </div>

        <div class="pc-grid pc-grid--two">
            <div class="pc-card pc-rise">
                <div class="pc-card__head"><div class="pc-card__title">@T["Limits"]</div></div>
                <div class="pc-field" style="margin-bottom:20px">
                    <label for="max-users">@T["User limit"]</label>
                    <input id="max-users" class="pc-input" type="number" min="1" max="100000" placeholder="@($"Plan default: {_d.PlanMaxUsers}")" @bind="_maxUsers" data-testid="max-users" />
                    <small>Leave empty to use the plan's limit of @_d.PlanMaxUsers. Set a number to give this company more or fewer seats than its plan.</small>
                </div>
                <div class="pc-field" style="margin-bottom:20px">
                    <label>@T["AI document reading"]</label>
                    <label class="d-flex align-center" style="gap:12px;cursor:pointer;font-weight:500;font-size:14px;color:var(--pc-text)">
                        <input type="checkbox" @bind="_aiAllowed" data-testid="ai-allowed" style="width:18px;height:18px;accent-color:#6366F1" />
                        This company may use AI to read its documents
                    </label>
                    <small>@T["When off, its own AI switch is turned off too and nothing is sent to the local language model."]</small>
                </div>
                @if (c.Status == "Trial")
                {
                    <div class="pc-field">
                        <label>Trial ends on @Pc.Date(_trialEnds)</label>
                        <div class="d-flex" style="gap:8px;flex-wrap:wrap">
                            <button class="pc-btn pc-btn--sm" @onclick="() => ExtendTrial(7)" data-testid="trial-7">+ 7 days</button>
                            <button class="pc-btn pc-btn--sm" @onclick="() => ExtendTrial(14)" data-testid="trial-14">+ 14 days</button>
                            <button class="pc-btn pc-btn--sm" @onclick="() => ExtendTrial(30)" data-testid="trial-30">+ 30 days</button>
                        </div>
                    </div>
                }
            </div>
            <div class="pc-card pc-rise" style="--i:1">
                <div class="pc-card__head"><div class="pc-card__title">@T["Private notes"]</div><span class="pc-card__hint">@T["Only you see these"]</span></div>
                <textarea class="pc-textarea" placeholder="@T["Contract details, who to call, what was promised."]" @bind="_notes" data-testid="notes" maxlength="2000"></textarea>
                <div style="margin-top:18px;display:flex;justify-content:flex-end">
                    <button class="pc-btn pc-btn--primary" @onclick="SaveLimitsAsync" disabled="@_saving" data-testid="save-limits"><MudIcon Icon="@Icons.Material.Filled.Save" Size="Size.Small" />@T["Save limits and notes"]</button>
                </div>
            </div>
        </div>
    }
    else if (_tab == "billing")
    {
        @if (_bill is null)
        {
            <div class="pc-skel" style="height:240px"></div>
        }
        else
        {
            var bill = _bill;
            <div class="pc-grid pc-grid--kpi">
                <PcKpi Index="0" Label="@T["Subscription"]" Value="0" Icon="@Icons.Material.Filled.Verified" Solid="#10B981" TestId="bill-status">
                    <Foot><b style="font-size:18px;color:var(--pc-text)">@BillStatus(bill.Status)</b>&nbsp;· @bill.PlanName @bill.Interval</Foot>
                </PcKpi>
                <PcKpi Index="1" Label="@T["Paid until"]" Value="0" Icon="@Icons.Material.Filled.Event" Solid="#06B6D4">
                    <Foot><b style="font-size:18px;color:var(--pc-text)">@Pc.Date(bill.CurrentPeriodEnd)</b>@(bill.CancelAtPeriodEnd ? " · cancelled" : "")</Foot>
                </PcKpi>
                <PcKpi Index="2" Label="@T["Paid in total"]" Value="bill.LifetimePaid" Money="true" Icon="@Icons.Material.Filled.Payments" Solid="#F59E0B"><Foot>Via @bill.Provider</Foot></PcKpi>
            </div>
            @if (bill.PendingPlanName is not null)
            {
                <div class="pc-attn pc-attn--warning" style="margin-bottom:20px;cursor:default" data-testid="bill-pending">
                    <div class="pc-attn__icon"><MudIcon Icon="@Icons.Material.Filled.HourglassTop" /></div>
                    <div><div class="pc-attn__name">@T["Waiting for payment"]</div><div class="pc-attn__msg">They chose the @bill.PendingPlanName plan (@bill.PendingInterval). Mark the open invoice paid when the money arrives.</div></div>
                </div>
            }
            <div class="pc-grid pc-grid--main">
                <div class="pc-card pc-card--flush" style="overflow-x:auto">
                    <div class="pc-card__head" style="padding:22px 22px 0"><div class="pc-card__title">@T["Invoices"]</div></div>
                    @if (bill.Invoices.Count == 0) { <div class="pc-card__hint" style="padding:0 22px 22px">@T["No invoices yet."]</div> }
                    else
                    {
                        <table class="pc-table" data-testid="bill-invoices">
                            <thead><tr><th>@T["Invoice"]</th><th>@T["Plan"]</th><th>@T["Period"]</th><th>@T["Amount"]</th><th>@T["Status"]</th><th></th></tr></thead>
                            <tbody>
                            @foreach (var i in bill.Invoices)
                            {
                                var invoice = i;
                                <tr style="cursor:default">
                                    <td><b>@invoice.Number</b><div class="pc-card__hint">@Pc.Date(invoice.IssuedAt)</div></td>
                                    <td>@invoice.PlanName · @invoice.Interval</td>
                                    <td>@Pc.Date(invoice.PeriodStart) - @Pc.Date(invoice.PeriodEnd)</td>
                                    <td class="pc-num">@invoice.Currency @invoice.Amount.ToString("N2")</td>
                                    <td><span class="pc-chip @(invoice.Status == "paid" ? "pc-chip--brand" : "")">@(invoice.Status == "paid" ? "Paid" : "Open")</span>@if (invoice.Reference is not null) { <div class="pc-card__hint">@invoice.Reference</div> }</td>
                                    <td class="end">
                                        @if (invoice.Status == "open")
                                        {
                                            <button class="pc-btn pc-btn--sm pc-btn--primary" @onclick="() => MarkPaidAsync(invoice)" data-testid="bill-mark-paid">@T["Mark paid"]</button>
                                            <button class="pc-btn pc-btn--sm pc-btn--ghost" @onclick="() => VoidAsync(invoice)">@T["Cancel"]</button>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                </div>
                <div class="pc-card">
                    <div class="pc-card__head"><div class="pc-card__title">@T["Record a payment"]</div></div>
                    <div class="pc-field" style="margin-bottom:14px"><label for="pay-plan">@T["Plan"]</label>
                        <select id="pay-plan" class="pc-select" @bind="_payPlan" data-testid="pay-plan">@foreach (var p in _plans.Where(p => p.IsActive)) { <option value="@p.Key">@p.Name</option> }</select></div>
                    <div class="d-flex" style="gap:12px;margin-bottom:14px">
                        <div class="pc-field" style="flex:1"><label for="pay-interval">@T["Period"]</label>
                            <select id="pay-interval" class="pc-select" @bind="_payInterval"><option value="monthly">@T["One month"]</option><option value="yearly">@T["One year"]</option></select></div>
                        <div class="pc-field" style="flex:1"><label for="pay-amount">@T["Amount"]</label><input id="pay-amount" class="pc-input" type="number" min="0" step="0.01" placeholder="@T["Plan price"]" @bind="_payAmount" data-testid="pay-amount" /></div>
                    </div>
                    <div class="pc-field" style="margin-bottom:18px"><label for="pay-ref">@T["Reference"]</label><input id="pay-ref" class="pc-input" placeholder="@T["Bank transfer reference, cheque number"]" @bind="_payRef" data-testid="pay-ref" /></div>
                    <button class="pc-btn pc-btn--primary" @onclick="RecordAsync" disabled="@_saving" data-testid="pay-record"><MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />@T["Record payment"]</button>
                    <div class="pc-card__hint" style="margin-top:10px">@T["The company becomes active on this plan for the period, and its owner gets a receipt."]</div>
                </div>
            </div>
        }
    }
    else if (_tab == "data")
    {
        <div class="pc-grid pc-grid--two">
            <div class="pc-card pc-rise">
                <div class="pc-card__head"><div class="pc-card__title">@T["Export all data"]</div><span class="pc-card__hint">@T["Every record and file, in one ZIP"]</span></div>
                <button class="pc-btn pc-btn--primary" @onclick="ExportAsync" disabled="@_saving" data-testid="pc-export"><MudIcon Icon="@Icons.Material.Filled.Archive" Size="Size.Small" />@T["Prepare an export"]</button>
                <div class="pc-card__hint" style="margin:10px 0 14px">@T["For a backup of this one company, or when it leaves. Passwords and keys are never included."]</div>
                @foreach (var e in _exports)
                {
                    var export = e;
                    <div class="pc-kv">
                        <span>@Pc.Date(export.CreatedAt) · @(export.SizeBytes is { } b ? $"{b / 1024.0 / 1024.0:0.#} MB" : "-")</span>
                        <span>
                            @if (export.Status == "ready" && export.ExpiresAt > DateTime.UtcNow) { <button class="pc-btn pc-btn--sm" @onclick="() => DownloadAsync(export)">@T["Download"]</button> }
                            else { @export.Status }
                        </span>
                    </div>
                }
            </div>
            <div class="pc-card pc-rise" style="--i:1;border-color:color-mix(in srgb, var(--pc-bad) 40%, var(--pc-border))" data-testid="pc-danger">
                <div class="pc-card__head"><div class="pc-card__title" style="color:var(--pc-bad)">@T["Remove this company for good"]</div></div>
                <div class="pc-card__hint" style="margin-bottom:14px">Deletes every record, user and file of @c.Name. This cannot be undone. Prepare an export first if anything may be needed later.</div>
                <div class="pc-field" style="margin-bottom:14px"><label for="purge-confirm">@T["Type"] <b>@c.Slug</b> to confirm</label><input id="purge-confirm" class="pc-input" @bind="_purgeConfirm" @bind:event="oninput" data-testid="purge-confirm" /></div>
                <button class="pc-btn pc-btn--danger" disabled="@(_purgeConfirm != c.Slug || _saving)" @onclick="PurgeAsync" data-testid="purge-button"><MudIcon Icon="@Icons.Material.Filled.DeleteForever" Size="Size.Small" />@T["Remove permanently"]</button>
            </div>
        </div>
    }
    else
    {
        <div class="pc-card pc-rise" data-testid="history">
            <div class="pc-card__head"><div class="pc-card__title">Everything changed for @c.Name</div></div>
            @if (_d.History.Count == 0) { <div class="pc-card__hint">@T["Nothing yet. Changes to modules, plan, limits and status will be listed here."]</div> }
            <div class="pc-timeline">
                @foreach (var h in _d.History)
                {
                    <div class="pc-tl">
                        <div class="pc-tl__dot"><MudIcon Icon="@HistoryIcon(h.Action)" Size="Size.Small" /></div>
                        <div><div class="pc-tl__text">@h.Summary</div><div class="pc-tl__meta">@h.Actor · @Pc.Ago(h.At) · @h.At.ToString("d MMM yyyy HH:mm")</div></div>
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private static readonly string[] Statuses = ["Active", "Trial", "PastDue", "Suspended", "Cancelled"];

    private PlatformCompanyDetailDto? _d;
    private List<PlatformModuleDto> _catalog = [];
    private List<ModulePresetDto> _presets = [];
    private List<PlatformPlanDto> _plans = [];
    private bool _notFound;
    private string _tab = "overview";
    private string _find = "";
    private bool _saving;
    private bool _statusOpen;

    private HashSet<string> _off = [];

    private bool _supportOpen;
    private string? _supportReason;

    private async Task StartSupportAsync()
    {
        _saving = true;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/v1/platform/companies/{Id}/support-sessions", new StartSupportSessionRequest(_supportReason ?? ""));
            if (!response.IsSuccessStatusCode) { Snackbar.Add(await Problem(response), Severity.Error); return; }
            var started = (await response.Content.ReadFromJsonAsync<SupportSessionStartedDto>())!;
            await JS.InvokeVoidAsync("open", $"/support/{started.Code}", "_blank");
            _supportOpen = false;
            _supportReason = null;
            Snackbar.Add("The support view opened in a new tab.", Severity.Info);
        }
        finally { _saving = false; }
    }

    private List<DataExportDto> _exports = [];
    private string _purgeConfirm = "";

    private async Task OpenDataAsync()
    {
        _tab = "data";
        _exports = await Http.GetFromJsonAsync<List<DataExportDto>>($"api/v1/platform/companies/{Id}/exports") ?? [];
    }

    private async Task ExportAsync()
    {
        _saving = true;
        try
        {
            var response = await Http.PostAsync($"api/v1/platform/companies/{Id}/exports", null);
            if (response.IsSuccessStatusCode) { Snackbar.Add("The export is being prepared.", Severity.Info); await OpenDataAsync(); }
            else Snackbar.Add(await Problem(response), Severity.Error);
        }
        finally { _saving = false; }
    }

    private async Task DownloadAsync(DataExportDto export)
    {
        var response = await Http.PostAsync($"api/v1/platform/companies/{Id}/exports/{export.Id}/link", null);
        if (!response.IsSuccessStatusCode) { Snackbar.Add(await Problem(response), Severity.Error); return; }
        var link = (await response.Content.ReadFromJsonAsync<DownloadLinkDto>())!;
        await JS.InvokeVoidAsync("open", link.Url, "_self");
    }

    private async Task PurgeAsync()
    {
        _saving = true;
        try
        {
            var request = new HttpRequestMessage(HttpMethod.Delete, $"api/v1/platform/companies/{Id}") { Content = JsonContent.Create(new PurgeCompanyRequest(_purgeConfirm)) };
            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode) { Snackbar.Add($"{_d!.Company.Name} is being removed.", Severity.Success); Nav.NavigateTo("/platform/companies"); }
            else Snackbar.Add(await Problem(response), Severity.Error);
        }
        finally { _saving = false; }
    }

    private PlatformBillingDto? _bill;
    private string _payPlan = "";
    private string _payInterval = "monthly";
    private decimal? _payAmount;
    private string? _payRef;

    private static string BillStatus(string s) => s switch { "trialing" => "On trial", "active" => "Active", "past_due" => "Past due", "cancelled" => "Cancelled", _ => s };

    private async Task OpenBillingAsync()
    {
        _tab = "billing";
        _bill = await Http.GetFromJsonAsync<PlatformBillingDto>($"api/v1/platform/companies/{Id}/billing");
        if (_payPlan == "") _payPlan = _d?.Company.PlanKey ?? "";
    }

    private Task MarkPaidAsync(BillingInvoiceDto invoice) => PayAsync(new RecordBillingPaymentRequest(invoice.Id, null, null, null, null, null), $"{invoice.Number} marked paid.");

    private Task RecordAsync() => PayAsync(new RecordBillingPaymentRequest(null, _payPlan, _payInterval, _payAmount, _payRef, null), "Payment recorded.");

    private async Task PayAsync(RecordBillingPaymentRequest request, string done)
    {
        _saving = true;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/v1/platform/companies/{Id}/billing/payments", request);
            if (response.IsSuccessStatusCode)
            {
                _bill = await response.Content.ReadFromJsonAsync<PlatformBillingDto>();
                _payAmount = null; _payRef = null;
                Snackbar.Add(done, Severity.Success);
                await LoadAsync();
                _tab = "billing";
            }
            else Snackbar.Add(await Problem(response), Severity.Error);
        }
        finally { _saving = false; }
    }

    private async Task VoidAsync(BillingInvoiceDto invoice)
    {
        var response = await Http.PostAsync($"api/v1/platform/companies/{Id}/billing/invoices/{invoice.Id}/void", null);
        if (response.IsSuccessStatusCode) { _bill = await response.Content.ReadFromJsonAsync<PlatformBillingDto>(); Snackbar.Add($"{invoice.Number} cancelled.", Severity.Success); }
        else Snackbar.Add(await Problem(response), Severity.Error);
    }
    private HashSet<string> _savedOff = [];

    private int? _maxUsers;
    private bool _aiAllowed = true;
    private string? _notes;
    private DateTime? _trialEnds;

    private string Tab(string key) => _tab == key ? "is-on" : "";
    private IReadOnlyList<PlatformModuleDto> Switchable => _catalog.Where(m => m.Available && !m.Core).ToList();
    private int CoreCount => _catalog.Count(m => m.Available && m.Core);
    private int ModulesOn => Switchable.Count(m => !_off.Contains(m.Key) && !PlanOff(m)) + CoreCount;
    private int ModulesPct => Switchable.Count + CoreCount == 0 ? 0 : 100 * ModulesOn / (Switchable.Count + CoreCount);
    private bool Dirty => !_off.SetEquals(_savedOff);

    private static int Pct(int value, int max) => max <= 0 ? 0 : Math.Min(100, 100 * value / max);

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            var response = await Http.GetAsync($"api/v1/platform/companies/{Id}");
            if (response.StatusCode == System.Net.HttpStatusCode.NotFound) { _notFound = true; return; }
            response.EnsureSuccessStatusCode();
            Apply((await response.Content.ReadFromJsonAsync<PlatformCompanyDetailDto>())!);
            if (_catalog.Count == 0)
            {
                _catalog = await Http.GetFromJsonAsync<List<PlatformModuleDto>>("api/v1/platform/modules") ?? [];
                _presets = await Http.GetFromJsonAsync<List<ModulePresetDto>>("api/v1/platform/module-presets") ?? [];
            }
            _plans = await Http.GetFromJsonAsync<List<PlatformPlanDto>>("api/v1/platform/plans") ?? [];
        }
        catch (HttpRequestException) { Snackbar.Add("The company could not be loaded.", Severity.Error); }
    }

    private void Apply(PlatformCompanyDetailDto d)
    {
        _d = d;
        _off = d.DisabledModules.ToHashSet();
        _savedOff = d.DisabledModules.ToHashSet();
        _maxUsers = d.MaxUsersOverride;
        _aiAllowed = d.Company.AiAllowed;
        _notes = d.Notes;
        _trialEnds = d.Company.TrialEndsAt;
    }

    // ----- modules -----

    private bool PlanOff(PlatformModuleDto m) => _d!.PlanExcludedModules?.Contains(m.Key) == true;
    private bool IsOn(PlatformModuleDto m) => m.Core || (m.Available && !_off.Contains(m.Key) && !PlanOff(m));
    private bool Changed(PlatformModuleDto m) => _off.Contains(m.Key) != _savedOff.Contains(m.Key);
    private bool TenantOff(PlatformModuleDto m) => _d!.TenantDisabledModules.Contains(m.Key) && IsOn(m);

    private IEnumerable<IGrouping<string, PlatformModuleDto>> ModuleCatalogGroups()
    {
        var q = _find.Trim();
        var items = string.IsNullOrEmpty(q) ? _catalog : _catalog.Where(m => m.Name.Contains(q, StringComparison.OrdinalIgnoreCase) || m.Description.Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
        return items.GroupBy(m => m.Category).OrderBy(g => MindLift.Shared.Enums.ModuleCatalog.Categories.ToList().IndexOf(g.Key));
    }

    private void Toggle(PlatformModuleDto m)
    {
        if (m.Core || !m.Available || PlanOff(m)) return;
        if (!_off.Remove(m.Key)) _off.Add(m.Key);
    }

    private void ApplyPreset(ModulePresetDto p)
    {
        var allowed = p.Modules.ToHashSet();
        _off = Switchable.Where(m => !allowed.Contains(m.Key) && !PlanOff(m)).Select(m => m.Key).ToHashSet();
    }

    private void Discard() => _off = _savedOff.ToHashSet();

    private string DiffText
    {
        get
        {
            string Name(string k) => _catalog.FirstOrDefault(m => m.Key == k)?.Name ?? k;
            var off = _off.Except(_savedOff).Select(Name).ToList();
            var on = _savedOff.Except(_off).Select(Name).ToList();
            var parts = new List<string>();
            if (off.Count > 0) parts.Add("Switch off: " + string.Join(", ", off));
            if (on.Count > 0) parts.Add("Switch on: " + string.Join(", ", on));
            return string.Join(" · ", parts);
        }
    }

    private async Task SaveModulesAsync()
    {
        _saving = true;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/v1/platform/companies/{Id}/modules", new SetCompanyModulesRequest(_off.OrderBy(x => x).ToList()));
            await Handle(response, "Modules saved. The company sees the change straight away.");
        }
        finally { _saving = false; }
    }

    // ----- plan and limits -----

    private void ExtendTrial(int days) => _trialEnds = (_trialEnds is { } t && t > DateTime.UtcNow ? t : DateTime.UtcNow).AddDays(days);

    private async Task SaveLimitsAsync()
    {
        _saving = true;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/v1/platform/companies/{Id}/limits",
                new SetCompanyLimitsRequest(_maxUsers, _aiAllowed, _notes, _d!.Company.Status == "Trial" ? _trialEnds : null));
            await Handle(response, "Limits and notes saved.");
        }
        finally { _saving = false; }
    }

    private async Task ChangePlanAsync(PlatformPlanDto plan)
    {
        if (plan.Key == _d!.Company.PlanKey) return;
        var response = await Http.PatchAsJsonAsync($"api/v1/platform/companies/{Id}/plan", new ChangeTenantPlanRequest(plan.Key));
        if (response.IsSuccessStatusCode) { Snackbar.Add($"Moved to the {plan.Name} plan.", Severity.Success); await LoadAsync(); }
        else Snackbar.Add(await Problem(response), Severity.Error);
    }

    private async Task ChangeStatusAsync(string status)
    {
        _statusOpen = false;
        var response = await Http.PatchAsJsonAsync($"api/v1/platform/companies/{Id}/status", new ChangeTenantStatusRequest(status));
        if (response.IsSuccessStatusCode) { Snackbar.Add($"Status is now {Pc.StatusLabel(status)}.", Severity.Success); await LoadAsync(); }
        else Snackbar.Add(await Problem(response), Severity.Error);
    }

    private async Task Handle(HttpResponseMessage response, string success)
    {
        if (response.IsSuccessStatusCode)
        {
            Apply((await response.Content.ReadFromJsonAsync<PlatformCompanyDetailDto>())!);
            Snackbar.Add(success, Severity.Success);
        }
        else Snackbar.Add(await Problem(response), Severity.Error);
    }

    private static async Task<string> Problem(HttpResponseMessage response)
    {
        try
        {
            var body = await response.Content.ReadAsStringAsync();
            using var doc = JsonDocument.Parse(body);
            if (doc.RootElement.TryGetProperty("detail", out var detail) && detail.ValueKind == JsonValueKind.String) return detail.GetString()!;
            if (doc.RootElement.TryGetProperty("title", out var title)) return title.GetString() ?? "That did not work.";
        }
        catch { }
        return "That did not work.";
    }

    private static string HistoryIcon(string action) => action switch
    {
        "modules.changed" => Icons.Material.Filled.Widgets,
        "plan.changed" or "plan.edited" => Icons.Material.Filled.Diamond,
        "status.changed" => Icons.Material.Filled.Tune,
        "limits.changed" => Icons.Material.Filled.Speed,
        _ => Icons.Material.Filled.Bolt
    };
}
