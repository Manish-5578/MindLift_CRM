@using MindLift.Shared.Contracts
@inject Translator T

<MudDialog MaxWidth="MaxWidth.Small" FullWidth="true">
    <TitleContent>
        <div class="ml-row" style="align-items:center;gap:8px;">
            <MudIcon Icon="@Icons.Material.Filled.AddLink" Color="Color.Primary" />
            <MudText Typo="Typo.h6">@T["Connect Workflow Nodes"]</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column gap-3">
            <MudTextField @bind-Value="_sourceId" Label="@T["Source Node ID"]"
                          Placeholder="@T["e.g. n_start, n_cond"]"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />

            <MudTextField @bind-Value="_targetId" Label="@T["Target Node ID"]"
                          Placeholder="@T["e.g. n_task, n_action"]"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />

            <MudSelect T="string" Label="@T["Source Port (For Condition Branches)"]" @bind-Value="_port"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true">
                <MudSelectItem Value="@("")">@T["Default / Direct (Standard Action)"]</MudSelectItem>
                <MudSelectItem Value="@("true")">@T["True (Condition Evaluates True)"]</MudSelectItem>
                <MudSelectItem Value="@("false")">@T["False (Condition Evaluates False)"]</MudSelectItem>
            </MudSelect>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">@T["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">@T["Create Connection"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private string _sourceId = "";
    private string _targetId = "";
    private string _port = "";

    private void Cancel() => MudDialog.Cancel();

    private void Save()
    {
        if (string.IsNullOrWhiteSpace(_sourceId) || string.IsNullOrWhiteSpace(_targetId))
        {
            return;
        }

        var edge = new WorkflowEdgeDto(
            Id: "e_" + Guid.NewGuid().ToString("N")[..6],
            SourceNodeId: _sourceId.Trim(),
            TargetNodeId: _targetId.Trim(),
            SourcePort: string.IsNullOrWhiteSpace(_port) ? null : _port.Trim()
        );

        MudDialog.Close(DialogResult.Ok(edge));
    }
}
