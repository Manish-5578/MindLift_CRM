<FormDrawer Open="Open" OpenChanged="OnOpenChanged" Title="@(_contactId is null ? "New contact" : "Edit contact")" SubmitText="@(_contactId is null ? "Create contact" : "Save changes")" Busy="_busy" OnSubmit="SaveAsync" IsDirty="IsDirty">
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" data-testid="contact-error">@_error</MudAlert>
    }

    @if (_duplicates.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3" data-testid="duplicate-warning">
            <MudText Typo="Typo.subtitle2">Possible duplicates</MudText>
            @foreach (var d in _duplicates)
            {
                <MudText Typo="Typo.body2">@d.FullName · @d.Reason</MudText>
            }
            <MudText Typo="Typo.body2" Class="mt-2">Press the button again to create the contact anyway.</MudText>
        </MudAlert>
    }

    <DynamicForm Fields="Fields" Values="_values" Users="_users" AccountSearch="SearchAccountsAsync" Errors="_fieldErrors"
                 CustomFields="_customFields" CustomValues="_custom" CustomValuesChanged="v => _custom = v" />
</FormDrawer>

@code {
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private AppState App { get; set; } = default!;

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    /// <summary>Opening from an account page fills the company in.</summary>
    [Parameter] public Guid? DefaultAccountId { get; set; }
    [Parameter] public string? DefaultAccountName { get; set; }

    private Dictionary<string, string?> _values = new();
    private Dictionary<string, JsonElement?> _custom = new();
    private IReadOnlyList<FieldDto> _customFields = [];
    private IReadOnlyDictionary<string, string> _fieldErrors = new Dictionary<string, string>();
    private List<UserListItem> _users = [];
    private Guid? _contactId;
    private bool _busy;
    private string? _error;
    private List<DuplicateCandidateDto> _duplicates = [];
    private string _snapshot = string.Empty;

    private bool IsDirty => TakeSnapshot() != _snapshot;

    private string TakeSnapshot() => JsonSerializer.Serialize(new { Form = _values, Custom = _custom });

    private IReadOnlyList<FormField> Fields =>
    [
        new("firstName", "First name", Required: true, TestId: "contact-first", Columns: 6),
        new("lastName", "Last name", Columns: 6),
        new("email", "Email", FormFieldKind.Email, TestId: "contact-email"),
        new("phone", "Phone", FormFieldKind.Phone, Columns: 6),
        new("jobTitle", "Job title", Columns: 6),
        new("accountId", "Company", FormFieldKind.Account, TestId: "contact-account"),
        new("type", "Type", FormFieldKind.Picklist, Options: Options("contact_type")),
        new("ownerId", "Owner", FormFieldKind.User),
        new("description", "Notes", FormFieldKind.Multiline),
    ];

    private IReadOnlyList<PicklistValueDto> Options(string key)
        => App.Bootstrap?.Picklists.FirstOrDefault(p => p.Key == key)?.Values ?? [];

    protected override async Task OnInitializedAsync() => _users = await RecordLookups.UsersAsync(Http);

    private Task<IReadOnlyList<LookupItem>> SearchAccountsAsync(string text, CancellationToken cancellationToken)
        => RecordLookups.AccountsAsync(Http, text, cancellationToken);

    /// <summary>Opens the drawer empty for a new contact.</summary>
    public void OpenNew()
    {
        _contactId = null;
        _values = new Dictionary<string, string?>();
        if (DefaultAccountId is { } accountId)
        {
            _values["accountId"] = accountId.ToString();
            _values["accountId" + DynamicForm.LabelSuffix] = DefaultAccountName;
        }

        Reset([]);
    }

    /// <summary>Opens the drawer filled with an existing contact.</summary>
    public void OpenEdit(ContactDto contact)
    {
        _contactId = contact.Id;
        _values = new Dictionary<string, string?>
        {
            ["firstName"] = contact.FirstName, ["lastName"] = contact.LastName, ["email"] = contact.Email, ["phone"] = contact.Phone,
            ["jobTitle"] = contact.JobTitle, ["accountId"] = contact.AccountId?.ToString(), ["accountId" + DynamicForm.LabelSuffix] = contact.AccountName,
            ["type"] = contact.Type, ["ownerId"] = contact.OwnerId.ToString(), ["description"] = contact.Description,
        };
        Reset(contact.CustomFields.ToDictionary(kv => kv.Key, kv => (JsonElement?)kv.Value));
    }

    private void Reset(Dictionary<string, JsonElement?> custom)
    {
        _custom = custom;
        _customFields = App.Bootstrap?.Fields.GetValueOrDefault("contacts")?.Where(f => f.IsCustom).ToList() ?? [];
        _duplicates = [];
        _error = null;
        _fieldErrors = new Dictionary<string, string>();
        _snapshot = TakeSnapshot();
    }

    private async Task OnOpenChanged(bool value) => await OpenChanged.InvokeAsync(value);

    private string? Value(string key) => string.IsNullOrWhiteSpace(_values.GetValueOrDefault(key)) ? null : _values[key]!.Trim();

    private async Task SaveAsync()
    {
        _error = null;
        _fieldErrors = new Dictionary<string, string>();
        if (Value("firstName") is null)
        {
            _fieldErrors = new Dictionary<string, string> { ["firstName"] = "Enter the first name." };
            return;
        }

        _busy = true;
        try
        {
            if (_contactId is null && _duplicates.Count == 0 && (Value("email") is not null || Value("phone") is not null))
            {
                var check = await Http.PostAsJsonAsync("api/v1/contacts/check-duplicates",
                    new CheckDuplicatesRequest(Value("firstName")!, Value("lastName") ?? string.Empty, Value("email"), Value("phone"), null));
                var found = check.IsSuccessStatusCode ? await check.Content.ReadFromJsonAsync<List<DuplicateCandidateDto>>() ?? [] : [];
                if (found.Count > 0)
                {
                    _duplicates = found;
                    return;
                }
            }

            Guid? accountId = Guid.TryParse(Value("accountId"), out var parsedAccount) ? parsedAccount : null;
            Guid? ownerId = Guid.TryParse(Value("ownerId"), out var parsedOwner) ? parsedOwner : null;
            var request = new SaveContactRequest(
                Value("firstName")!, Value("lastName") ?? string.Empty, Value("email"), Value("phone"), Value("jobTitle"), Value("description"),
                accountId, Value("type"), ownerId,
                _custom.Where(kv => kv.Value is not null).ToDictionary(kv => kv.Key, kv => kv.Value!.Value));

            var response = _contactId is null
                ? await Http.PostAsJsonAsync("api/v1/contacts", request)
                : await Http.PutAsJsonAsync($"api/v1/contacts/{_contactId}", request);

            if (!response.IsSuccessStatusCode)
            {
                var fields = await ProblemText.FieldErrorsAsync(response);
                if (fields.Count > 0)
                {
                    _fieldErrors = fields.ToDictionary(kv => kv.Key, kv => kv.Value);
                }
                else
                {
                    _error = await ProblemText.FromAsync(response, "We could not save this contact.");
                }

                return;
            }

            await OpenChanged.InvokeAsync(false);
            await OnSaved.InvokeAsync();
        }
        catch (HttpRequestException)
        {
            _error = "We could not reach MindLift. Check your connection and try again.";
        }
        finally
        {
            _busy = false;
        }
    }
}
