@using MindLift.Shared.Contracts
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject Translator T

<div class="ml-sticky-note pa-4 mb-4 mud-paper" style="border: 1px solid var(--mud-palette-divider); border-radius: 12px; background: var(--mud-palette-surface); box-shadow: var(--mud-elevation-1);">
    <div class="d-flex align-center justify-space-between mb-2">
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Outlined.EditNote" Color="Color.Primary" />
            <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">@T["Notes"]</MudText>
        </div>
        <div class="d-flex align-center gap-1">
            @if (!string.IsNullOrWhiteSpace(_note))
            {
                <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small" OnClick="CopyNoteAsync" Title="@T["Copy note"]" />
            }
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" Style="width:16px; height:16px;" />
            }
            else if (_dirty)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text" Style="font-size:11px;">@T["Unsaved changes"]</MudChip>
            }
        </div>
    </div>

    <MudTextField T="string"
                  Value="@_note"
                  ValueChanged="OnNoteChanged"
                  Lines="4"
                  Placeholder="@T["Write notes, reminders, or important context about this lead..."]"
                  Variant="Variant.Outlined"
                  Class="mb-2" />

    <div class="d-flex align-center justify-space-between">
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            @(_note?.Length ?? 0) @T["characters"]
        </MudText>
        <div class="d-flex gap-2">
            @if (_dirty)
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="RevertNote">
                    @T["Cancel"]
                </MudButton>
            }
            <MudButton Size="Size.Small"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveNoteAsync"
                       Disabled="_saving || !_dirty">
                @(_saving ? T["Saving..."] : T["Save note"])
            </MudButton>
        </div>
    </div>
</div>

@code {
    [Parameter] public Guid LeadId { get; set; }
    [Parameter] public string? InitialNote { get; set; }
    [Parameter] public EventCallback<string?> OnSaved { get; set; }

    private string? _note;
    private string? _savedNote;
    private bool _dirty;
    private bool _saving;

    protected override void OnParametersSet()
    {
        if (!_dirty)
        {
            _note = InitialNote;
            _savedNote = InitialNote;
        }
    }

    private void OnNoteChanged(string? value)
    {
        _note = value;
        _dirty = _note != _savedNote;
    }

    private void RevertNote()
    {
        _note = _savedNote;
        _dirty = false;
    }

    private async Task SaveNoteAsync()
    {
        _saving = true;
        try
        {
            var res = await Http.PatchAsJsonAsync($"api/v1/leads/{LeadId}/sticky-note", new UpdateStickyNoteRequest(_note));
            if (res.IsSuccessStatusCode)
            {
                _savedNote = _note;
                _dirty = false;
                Snackbar.Add(T["Note saved successfully."], Severity.Success);
                await OnSaved.InvokeAsync(_note);
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                Snackbar.Add(T["Could not save note: {0}", err], Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(T["Error saving note: {0}", ex.Message], Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task CopyNoteAsync()
    {
        if (!string.IsNullOrWhiteSpace(_note))
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _note);
            Snackbar.Add(T["Note copied to clipboard"], Severity.Info);
        }
    }
}
