@inject AppState App
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject Translator T

@if (CanCreateAny)
{
    <MudMenu Icon="@Icons.Material.Filled.Add" Color="Color.Inherit" AriaLabel="@T["Quick add"]" Dense="true" data-testid="quick-add">
        @if (CanCreate("Leads"))
        {
            <MudMenuItem OnClick="OpenLead" data-testid="quick-add-lead">@T["New lead"]</MudMenuItem>
        }
        @if (CanCreate("Contacts"))
        {
            <MudMenuItem OnClick="OpenContact" data-testid="quick-add-contact">@T["New contact"]</MudMenuItem>
        }
        @if (CanCreate("Accounts"))
        {
            <MudMenuItem OnClick="OpenAccount" data-testid="quick-add-account">@T["New account"]</MudMenuItem>
        }
        @if (CanCreate("Deals"))
        {
            <MudMenuItem OnClick="OpenDeal" data-testid="quick-add-deal">@T["New deal"]</MudMenuItem>
        }
        @if (CanCreate("Activities"))
        {
            <MudDivider />
            <MudMenuItem OnClick="() => OpenActivity(ActivityTypes.Task)" data-testid="quick-add-task">@T["New task"]</MudMenuItem>
            <MudMenuItem OnClick="() => OpenActivity(ActivityTypes.Call)" data-testid="quick-add-call">@T["Log a call"]</MudMenuItem>
            <MudMenuItem OnClick="() => OpenActivity(ActivityTypes.Meeting)" data-testid="quick-add-meeting">@T["New meeting"]</MudMenuItem>
            <MudMenuItem OnClick="() => OpenActivity(ActivityTypes.Note)" data-testid="quick-add-note">@T["New note"]</MudMenuItem>
        }
    </MudMenu>

    @if (CanCreate("Leads")) { <LeadFormDrawer @ref="_lead" @bind-Open="_leadOpen" OnSaved="OnLeadSaved" /> }
    @if (CanCreate("Contacts")) { <ContactFormDrawer @ref="_contact" @bind-Open="_contactOpen" OnSaved="OnContactSaved" /> }
    @if (CanCreate("Accounts")) { <AccountFormDrawer @ref="_account" @bind-Open="_accountOpen" OnSaved="OnAccountSaved" /> }
    @if (CanCreate("Deals")) { <DealFormDrawer @ref="_deal" @bind-Open="_dealOpen" OnSaved="OnDealSaved" /> }
    @if (CanCreate("Activities")) { <ActivityFormDrawer @ref="_form" @bind-Open="_open" OnSaved="OnSaved" /> }
}

@code {
    private ActivityFormDrawer? _form;
    private LeadFormDrawer? _lead;
    private ContactFormDrawer? _contact;
    private AccountFormDrawer? _account;
    private DealFormDrawer? _deal;
    private bool _open, _leadOpen, _contactOpen, _accountOpen, _dealOpen;

    private static readonly string[] Modules = ["Leads", "Contacts", "Accounts", "Deals", "Activities"];

    private bool CanCreate(string module) => App.Bootstrap?.Permissions.Any(p => p.Module == module && p.CanCreate) == true;
    private bool CanCreateAny => Modules.Any(CanCreate);

    private void OpenLead() { _lead?.OpenNew(); _leadOpen = true; }
    private void OpenContact() { _contact?.OpenNew(); _contactOpen = true; }
    private void OpenAccount() { _account?.OpenNew(); _accountOpen = true; }
    private void OpenDeal() { _deal?.OpenNew(); _dealOpen = true; }

    private void OpenActivity(string type)
    {
        _form?.OpenNew(type);
        _open = true;
    }

    private void OnLeadSaved() => Saved(T["Lead saved"], "/leads");
    private void OnContactSaved() => Saved(T["Contact saved"], "/contacts");
    private void OnAccountSaved() => Saved(T["Account saved"], "/accounts");
    private void OnDealSaved() => Saved(T["Deal saved"], "/deals");

    private void OnSaved() => Snackbar.Add(T["Activity saved"], Severity.Success);

    /// <summary>Tells the person it saved, and shows the list the record now sits in (or refreshes it when already there).</summary>
    private void Saved(string message, string listPath)
    {
        Snackbar.Add(message, Severity.Success);
        if (new Uri(Nav.Uri).AbsolutePath.TrimEnd('/') == listPath)
        {
            Nav.Refresh();
        }
        else
        {
            Nav.NavigateTo(listPath);
        }
    }
}
