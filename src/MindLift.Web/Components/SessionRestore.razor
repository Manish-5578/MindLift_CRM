@* Restores the signed-in session on page load (refresh cookie) before any page renders. *@
@if (_ready)
{
    @ChildContent
}
else
{
    <div class="ml-state" style="min-height:100vh;justify-content:center">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </div>
}

@code {
    [Inject] private AuthSession Session { get; set; } = default!;
    [Inject] private AppState App { get; set; } = default!;
    [Inject] private HttpClient Http { get; set; } = default!;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsSignedIn)
        {
            try
            {
                var response = await Http.PostAsync("api/v1/auth/refresh", null);
                if (response.IsSuccessStatusCode)
                {
                    Session.SetTokens((await response.Content.ReadFromJsonAsync<MindLift.Shared.Contracts.TokenResponse>())!);
                }
            }
            catch (HttpRequestException)
            {
                // The API is unreachable. The pages show their own error states.
            }
        }

        if (Session.IsSignedIn && App.Bootstrap is null)
        {
            await App.LoadAsync();
        }

        _ready = true;
    }
}
