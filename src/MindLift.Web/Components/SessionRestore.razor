@* Restores the signed-in session on page load (refresh cookie) before any page renders. *@
@if (_ready)
{
    @ChildContent
}
else
{
    <div class="ml-state" style="min-height:100vh;justify-content:center">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </div>
}

@code {
    [Inject] private AuthSession Session { get; set; } = default!;
    [Inject] private AppState App { get; set; } = default!;
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var uri = Nav.Uri;
            var isPublicAuthPage = uri.Contains("/login", StringComparison.OrdinalIgnoreCase) ||
                                   uri.Contains("/signup", StringComparison.OrdinalIgnoreCase) ||
                                   uri.Contains("/forgot-password", StringComparison.OrdinalIgnoreCase) ||
                                   uri.Contains("/reset-password", StringComparison.OrdinalIgnoreCase) ||
                                   uri.Contains("/verify-email", StringComparison.OrdinalIgnoreCase) ||
                                   uri.Contains("/accept-invite", StringComparison.OrdinalIgnoreCase);

            if (!Session.IsSignedIn && !isPublicAuthPage)
            {
                try
                {
                    using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(2));
                    var response = await Http.PostAsync("api/v1/auth/refresh", null, cts.Token);
                    if (response.IsSuccessStatusCode)
                    {
                        var tokens = await response.Content.ReadFromJsonAsync<MindLift.Shared.Contracts.TokenResponse>(cancellationToken: cts.Token);
                        if (tokens is not null)
                        {
                            Session.SetTokens(tokens);
                        }
                    }
                }
                catch
                {
                    // The API is unreachable or timed out. Allow rendering so pages can display appropriate login/error state.
                }
            }

            if (Session.IsSignedIn && App.Bootstrap is null)
            {
                try
                {
                    await App.LoadAsync();
                }
                catch
                {
                    // Ignore bootstrap load failures so the UI still displays.
                }
            }
        }
        finally
        {
            _ready = true;
            StateHasChanged();
        }
    }
}
