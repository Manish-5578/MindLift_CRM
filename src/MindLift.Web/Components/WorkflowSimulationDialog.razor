@using MindLift.Shared.Contracts
@using System.Text.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject Translator T

<MudDialog MaxWidth="MaxWidth.Medium" FullWidth="true">
    <TitleContent>
        <div class="ml-row" style="align-items:center;gap:10px;">
            <MudAvatar Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Small">
                <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" />
            </MudAvatar>
            <div>
                <MudText Typo="Typo.h6">@T["Simulate Workflow: {0}", Workflow.Name]</MudText>
                <div class="text-caption ml-muted">@T["Test DAG evaluation paths with mock record facts without changing actual CRM records."]</div>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <!-- Mock Record Facts Inputs -->
        <MudCard Outlined="true" Class="pa-4 mb-4">
            <div class="ml-row" style="justify-content:space-between;align-items:center;margin-bottom:12px;">
                <div class="ml-row" style="align-items:center;gap:8px;">
                    <MudIcon Icon="@Icons.Material.Filled.Input" Color="Color.Primary" Size="Size.Small" />
                    <span style="font-weight:600;font-size:0.95rem;">@T["Simulation Inputs (Mock Record Facts)"]</span>
                </div>
                <div class="ml-row" style="gap:6px;">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadPresetHigh">
                        @T["Load High-Score / High-Value"]
                    </MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" OnClick="LoadPresetLow">
                        @T["Load Low-Score / Standard"]
                    </MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddFactField">
                        @T["+ Add Field"]
                    </MudButton>
                </div>
            </div>

            <div class="ml-grid ml-grid--2col" style="gap:12px;">
                @foreach (var fact in _facts)
                {
                    <div class="ml-row" style="align-items:center;gap:8px;">
                        <MudTextField @bind-Value="fact.Key" Label="@T["Field Key"]"
                                      Placeholder="@T["e.g. score, amount, quantity"]"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudTextField @bind-Value="fact.Value" Label="@T["Field Value"]"
                                      Placeholder="@T["e.g. 95, 50000, Closed"]"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Default"
                                       OnClick="@(() => _facts.Remove(fact))" />
                    </div>
                }
            </div>

            <div class="mt-3">
                <MudCheckBox @bind-Value="_recordExecution" Label="@T["Record this simulation run in the execution audit log"]"
                             Color="Color.Primary" Dense="true" />
            </div>
        </MudCard>

        @if (_simulating)
        {
            <div class="pa-8 text-center">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" Class="mb-3" />
                <div>@T["Evaluating DAG nodes, condition branches, and field transformations..."]</div>
            </div>
        }
        else if (_result is not null)
        {
            <!-- Simulation Results Card -->
            <MudCard Outlined="true" Class="pa-4 mb-3" Style="@GetResultBorderStyle(_result.Success)">
                <div class="ml-row" style="justify-content:space-between;align-items:center;margin-bottom:12px;">
                    <div class="ml-row" style="align-items:center;gap:10px;">
                        <MudIcon Icon="@(_result.Success ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Error)"
                                 Color="@(_result.Success ? Color.Success : Color.Error)" Size="Size.Medium" />
                        <div>
                            <span style="font-weight:700;font-size:1.05rem;">
                                @(_result.Success ? T["Simulation Succeeded: {0}", _result.Status] : T["Simulation Error"])
                            </span>
                            <div class="text-caption ml-muted">
                                @T["Executed {0} nodes in sequence", _result.ExecutedNodeIds.Count]
                            </div>
                        </div>
                    </div>
                    <MudChip T="string" Color="@(_result.Success ? Color.Success : Color.Error)" Variant="Variant.Filled" Size="Size.Small">
                        @_result.Status
                    </MudChip>
                </div>

                <!-- Executed Path Chips -->
                <div class="pa-3 mb-3" style="background:var(--mud-palette-background-grey);border-radius:8px;">
                    <div class="text-caption ml-muted mb-2" style="font-weight:600;">@T["EXECUTED PATH SEQUENCE:"]</div>
                    <div class="ml-row" style="align-items:center;gap:6px;flex-wrap:wrap;">
                        @for (int i = 0; i < _result.ExecutedNodeIds.Count; i++)
                        {
                            var nodeId = _result.ExecutedNodeIds[i];
                            var node = Workflow.Nodes.FirstOrDefault(n => n.Id == nodeId);
                            <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small"
                                     Icon="@Icons.Material.Filled.Check">
                                @(node?.Label ?? nodeId)
                            </MudChip>
                            @if (i < _result.ExecutedNodeIds.Count - 1)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Color="Color.Default" />
                            }
                        }
                    </div>
                </div>

                <!-- Step Details Table -->
                <MudTable Items="_result.Steps" Dense="true" Hover="true" Elevation="0" Outlined="true" Class="mb-3">
                    <HeaderContent>
                        <MudTh>#</MudTh>
                        <MudTh>@T["Node Label"]</MudTh>
                        <MudTh>@T["Node Type"]</MudTh>
                        <MudTh>@T["Outcome / Status"]</MudTh>
                        <MudTh>@T["Details / Mutations"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd><code>@context.NodeId</code></MudTd>
                        <MudTd><strong>@context.NodeLabel</strong></MudTd>
                        <MudTd><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.NodeType</MudChip></MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">
                                @context.Status
                            </MudChip>
                        </MudTd>
                        <MudTd>
                            @if (!string.IsNullOrWhiteSpace(context.Output))
                            {
                                <code>@context.Output</code>
                            }
                            @if (!string.IsNullOrWhiteSpace(context.Error))
                            {
                                <span class="ml-error">@context.Error</span>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                <!-- Final Facts / Mutations State -->
                @if (_result.FinalFacts.Count > 0)
                {
                    <div class="pa-3" style="background:var(--mud-palette-surface);border:1px solid var(--mud-palette-lines-default);border-radius:8px;">
                        <span style="font-weight:600;font-size:0.85rem;" class="ml-muted">@T["FINAL RECORD STATE (POST-MUTATION):"]</span>
                        <div class="ml-row mt-2" style="gap:8px;flex-wrap:wrap;">
                            @foreach (var kvp in _result.FinalFacts)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                                    <strong>@kvp.Key:</strong>&nbsp;@kvp.Value?.ToString()
                                </MudChip>
                            }
                        </div>
                    </div>
                }
            </MudCard>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">@T["Close"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow"
                   OnClick="RunSimulationAsync" Disabled="_simulating">
            @T["Run Simulation"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public VisualWorkflowDto Workflow { get; set; } = default!;

    private sealed class FactItem
    {
        public string Key { get; set; } = "";
        public string Value { get; set; } = "";
    }

    private List<FactItem> _facts = [];
    private bool _recordExecution = false;
    private bool _simulating = false;
    private WorkflowSimulationResult? _result;

    protected override void OnInitialized()
    {
        LoadPresetHigh();
    }

    private void AddFactField()
    {
        _facts.Add(new FactItem { Key = "custom_field", Value = "test_value" });
    }

    private void LoadPresetHigh()
    {
        _facts =
        [
            new FactItem { Key = "score", Value = "95" },
            new FactItem { Key = "amount", Value = "75000" },
            new FactItem { Key = "quantity", Value = "10000" },
            new FactItem { Key = "paper_stock", Value = "Glossy 300gsm" },
            new FactItem { Key = "tier", Value = "Standard" }
        ];
    }

    private void LoadPresetLow()
    {
        _facts =
        [
            new FactItem { Key = "score", Value = "40" },
            new FactItem { Key = "amount", Value = "12000" },
            new FactItem { Key = "quantity", Value = "500" },
            new FactItem { Key = "paper_stock", Value = "Cardstock 250gsm" },
            new FactItem { Key = "tier", Value = "Standard" }
        ];
    }

    private async Task RunSimulationAsync()
    {
        _simulating = true;
        _result = null;

        try
        {
            var factDict = new Dictionary<string, object?>();
            foreach (var f in _facts)
            {
                if (string.IsNullOrWhiteSpace(f.Key)) continue;

                // Auto parse numbers if applicable
                if (long.TryParse(f.Value, out var lVal))
                {
                    factDict[f.Key.Trim()] = lVal;
                }
                else if (double.TryParse(f.Value, out var dVal))
                {
                    factDict[f.Key.Trim()] = dVal;
                }
                else if (bool.TryParse(f.Value, out var bVal))
                {
                    factDict[f.Key.Trim()] = bVal;
                }
                else
                {
                    factDict[f.Key.Trim()] = f.Value.Trim();
                }
            }

            var req = new SimulateWorkflowRequest(
                Facts: factDict,
                RecordExecution: _recordExecution
            );

            var res = await Http.PostAsJsonAsync($"api/v1/workflows/{Workflow.Id}/simulate", req);
            if (res.IsSuccessStatusCode)
            {
                _result = await res.Content.ReadFromJsonAsync<WorkflowSimulationResult>();
                Snackbar.Add(T["Simulation completed successfully."], Severity.Success);
            }
            else
            {
                var err = await res.Content.ReadAsStringAsync();
                Snackbar.Add(T["Simulation failed: {0}", err], Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _simulating = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private static string GetResultBorderStyle(bool success) => success
        ? "border-left: 5px solid var(--mud-palette-success); border-radius: 10px;"
        : "border-left: 5px solid var(--mud-palette-error); border-radius: 10px;";

    private static Color GetStatusColor(string status) => (status?.ToLowerInvariant()) switch
    {
        "success" or "passed" or "true" => Color.Success,
        "branch true" => Color.Success,
        "branch false" or "false" => Color.Warning,
        "failed" or "error" => Color.Error,
        _ => Color.Info
    };
}
