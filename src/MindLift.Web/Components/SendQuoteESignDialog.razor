@using MindLift.Shared.Contracts
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject Translator T
@inject IJSRuntime JS
@inject NavigationManager Nav

<MudDialog Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true }">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Draw" Color="Color.Primary" />
            <MudText Typo="Typo.h6" Style="font-weight:600">@T["Send for E-Signature"]</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column gap-3 py-2">
            <MudText Typo="Typo.body2" Class="ml-muted">
                @T["Generate a legally binding digital signing link for Quote {0} ({1} {2}).", QuoteNumber, Currency, TotalAmount.ToString("N2")]
            </MudText>

            <MudTextField @bind-Value="_signerName" Label="@T["Signer Full Name *"]"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Required="true"
                          Placeholder="e.g. John Smith"
                          Error="@(!string.IsNullOrWhiteSpace(_error) && string.IsNullOrWhiteSpace(_signerName))" />

            <MudTextField @bind-Value="_signerEmail" Label="@T["Signer Email Address *"]"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Required="true"
                          InputType="InputType.Email" Placeholder="signer@company.com"
                          Error="@(!string.IsNullOrWhiteSpace(_error) && string.IsNullOrWhiteSpace(_signerEmail))" />

            <MudTextField @bind-Value="_signerTitle" Label="@T["Signer Job Title"]"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Placeholder="e.g. Chief Executive Officer, Managing Director" />

            <div class="d-flex gap-3">
                <MudNumericField @bind-Value="_expiresInDays" Label="@T["Expires in (Days)"]"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="90" Step="1" />
            </div>

            <MudTextField @bind-Value="_customMessage" Label="@T["Cover Note / Message"]"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2"
                          Placeholder="@T["Please review and sign the attached quotation for our services."]" />

            @if (!string.IsNullOrWhiteSpace(_generatedUrl))
            {
                <MudPaper Class="pa-3 mt-2" Elevation="0" Style="border: 1px solid var(--mud-palette-success); background: var(--mud-palette-success-hover); border-radius: 8px;">
                    <div class="d-flex align-center gap-2 mb-1">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                        <span style="font-weight: 600; font-size: 13px;">@T["Signing link generated!"]</span>
                    </div>
                    <div class="d-flex align-center gap-2 mt-2">
                        <MudTextField Value="@_generatedUrl" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Primary" OnClick="CopyLink" Title="@T["Copy Link"]" />
                    </div>
                </MudPaper>
            }

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Close" Disabled="_sending">
            @(!string.IsNullOrWhiteSpace(_generatedUrl) ? T["Done"] : T["Cancel"])
        </MudButton>
        @if (string.IsNullOrWhiteSpace(_generatedUrl))
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SendAsync" Disabled="_sending">
                @(_sending ? T["Generating..."] : T["Generate & Send"])
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Guid QuoteId { get; set; }
    [Parameter] public string QuoteNumber { get; set; } = string.Empty;
    [Parameter] public string DefaultSignerName { get; set; } = string.Empty;
    [Parameter] public string DefaultSignerEmail { get; set; } = string.Empty;
    [Parameter] public string Currency { get; set; } = "USD";
    [Parameter] public decimal TotalAmount { get; set; }

    private string _signerName = string.Empty;
    private string _signerEmail = string.Empty;
    private string? _signerTitle;
    private int _expiresInDays = 14;
    private string? _customMessage;

    private bool _sending;
    private string? _error;
    private string? _generatedUrl;

    protected override void OnInitialized()
    {
        _signerName = DefaultSignerName;
        _signerEmail = DefaultSignerEmail;
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_signerName) || string.IsNullOrWhiteSpace(_signerEmail))
        {
            _error = T["Signer name and email are required."];
            return;
        }

        _sending = true;
        _error = null;
        try
        {
            var req = new SendQuoteESignRequest
            {
                SignerName = _signerName.Trim(),
                SignerEmail = _signerEmail.Trim(),
                SignerTitle = _signerTitle?.Trim(),
                ExpiresInDays = _expiresInDays,
                CustomMessage = _customMessage?.Trim()
            };

            var res = await Http.PostAsJsonAsync($"api/v1/quotes/{QuoteId}/esign/send", req);
            if (!res.IsSuccessStatusCode)
            {
                _error = await res.Content.ReadAsStringAsync();
                return;
            }

            var details = await res.Content.ReadFromJsonAsync<QuoteESignDetailsDto>();
            if (details?.SigningToken is not null)
            {
                _generatedUrl = $"{Nav.BaseUri.TrimEnd('/')}/sign/{details.SigningToken}";
                Snackbar.Add(T["Quote sent for signature."], Severity.Success);
            }
            else
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _sending = false;
        }
    }


    private async Task CopyLink()
    {
        if (!string.IsNullOrWhiteSpace(_generatedUrl))
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _generatedUrl);
            Snackbar.Add(T["Signing link copied to clipboard!"], Severity.Success);
        }
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}
