@inject HttpClient Http
@inject AppState App
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject IJSRuntime JS
@inject Translator T

<MlCard Title="Files" TestId="record-files">
    <div class="ml-stack">
        @if (CanEdit)
        {
            <FileDropZone @ref="_drop" Accept=".pdf,.jpg,.jpeg,.png,.docx,.xlsx,.csv,.txt" MaxSizeMb="25" Multiple="true" FilesChanged="OnFilesChosen" />
        }

        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (_files.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="ml-muted" data-testid="no-files">@T["No files yet."]</MudText>
        }

        @foreach (var file in _files)
        {
            var current = file;
            <div class="ml-row" style="padding:6px 0;border-bottom:1px solid var(--ml-border)" data-testid="record-file">
                <MudIcon Icon="@Icons.Material.Outlined.InsertDriveFile" Class="ml-muted" />
                <div class="ml-grow" style="min-width:0">
                    <div class="d-flex align-center gap-1">
                        <MudText Typo="Typo.body2" Class="ml-truncate">@current.FileName</MudText>
                        <MudIconButton Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" Color="Color.Primary" Style="padding:2px;" OnClick="() => PreviewFileAsync(current)" Title="@T["Preview document"]" aria-label="@("Preview " + current.FileName)" data-testid="file-preview" />
                    </div>
                    <MudText Typo="Typo.caption" Class="ml-muted">@Formatting.FileSize(current.SizeBytes) · <DateText Value="@current.CreatedAtUtc" /></MudText>
                </div>
                <MudIconButton Icon="@Icons.Material.Outlined.Download" Size="Size.Small" OnClick="() => DownloadAsync(current)" aria-label="@("Download " + current.FileName)" data-testid="file-download" />
                @if (CanDelete)
                {
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" OnClick="() => DeleteAsync(current)" aria-label="@("Delete " + current.FileName)" data-testid="file-delete" />
                }
            </div>
        }
    </div>
</MlCard>

<MudDialog @bind-Visible="_previewOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true }">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Outlined.Visibility" Color="Color.Primary" />
            <MudText Typo="Typo.h6">@_previewFile?.FileName</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_previewFile is not null)
        {
            var ext = System.IO.Path.GetExtension(_previewFile.FileName).ToLowerInvariant();
            var url = $"api/v1/files/{_previewFile.Id}/download";
            @if (ext is ".jpg" or ".jpeg" or ".png" or ".webp")
            {
                <div class="text-center pa-4">
                    <img src="@url" alt="@_previewFile.FileName" style="max-width:100%; max-height:75vh; object-fit:contain; border-radius:6px;" />
                </div>
            }
            else if (ext is ".pdf")
            {
                <iframe src="@url" style="width:100%; height:75vh; border:1px solid var(--ml-border); border-radius:6px;"></iframe>
            }
            else
            {
                <div class="pa-8 text-center">
                    <MudIcon Icon="@Icons.Material.Outlined.InsertDriveFile" Size="Size.Large" Class="ml-muted mb-2" />
                    <MudText Typo="Typo.body1">@_previewFile.FileName</MudText>
                    <MudText Typo="Typo.caption" Class="ml-muted">@Formatting.FileSize(_previewFile.SizeBytes)</MudText>
                    <div class="mt-4">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Download" OnClick="() => DownloadAsync(_previewFile)">@T["Download to view"]</MudButton>
                    </div>
                </div>
            }
        }
    </DialogContent>
    <DialogActions>
        @if (_previewFile is not null)
        {
            <MudButton StartIcon="@Icons.Material.Outlined.Download" OnClick="() => DownloadAsync(_previewFile)">@T["Download"]</MudButton>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => _previewOpen = false">@T["Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>The kind of record: leads, contacts, accounts or deals.</summary>
    [Parameter, EditorRequired] public string EntityType { get; set; } = string.Empty;

    [Parameter, EditorRequired] public Guid EntityId { get; set; }

    private FileDropZone? _drop;
    private bool _loading = true;
    private IReadOnlyList<StoredFileDto> _files = [];
    private Guid _loadedFor;

    private bool Can(Func<ModulePermissionDto, bool> check)
        => App.Bootstrap?.Permissions.Any(p => string.Equals(p.Module, EntityType, StringComparison.OrdinalIgnoreCase) && check(p)) == true;

    private bool CanEdit => Can(p => p.CanEdit);
    private bool CanDelete => Can(p => p.CanDelete);

    protected override async Task OnParametersSetAsync()
    {
        if (EntityId != _loadedFor)
        {
            _loadedFor = EntityId;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _files = await Http.GetFromJsonAsync<List<StoredFileDto>>($"api/v1/files?entityType={EntityType}&entityId={EntityId}") ?? [];
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or TaskCanceledException)
        {
            _files = [];
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task OnFilesChosen(IReadOnlyList<Microsoft.AspNetCore.Components.Forms.IBrowserFile> chosen)
    {
        foreach (var file in chosen)
        {
            try
            {
                using var content = new MultipartFormDataContent();
                var stream = new StreamContent(file.OpenReadStream(25L * 1024 * 1024));
                content.Add(stream, "file", file.Name);
                content.Add(new StringContent(EntityType), "entityType");
                content.Add(new StringContent(EntityId.ToString()), "entityId");
                var response = await Http.PostAsync("api/v1/files", content);
                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add($"{file.Name} uploaded", Severity.Success);
                }
                else
                {
                    Snackbar.Add(await ProblemText.FromAsync(response, $"We could not upload {file.Name}."), Severity.Error);
                }
            }
            catch (IOException)
            {
                Snackbar.Add($"We could not read {file.Name}.", Severity.Error);
            }
        }

        await LoadAsync();
        StateHasChanged();

        if (_drop is not null)
        {
            await _drop.ClearAsync();
        }
    }

    private async Task DownloadAsync(StoredFileDto file)
    {
        var response = await Http.GetAsync($"api/v1/files/{file.Id}");
        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add(await ProblemText.FromAsync(response, T["We could not download this file."]), Severity.Error);
            return;
        }

        await JS.InvokeVoidAsync("mindlift.downloadFile", file.FileName, file.ContentType, Convert.ToBase64String(await response.Content.ReadAsByteArrayAsync()));
    }

    private bool _previewOpen;
    private StoredFileDto? _previewFile;

    private void PreviewFileAsync(StoredFileDto file)
    {
        _previewFile = file;
        _previewOpen = true;
    }

    private async Task DeleteAsync(StoredFileDto file)
    {
        if (!await Dialogs.ConfirmAsync(T["Are you sure you want to delete?"], T["Are you sure you want to delete {0}? This cannot be undone.", file.FileName], T["Yes"], danger: true))
        {
            return;
        }

        var response = await Http.DeleteAsync($"api/v1/files/{file.Id}");
        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add(await ProblemText.FromAsync(response, T["We could not delete this file."]), Severity.Error);
        }

        await LoadAsync();
    }
}
