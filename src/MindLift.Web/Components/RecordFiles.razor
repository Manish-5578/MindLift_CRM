@inject HttpClient Http
@inject AppState App
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject IJSRuntime JS
@inject Translator T

<MlCard Title="Files" TestId="record-files">
    <div class="ml-stack">
        @if (CanEdit)
        {
            <FileDropZone @ref="_drop" Accept=".pdf,.jpg,.jpeg,.png,.docx,.xlsx,.csv,.txt" MaxSizeMb="25" Multiple="true" FilesChanged="OnFilesChosen" />
        }

        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (_files.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="ml-muted" data-testid="no-files">@T["No files yet."]</MudText>
        }

        @foreach (var file in _files)
        {
            var current = file;
            <div class="ml-row" style="padding:6px 0;border-bottom:1px solid var(--ml-border)" data-testid="record-file">
                <MudIcon Icon="@Icons.Material.Outlined.InsertDriveFile" Class="ml-muted" />
                <div class="ml-grow" style="min-width:0">
                    <div class="d-flex align-center gap-1">
                        <MudText Typo="Typo.body2" Class="ml-truncate">@current.FileName</MudText>
                        <MudIconButton Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" Color="Color.Primary" Style="padding:2px;" OnClick="() => PreviewFileAsync(current)" Title="@T["Preview document"]" aria-label="@("Preview " + current.FileName)" data-testid="file-preview" />
                    </div>
                    <MudText Typo="Typo.caption" Class="ml-muted">@Formatting.FileSize(current.SizeBytes) · <DateText Value="@current.CreatedAtUtc" /></MudText>
                </div>
                <MudIconButton Icon="@Icons.Material.Outlined.Download" Size="Size.Small" OnClick="() => DownloadAsync(current)" aria-label="@("Download " + current.FileName)" data-testid="file-download" />
                @if (CanDelete)
                {
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" OnClick="() => DeleteAsync(current)" aria-label="@("Delete " + current.FileName)" data-testid="file-delete" />
                }
            </div>
        }
    </div>
</MlCard>

<MudDialog Visible="_previewOpen" VisibleChanged="OnPreviewVisibleChanged" Options="new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true }">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Outlined.Visibility" Color="Color.Primary" />
            <MudText Typo="Typo.h6">@_previewFile?.FileName</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_previewFile is not null)
        {
            if (_previewLoading)
            {
                <div class="pa-8"><MudProgressLinear Indeterminate="true" /></div>
            }
            else if (_previewKind == "image")
            {
                <div class="text-center pa-4">
                    <img src="@_previewUrl" alt="@_previewFile.FileName" style="max-width:100%; max-height:75vh; object-fit:contain; border-radius:6px;" data-testid="preview-image" />
                </div>
            }
            else if (_previewKind == "pdf")
            {
                <iframe src="@_previewUrl" title="@_previewFile.FileName" style="width:100%; height:75vh; border:1px solid var(--ml-border); border-radius:6px;" data-testid="preview-pdf"></iframe>
            }
            else if (_previewKind == "text")
            {
                <pre style="max-height:70vh; overflow:auto; white-space:pre-wrap; padding:12px; border:1px solid var(--ml-border); border-radius:6px;" data-testid="preview-text">@_previewText</pre>
                @if (_previewTruncated)
                {
                    <MudText Typo="Typo.caption" Class="ml-muted">@T["Only the start of the file is shown. Download it to read the rest."]</MudText>
                }
            }
            else
            {
                <div class="pa-8 text-center" data-testid="preview-unavailable">
                    <MudIcon Icon="@Icons.Material.Outlined.InsertDriveFile" Size="Size.Large" Class="ml-muted mb-2" />
                    <MudText Typo="Typo.body1">@_previewFile.FileName</MudText>
                    <MudText Typo="Typo.caption" Class="ml-muted">@Formatting.FileSize(_previewFile.SizeBytes)</MudText>
                    <MudText Typo="Typo.body2" Class="ml-muted mt-2">@(_previewError ?? T["This kind of file cannot be previewed here."])</MudText>
                    <div class="mt-4">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Download" OnClick="() => DownloadAsync(_previewFile)">@T["Download to view"]</MudButton>
                    </div>
                </div>
            }
        }
    </DialogContent>
    <DialogActions>
        @if (_previewFile is not null)
        {
            <MudButton StartIcon="@Icons.Material.Outlined.Download" OnClick="() => DownloadAsync(_previewFile)">@T["Download"]</MudButton>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ClosePreviewAsync" data-testid="preview-close">@T["Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>The kind of record: leads, contacts, accounts or deals.</summary>
    [Parameter, EditorRequired] public string EntityType { get; set; } = string.Empty;

    [Parameter, EditorRequired] public Guid EntityId { get; set; }

    private FileDropZone? _drop;
    private bool _loading = true;
    private IReadOnlyList<StoredFileDto> _files = [];
    private Guid _loadedFor;

    private bool Can(Func<ModulePermissionDto, bool> check)
        => App.Bootstrap?.Permissions.Any(p => string.Equals(p.Module, EntityType, StringComparison.OrdinalIgnoreCase) && check(p)) == true;

    private bool CanEdit => Can(p => p.CanEdit);
    private bool CanDelete => Can(p => p.CanDelete);

    protected override async Task OnParametersSetAsync()
    {
        if (EntityId != _loadedFor)
        {
            _loadedFor = EntityId;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _files = await Http.GetFromJsonAsync<List<StoredFileDto>>($"api/v1/files?entityType={EntityType}&entityId={EntityId}") ?? [];
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or TaskCanceledException)
        {
            _files = [];
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task OnFilesChosen(IReadOnlyList<Microsoft.AspNetCore.Components.Forms.IBrowserFile> chosen)
    {
        foreach (var file in chosen)
        {
            try
            {
                using var content = new MultipartFormDataContent();
                var stream = new StreamContent(file.OpenReadStream(25L * 1024 * 1024));
                content.Add(stream, "file", file.Name);
                content.Add(new StringContent(EntityType), "entityType");
                content.Add(new StringContent(EntityId.ToString()), "entityId");
                var response = await Http.PostAsync("api/v1/files", content);
                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add($"{file.Name} uploaded", Severity.Success);
                }
                else
                {
                    Snackbar.Add(await ProblemText.FromAsync(response, $"We could not upload {file.Name}."), Severity.Error);
                }
            }
            catch (IOException)
            {
                Snackbar.Add($"We could not read {file.Name}.", Severity.Error);
            }
        }

        await LoadAsync();
        StateHasChanged();

        if (_drop is not null)
        {
            await _drop.ClearAsync();
        }
    }

    private async Task DownloadAsync(StoredFileDto file)
    {
        var response = await Http.GetAsync($"api/v1/files/{file.Id}");
        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add(await ProblemText.FromAsync(response, T["We could not download this file."]), Severity.Error);
            return;
        }

        await JS.InvokeVoidAsync("mindlift.downloadFile", file.FileName, file.ContentType, Convert.ToBase64String(await response.Content.ReadAsByteArrayAsync()));
    }

    private const int MaxPreviewBytes = 10 * 1024 * 1024;
    private const int MaxPreviewTextChars = 200_000;

    private bool _previewOpen, _previewLoading, _previewTruncated;
    private StoredFileDto? _previewFile;
    private string _previewKind = "none";
    private string? _previewUrl, _previewText, _previewError;

    /// <summary>What a file can be shown as, from its name: an image, a PDF, plain text, or nothing (it has to be downloaded).</summary>
    public static string PreviewKindOf(string fileName) => System.IO.Path.GetExtension(fileName).ToLowerInvariant() switch
    {
        ".jpg" or ".jpeg" or ".png" or ".webp" or ".gif" => "image",
        ".pdf" => "pdf",
        ".txt" or ".csv" => "text",
        _ => "none",
    };

    /// <summary>
    /// Opens the preview. The file is fetched through the signed-in connection, because an image or frame pointed at the
    /// address would not carry the sign-in and would be refused.
    /// </summary>
    private async Task PreviewFileAsync(StoredFileDto file)
    {
        await ReleasePreviewAsync();
        _previewFile = file;
        _previewKind = PreviewKindOf(file.FileName);
        _previewOpen = true;
        if (_previewKind == "none")
        {
            return;
        }

        if (file.SizeBytes > MaxPreviewBytes)
        {
            _previewKind = "none";
            _previewError = T["This file is too large to preview. Download it to view."];
            return;
        }

        _previewLoading = true;
        StateHasChanged();
        try
        {
            var response = await Http.GetAsync($"api/v1/files/{file.Id}");
            if (!response.IsSuccessStatusCode)
            {
                _previewKind = "none";
                _previewError = await ProblemText.FromAsync(response, T["We could not open this file."]);
                return;
            }

            var bytes = await response.Content.ReadAsByteArrayAsync();
            if (_previewKind == "text")
            {
                var text = System.Text.Encoding.UTF8.GetString(bytes);
                _previewTruncated = text.Length > MaxPreviewTextChars;
                _previewText = _previewTruncated ? text[..MaxPreviewTextChars] : text;
            }
            else
            {
                var type = _previewKind == "pdf" ? "application/pdf" : string.IsNullOrWhiteSpace(file.ContentType) ? "image/png" : file.ContentType;
                _previewUrl = await JS.InvokeAsync<string>("mindlift.objectUrl", type, Convert.ToBase64String(bytes));
            }
        }
        catch (HttpRequestException)
        {
            _previewKind = "none";
            _previewError = T["We could not reach MindLift. Check your connection and try again."];
        }
        finally
        {
            _previewLoading = false;
        }
    }

    private async Task OnPreviewVisibleChanged(bool visible)
    {
        if (!visible)
        {
            await ClosePreviewAsync();
        }
    }

    private async Task ClosePreviewAsync()
    {
        _previewOpen = false;
        await ReleasePreviewAsync();
    }

    private async Task ReleasePreviewAsync()
    {
        if (_previewUrl is not null)
        {
            try { await JS.InvokeVoidAsync("mindlift.releaseUrl", _previewUrl); } catch (JSException) { }
        }

        _previewUrl = _previewText = _previewError = null;
        _previewTruncated = false;
        _previewKind = "none";
    }

    private async Task DeleteAsync(StoredFileDto file)
    {
        if (!await Dialogs.ConfirmAsync(T["Are you sure you want to delete?"], T["Are you sure you want to delete {0}? This cannot be undone.", file.FileName], T["Yes"], danger: true, cancelText: T["No"]))
        {
            return;
        }

        var response = await Http.DeleteAsync($"api/v1/files/{file.Id}");
        if (!response.IsSuccessStatusCode)
        {
            Snackbar.Add(await ProblemText.FromAsync(response, T["We could not delete this file."]), Severity.Error);
        }

        await LoadAsync();
    }
}
