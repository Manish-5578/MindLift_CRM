@inject HttpClient Http
@inject Translator T

<MlCard Title="Timeline" TestId="record-timeline-card">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_failed)
    {
        <MudText Typo="Typo.body2" Class="ml-muted" data-testid="timeline-failed">@T["We could not load the timeline."]</MudText>
    }
    else
    {
        @if (_all.Count > 0)
        {
            <div class="ml-row ml-row--wrap" style="margin-bottom:12px" data-testid="timeline-filters">
                @foreach (var (key, label) in Filters)
                {
                    var current = key;
                    <MudChip T="string" Size="Size.Small" Variant="@(_filter == current ? Variant.Filled : Variant.Outlined)" Color="@(_filter == current ? Color.Primary : Color.Default)"
                             OnClick="() => SetFilter(current)" data-testid="@("timeline-filter-" + current)">@T[label] (@CountOf(current))</MudChip>
                }
            </div>
        }
        <Timeline Items="_items" EmptyText="@(_all.Count == 0 ? "Nothing has happened yet." : "Nothing of this kind has happened yet.")" TestId="record-timeline" />
    }
</MlCard>

@code {
    /// <summary>The kind of record: leads, contacts, accounts or deals.</summary>
    [Parameter, EditorRequired] public string EntityType { get; set; } = string.Empty;

    [Parameter, EditorRequired] public Guid EntityId { get; set; }

    private static readonly (string Key, string Label)[] Filters =
    [
        ("all", "All"), ("activity", "Activities"), ("change", "Changes"), ("related", "Contacts, deals and tickets"), ("event", "Other events"),
    ];

    private List<TimelineEntryDto> _all = [];
    private string _filter = "all";
    private IReadOnlyList<TimelineItem> _items = [];
    private bool _loading = true;
    private bool _failed;
    private Guid _loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        if (EntityId != _loadedFor)
        {
            _loadedFor = EntityId;
            await ReloadAsync();
        }
    }

    /// <summary>Loads the timeline again, for example after an activity was added on the same page.</summary>
    public async Task ReloadAsync()
    {
        _failed = false;
        try
        {
            _all = await Http.GetFromJsonAsync<List<TimelineEntryDto>>($"api/v1/timeline?entityType={EntityType}&entityId={EntityId}") ?? [];
            Apply();
        }
        catch (HttpRequestException)
        {
            _failed = true;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    /// <summary>Which filter an entry belongs to.</summary>
    private static string GroupOf(TimelineEntryDto e) => e.Kind switch
    {
        "activity" => "activity",
        "created" or "changed" or "stage" or "converted" => "change",
        "contact" or "deal" or "ticket" => "related",
        _ => "event",
    };

    private int CountOf(string filter) => filter == "all" ? _all.Count : _all.Count(e => GroupOf(e) == filter);

    private void SetFilter(string filter)
    {
        _filter = filter;
        Apply();
    }

    private void Apply()
        => _items = _all.Where(e => _filter == "all" || GroupOf(e) == _filter)
            .Select(e => new TimelineItem(e.WhenUtc, e.Title, string.Join(" · ", new[] { e.Detail, e.ActorName }.Where(s => !string.IsNullOrWhiteSpace(s))), IconFor(e), e.Href)).ToList();

    private static string IconFor(TimelineEntryDto entry) => entry.Kind switch
    {
        "activity" => entry.ActivityType switch
        {
            "Call" => Icons.Material.Outlined.Call,
            "Meeting" => Icons.Material.Outlined.Event,
            "Note" => Icons.Material.Outlined.StickyNote2,
            _ => Icons.Material.Outlined.TaskAlt,
        },
        "stage" => Icons.Material.Outlined.SwapHoriz,
        "converted" => Icons.Material.Outlined.SwapHoriz,
        "contact" => Icons.Material.Outlined.Contacts,
        "deal" => Icons.Material.Outlined.Handshake,
        "ticket" => Icons.Material.Outlined.ConfirmationNumber,
        "changed" => Icons.Material.Outlined.Edit,
        _ => Icons.Material.Outlined.History,
    };
}
