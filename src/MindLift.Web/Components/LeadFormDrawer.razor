@inject Translator T
<FormDrawer Open="Open" OpenChanged="OnOpenChanged" Title="@(_leadId is null ? "New lead" : "Edit lead")" SubmitText="@(_leadId is null ? "Create lead" : "Save changes")" Busy="_busy" OnSubmit="SaveAsync" IsDirty="IsDirty">
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" data-testid="lead-error">@_error</MudAlert>
    }

    @if (_duplicates.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3" data-testid="duplicate-warning">
            <MudText Typo="Typo.subtitle2">@T["Possible duplicates"]</MudText>
            @foreach (var d in _duplicates)
            {
                <MudText Typo="Typo.body2">@d.FullName · @d.Kind · @d.Reason</MudText>
            }
            <MudText Typo="Typo.body2" Class="mt-2">@T["Press the button again to create the lead anyway."]</MudText>
        </MudAlert>
    }

    <DynamicForm Fields="Fields" Values="_values" Users="_users" Errors="_fieldErrors" CustomFields="_customFields" CustomValues="_custom" CustomValuesChanged="v => _custom = v" />
</FormDrawer>

@code {
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private AppState App { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private Dictionary<string, string?> _values = new();
    private IReadOnlyDictionary<string, string> _fieldErrors = new Dictionary<string, string>();
    private IReadOnlyList<FieldDto> _customFields = [];
    private List<UserListItem> _users = [];
    private Dictionary<string, JsonElement?> _custom = new();
    private Guid? _leadId;
    private bool _busy;
    private string? _error;
    private List<DuplicateCandidateDto> _duplicates = [];
    private string _snapshot = string.Empty;

    /// <summary>True when the form differs from how it was opened, so closing it asks before throwing the edits away.</summary>
    private bool IsDirty => TakeSnapshot() != _snapshot;

    private string TakeSnapshot() => JsonSerializer.Serialize(new { Form = _values, Custom = _custom });

    private IReadOnlyList<FormField> Fields =>
    [
        new("firstName", "First name", Required: true, TestId: "lead-first", Columns: 6),
        new("lastName", "Last name", Columns: 6),
        new("email", "Email", FormFieldKind.Email, TestId: "lead-email"),
        new("phone", "Phone"),
        new("companyName", "Company"),
        new("status", "Status", FormFieldKind.Picklist, Options: Options("lead_status"), Columns: 6),
        new("source", "Source", FormFieldKind.Picklist, Options: Options("lead_source"), Columns: 6),
        new("rating", "Rating", FormFieldKind.Picklist, Options: Options("lead_rating")),
        new("description", "Notes", FormFieldKind.Multiline),
    ];

    private IReadOnlyList<PicklistValueDto> Options(string key)
        => App.Bootstrap?.Picklists.FirstOrDefault(p => p.Key == key)?.Values ?? [];

    protected override async Task OnInitializedAsync() => _users = await RecordLookups.UsersAsync(Http);

    /// <summary>Opens the drawer empty for a new lead.</summary>
    public void OpenNew()
    {
        _leadId = null;
        _values = new Dictionary<string, string?> { ["status"] = "new" };
        Reset([]);
    }

    /// <summary>Opens the drawer filled with an existing lead.</summary>
    public void OpenEdit(LeadDto lead)
    {
        _leadId = lead.Id;
        _values = new Dictionary<string, string?>
        {
            ["firstName"] = lead.FirstName, ["lastName"] = lead.LastName, ["email"] = lead.Email, ["phone"] = lead.Phone,
            ["companyName"] = lead.CompanyName, ["status"] = lead.Status, ["source"] = lead.Source, ["rating"] = lead.Rating, ["description"] = lead.Description,
        };
        Reset(lead.CustomFields.ToDictionary(kv => kv.Key, kv => (JsonElement?)kv.Value));
    }

    private void Reset(Dictionary<string, JsonElement?> custom)
    {
        _custom = custom;
        _customFields = App.Bootstrap?.Fields.GetValueOrDefault("leads")?.Where(f => f.IsCustom).ToList() ?? [];
        _duplicates = [];
        _error = null;
        _fieldErrors = new Dictionary<string, string>();
        _snapshot = TakeSnapshot();
    }

    private async Task OnOpenChanged(bool value) => await OpenChanged.InvokeAsync(value);

    private string? Value(string key) => string.IsNullOrWhiteSpace(_values.GetValueOrDefault(key)) ? null : _values[key]!.Trim();

    private async Task SaveAsync()
    {
        _error = null;
        _fieldErrors = new Dictionary<string, string>();
        if (Value("firstName") is null)
        {
            _fieldErrors = new Dictionary<string, string> { ["firstName"] = "Enter the first name." };
            return;
        }

        _busy = true;
        try
        {
            // New leads: look for duplicates first. Pressing the button again confirms.
            if (_leadId is null && _duplicates.Count == 0)
            {
                var check = await Http.PostAsJsonAsync("api/v1/leads/check-duplicates",
                    new CheckDuplicatesRequest(Value("firstName")!, Value("lastName") ?? string.Empty, Value("email"), Value("phone"), Value("companyName")));
                var found = check.IsSuccessStatusCode ? await check.Content.ReadFromJsonAsync<List<DuplicateCandidateDto>>() ?? [] : [];
                if (found.Count > 0)
                {
                    _duplicates = found;
                    return;
                }
            }

            var request = new SaveLeadRequest(
                Value("firstName")!, Value("lastName") ?? string.Empty, Value("email"), Value("phone"), Value("companyName"),
                Value("status"), Value("source"), Value("rating"), Value("description"), null, null,
                _custom.Where(kv => kv.Value is not null).ToDictionary(kv => kv.Key, kv => kv.Value!.Value));

            var response = _leadId is null
                ? await Http.PostAsJsonAsync("api/v1/leads", request)
                : await Http.PutAsJsonAsync($"api/v1/leads/{_leadId}", request);

            if (!response.IsSuccessStatusCode)
            {
                var fields = await ProblemText.FieldErrorsAsync(response);
                if (fields.Count > 0)
                {
                    _fieldErrors = fields;
                }
                else
                {
                    _error = await ProblemText.FromAsync(response, T["We could not save this lead."]);
                }

                return;
            }

            await OpenChanged.InvokeAsync(false);
            await OnSaved.InvokeAsync();
        }
        catch (HttpRequestException)
        {
            _error = T["We could not reach MindLift. Check your connection and try again."];
        }
        finally
        {
            _busy = false;
        }
    }
}
