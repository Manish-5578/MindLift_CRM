@using System.Globalization
@* A percentage as a ring that fills in. *@
<div class="ch-ring" style="width:@(Size)px;height:@(Size)px" title="@Title">
    <svg width="@Size" height="@Size" viewBox="0 0 @Size @Size">
        <circle cx="@F(Size / 2.0)" cy="@F(Size / 2.0)" r="@F(R)" fill="none" stroke="var(--ml-border)" stroke-width="@F(Stroke)" />
        <circle cx="@F(Size / 2.0)" cy="@F(Size / 2.0)" r="@F(R)" fill="none" stroke="@Color" stroke-width="@F(Stroke)" stroke-linecap="round" stroke-dasharray="@F(Dash) @F(C)" class="ch-ring__arc" />
    </svg>
    <span class="ch-ring__v" style="font-size:@((int)(Size * .27))px">@(ShowText ?? $"{Math.Round(Value)}%")</span>
</div>

@code {
    [Parameter] public double Value { get; set; }
    [Parameter] public int Size { get; set; } = 56;
    [Parameter] public string Color { get; set; } = "var(--ml-primary)";
    [Parameter] public string? ShowText { get; set; }
    [Parameter] public string? Title { get; set; }

    private double Stroke => Math.Max(4, Size / 10.0);
    private double R => (Size - Stroke) / 2;
    private double C => 2 * Math.PI * R;
    private double Dash => C * Math.Clamp(Value, 0, 100) / 100.0;
    private static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
}
