@* A password field with an eye to show or hide what was typed. *@
<MudTextField @attributes="Attributes" T="string" Immediate="true" Value="Value" ValueChanged="ValueChanged" Label="@Label" Required="Required"
              Variant="Variant" Margin="Margin" HelperText="@HelperText" Error="Error" ErrorText="@ErrorText" OnKeyDown="OnKeyDown"
              InputType="@(_shown ? InputType.Text : InputType.Password)"
              Adornment="Adornment.End" AdornmentIcon="@(_shown ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
              OnAdornmentClick="Toggle" AdornmentAriaLabel="@(_shown ? "Hide password" : "Show password")" />

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    [Parameter] public Margin Margin { get; set; } = Margin.Dense;
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public bool Error { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }

    /// <summary>Accepted so a page can say it is a password field; the eye decides what is shown.</summary>
    [Parameter] public InputType InputType { get; set; } = InputType.Password;

    /// <summary>Anything else (test ids and the like) goes to the text field.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? Attributes { get; set; }

    private bool _shown;
    private void Toggle() => _shown = !_shown;
}
